diff --git a/tests/IosPlatformTest/KeychainTest.mm b/tests/IosPlatformTest/KeychainTest.mm
new file mode 100644
index 0000000..c716c6f
--- /dev/null
+++ b/tests/IosPlatformTest/KeychainTest.mm
@@ -0,0 +1,98 @@
+#import <Foundation/Foundation.h>
+#import <Security/Security.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+// Replace the four Keychain operations before including the production bridge.
+// These checks use an in-memory store and never read/write the host's Keychain.
+static NSMutableDictionary *items;
+static NSString *service;
+static int updateCalls, addCalls, readCalls, deleteCalls;
+
+static NSString *Account(CFDictionaryRef query)
+{
+    NSDictionary *value = (__bridge NSDictionary *)query;
+    assert([value[(__bridge id)kSecClass] isEqual:(__bridge id)kSecClassGenericPassword]);
+    assert([value[(__bridge id)kSecAttrService] isEqual:service]);
+    assert([value[(__bridge id)kSecAttrSynchronizable] isEqual:@NO]);
+    return value[(__bridge id)kSecAttrAccount];
+}
+static void CheckAttributes(NSDictionary *attributes)
+{
+    assert([attributes[(__bridge id)kSecAttrAccessible] isEqual:(__bridge id)kSecAttrAccessibleWhenUnlockedThisDeviceOnly]);
+    assert([attributes[(__bridge id)kSecValueData] isKindOfClass:[NSData class]]);
+}
+static OSStatus TestUpdate(CFDictionaryRef query, CFDictionaryRef attributes)
+{
+    updateCalls++;
+    NSString *account = Account(query);
+    CheckAttributes((__bridge NSDictionary *)attributes);
+    if (items[account] == nil) return errSecItemNotFound;
+    items[account] = ((__bridge NSDictionary *)attributes)[(__bridge id)kSecValueData];
+    return errSecSuccess;
+}
+static OSStatus TestAdd(CFDictionaryRef attributes, CFTypeRef *result)
+{
+    assert(result == NULL);
+    addCalls++;
+    NSString *account = Account(attributes);
+    CheckAttributes((__bridge NSDictionary *)attributes);
+    items[account] = ((__bridge NSDictionary *)attributes)[(__bridge id)kSecValueData];
+    return errSecSuccess;
+}
+static OSStatus TestCopy(CFDictionaryRef query, CFTypeRef *result)
+{
+    readCalls++;
+    NSString *account = Account(query);
+    assert([((__bridge NSDictionary *)query)[(__bridge id)kSecReturnData] isEqual:@YES]);
+    NSData *data = items[account];
+    if (data == nil) return errSecItemNotFound;
+    *result = CFBridgingRetain(data);
+    return errSecSuccess;
+}
+static OSStatus TestDelete(CFDictionaryRef query)
+{
+    deleteCalls++;
+    NSString *account = Account(query);
+    if (account == nil) [items removeAllObjects];
+    else [items removeObjectForKey:account];
+    return errSecSuccess;
+}
+
+#define SecItemUpdate TestUpdate
+#define SecItemAdd TestAdd
+#define SecItemCopyMatching TestCopy
+#define SecItemDelete TestDelete
+#include "../../Assets/Plugins/iOS/PocketKeychain.mm"
+
+int main()
+{
+    @autoreleasepool {
+        items = [NSMutableDictionary dictionary];
+        service = @"com.openfusion.pocket.saved-passwords.v1";
+        assert(OFPocketSaveCredential(NULL, "secret") == 0);
+        assert(OFPocketSaveCredential("identity", "") == 0);
+        assert(OFPocketSaveCredential("identity", "pāss🔒") == 1);
+        assert(updateCalls == 1 && addCalls == 1);
+        assert(OFPocketSaveCredential("identity", "new🔒secret") == 1);
+        assert(updateCalls == 2 && addCalls == 1);
+        int length = -1;
+        void *secret = OFPocketLoadCredential("identity", &length);
+        assert(secret != NULL && length == (int)strlen("new🔒secret"));
+        assert(memcmp(secret, "new🔒secret", (size_t)length) == 0);
+        OFPocketFreeCredential(secret, length);
+        assert(OFPocketLoadCredential("missing", &length) == NULL && length == 0);
+        assert(OFPocketLoadCredential(NULL, &length) == NULL && length == 0);
+        OFPocketForgetCredential(NULL);
+        assert(deleteCalls == 0);
+        OFPocketForgetCredential("identity");
+        assert(items.count == 0 && deleteCalls == 1);
+        assert(OFPocketSaveCredential("first", "one") == 1);
+        assert(OFPocketSaveCredential("second", "two") == 1);
+        OFPocketForgetAllCredentials();
+        assert(items.count == 0 && deleteCalls == 2 && readCalls == 2);
+        puts("Keychain bridge checks passed with an in-memory Security API substitute; no host Keychain or iPhone access verified.");
+    }
+    return 0;
+}
diff --git a/tests/IosPlatformTest/Program.cs b/tests/IosPlatformTest/Program.cs
new file mode 100644
