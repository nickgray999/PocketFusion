@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Exercise the actual LoadWorldAsync body with controlled loading and a virtual map clock."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "Assets/Scripts/OpenFusion/WorldBootstrap.cs").read_text()
+start = source.index("        public async Task LoadWorldAsync(Vector3 position)")
+end = source.index("        void OnTeleport(", start)
+method = source[start:end]
+assert method.count("await Task.Delay(250);") == 1, "Review the virtual-clock injection after changing the map wait."
+method = method.replace("await Task.Delay(250);", "await Clock.Delay(250);")
+assert "streamer.FilesUpTo(phase), ReportSharedPreparation" in method, "Shared preparation must use the existing map-filtered phase list."
+
+harness = r'''
+using System.Collections.Concurrent;
+using System.Threading;
+
+class Harness {
+ public Vector3 StartPosition;
+ public Models Models = new();
+ public Loader Loader = new();
+ public Streamer streamer = new();
+ public List<string> Stages = new();
+ public event Action<string,float> Status;
+ public Harness() { Status += (s,p)=>Stages.Add(s); }
+ void ReportSharedPreparation(string s,int completed,int total) { Status?.Invoke(s,.90f); }
+__METHOD__
+}
+struct Vector3 { public float x,z; }
+enum ZoneType { Tutorial,Free,Paid }
+enum Phase { Tutorial,FreeZone,PaidZone }
+static class Phases { public static Phase For(ZoneType z)=>z==ZoneType.Tutorial?Phase.Tutorial:z==ZoneType.Free?Phase.FreeZone:Phase.PaidZone; }
+static class DongGrid { public static void Cell(float x,float z,out int a,out int b){a=b=1;} public static string MapName(int x,int y)=>"Map_01_01"; }
+class Manifest { public bool IsTutorial(int x,int y)=>true; public bool IsFree(int x,int y)=>false; }
+class GameData { public Manifest Manifest = new(); }
+class Models { public GameData GameData = new(); }
+struct DownloadProgress { public int FilesDone,FilesTotal;public long BytesDone,BytesTotal; }
+class Streamer {
+ public bool FailDownload;
+ public bool SharedProgress,MapProgress;
+ public Phase Phase;
+ public Task EnsurePhaseAsync(Phase phase,IProgress<DownloadProgress> progress) {
+  Phase=phase;SharedProgress=progress!=null;
+  if(FailDownload)throw new IOException("download failed");
+  progress.Report(new DownloadProgress{FilesDone=1,FilesTotal=2,BytesDone=1024,BytesTotal=2048});
+  return Task.CompletedTask;
+ }
+ public Task EnsureDongAsync(int x,int y,IProgress<DownloadProgress> progress) {
+  MapProgress=progress!=null;
+  progress.Report(new DownloadProgress{FilesDone=1,FilesTotal=1,BytesDone=512,BytesTotal=512});
+  return Task.CompletedTask;
+ }
+ public IEnumerable<string> FilesUpTo(Phase phase) {
+  Check.That(phase==Phase,"Preparation must use the downloaded phase.");
+  return new[]{"Tutorial.resourceFile"};
+ }
+}
+class Loader {
+ public bool Paused,Prepared,PreparationBegun,FailPreparation,AlreadyLoaded,NeverLoaded;
+ public int Queries;
+ public long MapStarted=-1;
+ readonly TaskCompletionSource<bool> release=new(TaskCreationOptions.RunContinuationsAsynchronously);
+ public async Task PrepareSharedAsync(IEnumerable<string> files,Action<string,int,int> progress) {
+  Check.That(Paused,"Streaming must be paused while preparing shared data.");
+  Check.That(files.SequenceEqual(new[]{"Tutorial.resourceFile"}),"Do not pass map files into shared preparation.");
+  PreparationBegun=true;progress("Preparing Tutorial.resourceFile",0,1);
+  await release.Task;
+  if(FailPreparation)throw new IOException("preparation failed");
+  Prepared=true;progress("Prepared Tutorial.resourceFile",1,1);
+ }
+ public void CompletePreparation()=>release.TrySetResult(true);
+ public void SetPosition(Vector3 p) { Check.That(Prepared,"Position must not change before shared preparation finishes.");MapStarted=Clock.Milliseconds; }
+ public void PauseAfterDong(int x,int y) { Check.That(Prepared&&Paused,"Pause-after setup must precede unpausing."); }
+ public bool IsDongLoaded(int x,int y) {
+  Queries++;Check.That(Prepared&&!Paused,"Map wait must not begin during shared preparation or while paused.");
+  return AlreadyLoaded||(!NeverLoaded&&Queries>=3);
+ }
+}
+static class Clock {
+ public static long Milliseconds;
+ public static int Delays;
+ public static Task Delay(int milliseconds){Milliseconds+=milliseconds;Delays++;return Task.CompletedTask;}
+ public static void Reset(){Milliseconds=0;Delays=0;}
+}
+class Pump : SynchronizationContext {
+ readonly BlockingCollection<(SendOrPostCallback callback,object state)> work=new();
+ public override void Post(SendOrPostCallback d,object state)=>work.Add((d,state));
+ public void Until(Task t){while(!t.IsCompleted){if(work.TryTake(out var item,100))item.callback(item.state);}t.GetAwaiter().GetResult();Drain();}
+ public void Drain(){while(work.TryTake(out var item))item.callback(item.state);}
+}
+static class Check { public static void That(bool ok,string message){if(!ok)throw new Exception(message);} }
+class Program {
+ static void Main(){
+  var pump=new Pump();SynchronizationContext.SetSynchronizationContext(pump);
+  Clock.Reset();var h=new Harness();var load=h.LoadWorldAsync(new Vector3());
+  Check.That(h.Loader.PreparationBegun&&!load.IsCompleted&&h.Loader.Queries==0&&Clock.Delays==0,"Heavy preparation must be explicitly awaited before map polling or its timeout.");
+  Clock.Milliseconds=136201;h.Loader.CompletePreparation();pump.Until(load);
+  Check.That(h.Loader.MapStarted==136201&&Clock.Delays==2&&Clock.Milliseconds==136701,"The 136-second shared phase must not consume the map-build budget.");
+  Check.That(h.streamer.SharedProgress&&h.streamer.MapProgress&&h.streamer.Phase==Phase.Tutorial,"Both download phases need progress and the correct phase.");
+  Check.That(h.Stages.Any(s=>s.StartsWith("Building map "))&&h.Stages.Contains("World map ready"),"Map preparation/build/ready stages must be visible.");
+
+  Clock.Reset();h=new Harness();h.Loader.AlreadyLoaded=true;load=h.LoadWorldAsync(new Vector3());h.Loader.CompletePreparation();pump.Until(load);
+  Check.That(!h.Loader.Paused&&Clock.Delays==0,"An already-loaded destination must return unpaused, preserving the previous behavior.");
+
+  Clock.Reset();h=new Harness();h.Loader.FailPreparation=true;load=h.LoadWorldAsync(new Vector3());h.Loader.CompletePreparation();bool failed=false;
+  try{pump.Until(load);}catch(IOException){failed=true;}
+  Check.That(failed&&h.Loader.MapStarted==-1&&h.Loader.Queries==0&&Clock.Delays==0,"Shared preparation failure must propagate without entering the map wait.");
+
+  Clock.Reset();h=new Harness();h.streamer.FailDownload=true;failed=false;
+  try{pump.Until(h.LoadWorldAsync(new Vector3()));}catch(IOException){failed=true;}
+  Check.That(failed&&!h.Loader.PreparationBegun&&h.Loader.Queries==0,"Download failures must propagate before map startup.");
+
+  Clock.Reset();h=new Harness();h.Loader.NeverLoaded=true;load=h.LoadWorldAsync(new Vector3());Clock.Milliseconds=136201;h.Loader.CompletePreparation();failed=false;
+  try{pump.Until(load);}catch(TimeoutException){failed=true;}
+  Check.That(failed&&Clock.Delays==480&&Clock.Milliseconds-h.Loader.MapStarted==120000,"A genuinely stalled map must still get the full existing 120-second limit after shared preparation.");
+  Console.WriteLine("PASS: actual LoadWorldAsync excludes 136201ms shared preparation from map timeout, reports both downloads, preserves loaded-map behavior, propagates failures and retains the full 120s map limit.");
+ }
+}
+'''.replace("__METHOD__", method)
+
+dotnet = os.environ.get("DOTNET_EXE")
+if not dotnet:
+    dotnet = next((str(p) for p in (root / ".tools/dotnet/dotnet", root.parent / ".tools/dotnet/dotnet") if p.is_file()), None)
+dotnet = dotnet or shutil.which("dotnet")
+if not dotnet:
+    raise SystemExit("A local .NET 8 SDK is required; set DOTNET_EXE.")
+with tempfile.TemporaryDirectory(prefix="openfusion-world-preparation-") as directory:
+    work = Path(directory)
+    (work / "Program.cs").write_text(harness)
+    (work / "Check.csproj").write_text('<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><RestoreSources>/nonexistent</RestoreSources><ImplicitUsings>enable</ImplicitUsings><NuGetAudit>false</NuGetAudit></PropertyGroup></Project>')
+    env = dict(os.environ, DOTNET_CLI_HOME=str(work / "cli"), DOTNET_SKIP_FIRST_TIME_EXPERIENCE="1", DOTNET_CLI_TELEMETRY_OPTOUT="1", DOTNET_GENERATE_ASPNET_CERTIFICATE="false", DOTNET_NOLOGO="1")
+    subprocess.run([dotnet, "run", "--project", str(work / "Check.csproj")], cwd=root, env=env, check=True)
