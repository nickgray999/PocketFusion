diff --git a/Assets/Editor/IOSSceneLifecycle/UnityScene.mm.txt b/Assets/Editor/IOSSceneLifecycle/UnityScene.mm.txt
new file mode 100644
index 0000000..72c8432
--- /dev/null
+++ b/Assets/Editor/IOSSceneLifecycle/UnityScene.mm.txt
@@ -0,0 +1,99 @@
+// OpenFusion Pocket project-owned UIScene bridge for Unity 2022.3.62f3.
+// Uses the original runtime's startup, pause/resume and URL notification APIs.
+#import "UnityScene.h"
+#import "UnityAppController.h"
+#include "Unity/UnityInterface.h"
+
+@implementation UnityScene {
+    NSURL *_pendingURL;
+    NSDictionary *_pendingOptions;
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    for (UIOpenURLContext *context in options.URLContexts)
+    {
+        if (context.URL == nil) continue;
+        _pendingURL = context.URL;
+        NSMutableDictionary *values = [NSMutableDictionary dictionary];
+        if (context.options.sourceApplication != nil)
+            values[UIApplicationOpenURLOptionsSourceApplicationKey] = context.options.sourceApplication;
+        if (context.options.annotation != nil)
+            values[UIApplicationOpenURLOptionsAnnotationKey] = context.options.annotation;
+        _pendingOptions = values;
+        break;
+    }
+    if (_pendingURL == nil)
+        for (NSUserActivity *activity in options.userActivities)
+            if ([activity.activityType isEqualToString:NSUserActivityTypeBrowsingWeb] && activity.webpageURL != nil)
+            { _pendingURL = activity.webpageURL; _pendingOptions = @{}; break; }
+
+    // No graphics/window creation for a background-only connection. Set the cold
+    // launch URL before synchronous UnityLoadApplication can run managed Awake().
+    if (_pendingURL != nil)
+    {
+        [GetAppController() initUnityApplicationNoGraphics];
+        UnitySetAbsoluteURL(_pendingURL.absoluteString.UTF8String);
+    }
+}
+
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) return;
+    UnityAppController *controller = GetAppController();
+    [controller initUnityWithScene:(UIWindowScene *)scene];
+    self.window = controller.window;
+    // Emit the existing runtime/plugin URL notification only after full startup.
+    if (_pendingURL != nil)
+        [controller application:UIApplication.sharedApplication openURL:_pendingURL options:_pendingOptions ?: @{}];
+    _pendingURL = nil; _pendingOptions = nil;
+    [controller applicationWillEnterForeground:UIApplication.sharedApplication];
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{ [GetAppController() applicationDidBecomeActive:UIApplication.sharedApplication]; }
+
+// iOS 27 reads the scene delegate's mask in place of the Info.plist value.
+// Keep the ordinary-phone landscape startup and reuse Unity's runtime mask:
+// FoldScreenController enables portrait only while an inner hinge is available.
+- (UIInterfaceOrientationMask)supportedInterfaceOrientationsForWindowScene:(UIWindowScene *)windowScene
+{
+    UnityAppController *controller = GetAppController();
+    UIWindow *window = self.window ?: controller.window;
+    if (window.rootViewController == nil) return UIInterfaceOrientationMaskLandscape;
+    return (UIInterfaceOrientationMask)[controller application:UIApplication.sharedApplication supportedInterfaceOrientationsForWindow:window];
+}
+
+- (void)sceneWillResignActive:(UIScene *)scene
+{ [GetAppController() applicationWillResignActive:UIApplication.sharedApplication]; }
+
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{ [GetAppController() applicationDidEnterBackground:UIApplication.sharedApplication]; }
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    // The app controller retains the original Unity window/runtime for reconnect.
+    self.window = nil;
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)contexts
+{
+    for (UIOpenURLContext *context in contexts)
+    {
+        if (context.URL == nil) continue;
+        NSMutableDictionary *options = [NSMutableDictionary dictionary];
+        if (context.options.sourceApplication != nil)
+            options[UIApplicationOpenURLOptionsSourceApplicationKey] = context.options.sourceApplication;
+        if (context.options.annotation != nil)
+            options[UIApplicationOpenURLOptionsAnnotationKey] = context.options.annotation;
+        [GetAppController() application:UIApplication.sharedApplication openURL:context.URL options:options];
+        break;
+    }
+}
+
+- (void)scene:(UIScene *)scene continueUserActivity:(NSUserActivity *)activity
+{
+    if ([activity.activityType isEqualToString:NSUserActivityTypeBrowsingWeb] && activity.webpageURL != nil)
+        [GetAppController() application:UIApplication.sharedApplication openURL:activity.webpageURL options:@{}];
+}
+@end
