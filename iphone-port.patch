diff --git a/Assets/Scripts/OpenFusion/World/SpawnSupportGate.cs b/Assets/Scripts/OpenFusion/World/SpawnSupportGate.cs
new file mode 100644
index 0000000..bea6f54
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/World/SpawnSupportGate.cs
@@ -0,0 +1,74 @@
+using System;
+using OpenFusion.Net;
+
+namespace OpenFusion.World
+{
+    /// <summary>Fail-closed boundary between an authoritative spawn and local movement.</summary>
+    public sealed class SpawnSupportGate
+    {
+        public enum Result { Waiting, Ready, Failed, Stale }
+        public const float MaxRise = 1f, MaxDrop = 8f;
+        public const double ReadyMapTimeout = 10d;
+        int generation;
+        float feet;
+        double readySince = double.NaN;
+        Result state = Result.Waiting;
+        public bool Ready => state == Result.Ready;
+        public float ResolvedHeight { get; private set; }
+        public bool Water { get; private set; }
+
+        public int Begin(float authoritativeFeet)
+        {
+            generation++;
+            feet = ResolvedHeight = authoritativeFeet;
+            Water = false;
+            readySince = double.NaN;
+            state = Finite(feet) ? Result.Waiting : Result.Failed;
+            return generation;
+        }
+
+        public void Invalidate() { generation++; state = Result.Failed; }
+
+        public Result Evaluate(int ticket, bool mapReady, bool floorFound, float floor,
+            bool waterFound, float water, double now)
+        {
+            // A late result from an older spawn/owner cannot release a newer hold.
+            if (ticket != generation) return Result.Stale;
+            if (state != Result.Waiting) return state;
+            if (!mapReady) { readySince = double.NaN; return state; }
+            if (double.IsNaN(now) || double.IsInfinity(now)) return state = Result.Failed;
+            if (TryChooseSurface(feet, floorFound, floor, waterFound, water, out float surface, out bool wet))
+            {
+                ResolvedHeight = Math.Max(feet, surface);
+                Water = wet;
+                return state = Result.Ready;
+            }
+            if (double.IsNaN(readySince)) readySince = now;
+            if (now - readySince >= ReadyMapTimeout) state = Result.Failed;
+            return state;
+        }
+
+        public static bool TryChooseSurface(float feet, bool floorFound, float floor,
+            bool waterFound, float water, out float height, out bool wet)
+        {
+            height = feet; wet = false;
+            if (!Finite(feet)) return false;
+            bool solid = floorFound && Nearby(feet, floor), liquid = waterFound && Nearby(feet, water);
+            if (!solid && !liquid) return false;
+            wet = liquid && (!solid || Math.Abs(water - feet) < Math.Abs(floor - feet));
+            height = wet ? water : floor;
+            return true;
+        }
+
+        static bool Nearby(float feet, float surface) => Finite(surface) && surface - feet <= MaxRise + .001f
+            && surface - feet >= -MaxDrop - .001f;
+        static bool Finite(float number) => !float.IsNaN(number) && !float.IsInfinity(number);
+
+        public static bool IsMovementPacket(uint id) => id == PacketIds.P_CL2FE_REQ_PC_MOVE
+            || id == PacketIds.P_CL2FE_REQ_PC_STOP || id == PacketIds.P_CL2FE_REQ_PC_JUMP
+            || id == PacketIds.P_CL2FE_REQ_PC_JUMPPAD || id == PacketIds.P_CL2FE_REQ_PC_ZIPLINE
+            || id == PacketIds.P_CL2FE_REQ_PC_MOVEPLATFORM || id == PacketIds.P_CL2FE_REQ_PC_SLOPE
+            || id == PacketIds.P_CL2FE_REQ_PC_MOVETRANSPORTATION || id == PacketIds.P_CL2FE_REQ_PC_ROPE
+            || id == PacketIds.P_CL2FE_REQ_PC_BELT;
+    }
+}
