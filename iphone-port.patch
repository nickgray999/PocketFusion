+
+namespace OpenFusion
+{
+    public sealed partial class GameClient
+    {
+        static bool sessionCleanupPending;
+
+        async Task ReleasePreviousSessionAsync()
+        {
+            if (Application.platform != RuntimePlatform.IPhonePlayer || !sessionCleanupPending) return;
+            sessionCleanupPending = false;
+            var loading = LoadingScreen.Ensure();
+            // The loading screen survives scene changes. Release its old bootstrap
+            // subscription before collecting the previous session's decoded assets.
+            loading.Bind(null);
+            loading.ShowStage("RELEASING PREVIOUS SESSION");
+            try
+            {
+                await Task.Yield();
+                GC.Collect();
+                var unload = Resources.UnloadUnusedAssets();
+                while (!unload.isDone) await Task.Yield();
+                GC.Collect();
+                RecordStartup("PREVIOUS SESSION RELEASED");
+            }
+            finally { if (loading != null) loading.Hide(); }
+        }
+    }
+}
