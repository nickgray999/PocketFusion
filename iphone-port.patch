new file mode 100644
index 0000000..ed8c06d
--- /dev/null
+++ b/tests/MobileLifecycleTest/Program.cs
@@ -0,0 +1,102 @@
+using System;
+using System.Reflection;
+
+namespace OpenFusion.World
+{
+    public static class TutorialTraining { public static bool Active; }
+}
+
+namespace OpenFusion
+{
+    // Compile the production partial fragment without pretending to run Unity or
+    // the existing scene reload. Observe its call to the normal logout boundary.
+    public sealed partial class GameClient
+    {
+        public sealed class Connection : IDisposable
+        {
+            public int Disposals;
+            public bool ThrowOnDispose;
+            public void Dispose()
+            {
+                Disposals++;
+                if (ThrowOnDispose) throw new InvalidOperationException("test disposal failure");
+            }
+        }
+        public sealed class Shard { public Connection Session; }
+        public bool shardAlive = true, SendMovement = true;
+        public Shard Shard_;
+        public Connection Login;
+        public int LauncherReturns;
+        public bool WorldConnected => shardAlive && Shard_ != null && Shard_.Session != null;
+        void ReturnToLauncher() { LauncherReturns++; }
+#if UNITY_IOS && !UNITY_EDITOR
+        public void Pause(bool paused) => OnApplicationPause(paused);
+#endif
+    }
+}
+
+static class Program
+{
+    static int assertions;
+    static void Check(bool condition, string message)
+    {
+        assertions++;
+        if (!condition) throw new InvalidOperationException(message);
+    }
+    static OpenFusion.GameClient Live()
+    {
+        return new OpenFusion.GameClient
+        {
+            Shard_ = new OpenFusion.GameClient.Shard { Session = new OpenFusion.GameClient.Connection() },
+            Login = new OpenFusion.GameClient.Connection()
+        };
+    }
+    static void Main()
+    {
+#if UNITY_IOS && !UNITY_EDITOR
+        var game = Live();
+        game.Pause(false);
+        Check(game.LauncherReturns == 0, "Initial foreground notification must not log out.");
+        game.Pause(true);
+        Check(!game.SendMovement && !game.WorldConnected, "Suspension must stop gameplay sends before resume.");
+        Check(game.Shard_.Session.Disposals == 1 && game.Login.Disposals == 1, "Suspension must close both connections.");
+        game.Pause(true);
+        Check(game.Shard_.Session.Disposals == 1 && game.Login.Disposals == 1, "Duplicate pause must not close connections twice.");
+        game.Pause(false);
+        Check(game.LauncherReturns == 1, "Resume must dispatch the normal logout path.");
+        game.Pause(false);
+        Check(game.LauncherReturns == 1, "Duplicate resume must not reload the launcher again.");
+
+        var idle = new OpenFusion.GameClient();
+        idle.Pause(true); idle.Pause(false);
+        Check(idle.LauncherReturns == 0 && idle.SendMovement, "Launcher or character screens must not be reset.");
+
+        var disconnected = Live(); disconnected.shardAlive = false;
+        disconnected.Pause(true); disconnected.Pause(false);
+        Check(disconnected.LauncherReturns == 0 && disconnected.Login.Disposals == 0, "This handler must only interrupt a live world session.");
+
+        OpenFusion.World.TutorialTraining.Active = true;
+        var practice = Live(); practice.Pause(true); practice.Pause(false);
+        Check(practice.WorldConnected && practice.LauncherReturns == 0 && practice.Login.Disposals == 0, "Local practice is not a network world session.");
+        OpenFusion.World.TutorialTraining.Active = false;
+
+        var broken = Live(); broken.Shard_.Session.ThrowOnDispose = true;
+        broken.Pause(true);
+        Check(broken.Login.Disposals == 1 && !broken.WorldConnected, "A shard disposal exception must not prevent login disposal.");
+        broken.Pause(false);
+        Check(broken.LauncherReturns == 1, "A disposal exception must not prevent foreground recovery.");
+
+        var noLogin = Live(); noLogin.Login = null;
+        noLogin.Pause(true); noLogin.Pause(false);
+        Check(noLogin.LauncherReturns == 1, "A missing login connection must not prevent recovery.");
+
+        Check(typeof(OpenFusion.GameClient).GetMethod("OnApplicationFocus", BindingFlags.Instance | BindingFlags.NonPublic) == null,
+            "Focus and keyboard events must not be used to end sessions.");
+        Console.WriteLine("PASS: " + assertions + " iOS lifecycle assertions (stubbed state/logout boundary; no Unity or device run).");
+#else
+        Check(typeof(OpenFusion.GameClient).GetMethod("OnApplicationPause", BindingFlags.Instance | BindingFlags.NonPublic) == null,
+            "The iOS lifecycle handler must not be compiled for Android or the editor.");
+        Console.WriteLine("PASS: non-device-iOS compile gate; no lifecycle override.");
+#endif
+    }
+}
diff --git a/tests/SessionAssetReleaseTest/Program.cs b/tests/SessionAssetReleaseTest/Program.cs
new file mode 100644
index 0000000..1c6315b
--- /dev/null
+++ b/tests/SessionAssetReleaseTest/Program.cs
@@ -0,0 +1,91 @@
+using System.Buffers.Binary;
+using System.Collections;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using OpenFusion.Assets;
+using OpenFusion.World;
+
+class Program
+{
+    static int assertions;
+    static void Check(bool condition, string message)
+    { assertions++; if (!condition) throw new Exception(message); }
+
+    // A minimal valid v6 serialized file with a large payload. Use the actual
+    // parser and AssetStore registration, rather than simulating byte ownership.
+    static byte[] SerializedBytes()
+    {
+        var bytes = new byte[8 * 1024 * 1024];
+        BinaryPrimitives.WriteUInt32BigEndian(bytes.AsSpan(0, 4), 13);
+        BinaryPrimitives.WriteUInt32BigEndian(bytes.AsSpan(4, 4), (uint)bytes.Length);
+        BinaryPrimitives.WriteUInt32BigEndian(bytes.AsSpan(8, 4), 6);
+        BinaryPrimitives.WriteUInt32BigEndian(bytes.AsSpan(12, 4), 16);
+        return bytes;
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    static WeakReference RegisterBytes(AssetStore store)
+    {
+        var bytes = SerializedBytes();
+        store.Add("session.assets", bytes);
+        return new WeakReference(bytes);
+    }
+
+    static async Task Main()
+    {
+        var store = new AssetStore();
+        var bytes = RegisterBytes(store);
+        GC.Collect(); GC.WaitForPendingFinalizers(); GC.Collect();
+        Check(bytes.IsAlive && store.Has("session.assets"), "A live session must retain its serialized bytes.");
+        // Prime every parsed cache, then keep the store alive after teardown as a
+        // stale ModelFactory/MonoBehaviour shell would do in the native player.
+        foreach (var field in typeof(AssetStore).GetFields(BindingFlags.Instance | BindingFlags.NonPublic))
+        {
+            if (field.Name == "files") continue;
+            var dictionary = (IDictionary)field.GetValue(store);
+            var valueType = field.FieldType.GenericTypeArguments[1];
+            dictionary.Add(("session.assets", 1L), valueType == typeof(string) ? "shader" : Activator.CreateInstance(valueType));
+        }
+        store.Clear(); store.Clear();
+        Check(!store.Has("session.assets") && store.Get("session.assets") == null
+            && !store.Resolve("session.assets", 0, 1).Ok, "Teardown must stop resolving old session data.");
+        foreach (var field in typeof(AssetStore).GetFields(BindingFlags.Instance | BindingFlags.NonPublic))
+            Check(((IDictionary)field.GetValue(store)).Count == 0, "Serialized and parsed caches must all be empty: " + field.Name);
+        GC.Collect(); GC.WaitForPendingFinalizers(); GC.Collect();
+        Check(!bytes.IsAlive, "Serialized bytes must be collectible even while the old store remains reachable.");
+        GC.KeepAlive(store);
+
+        var source = new ControlledSource();
+        var manager = new BundleManager(source, new CachingManifest25());
+        var first = manager.Load("Map_01_00.unity3d");
+        Check(first != null && manager.IsLoaded("Map_01_00.unity3d"), "Active sessions must still register map assets.");
+        Check(ReferenceEquals(first["scene"], manager.Load("Map_01_00.unity3d")["scene"]) && source.Calls == 1,
+            "Live resident bytes must still be reused.");
+        manager.Dispose(); manager.Dispose();
+        Check(manager.LoadedFiles.Count == 0 && !manager.IsLoaded("Map_01_00.unity3d"), "Disposed sessions must have no registered bundles.");
+        Check(manager.Load("Map_02_00.unity3d") == null && source.Calls == 1, "Disposed sessions must not begin another disk decode.");
+        GC.KeepAlive(first);
+
+        source = new ControlledSource { Block = true };
+        manager = new BundleManager(source, new CachingManifest25());
+        var pending = Task.Run(() => manager.Load("Map_03_00.unity3d"));
+        Check(source.Started.Wait(TimeSpan.FromSeconds(5)), "The race fixture must reach its pending decode.");
+        manager.Dispose();
+        source.Release.Set();
+        Check(await pending.WaitAsync(TimeSpan.FromSeconds(5)) == null, "A decode completing after logout must discard its registration.");
+        Check(manager.LoadedFiles.Count == 0 && !manager.IsLoaded("Map_03_00.unity3d"), "Late completion must not repopulate the closed session.");
+        Console.WriteLine("PASS: " + assertions + " production AssetStore/BundleManager assertions: old serialized bytes collect, all parsed caches clear, live reuse persists, disposal is idempotent, and an in-flight decode cannot re-register after logout.");
+    }
+
+    sealed class ControlledSource : IBundleSource
+    {
+        public readonly ManualResetEventSlim Started = new(), Release = new();
+        public bool Block; public int Calls;
+        public Dictionary<string, byte[]> Load(string name)
+        {
+            Calls++; Started.Set();
+            if (Block && !Release.Wait(TimeSpan.FromSeconds(5))) throw new TimeoutException("Decode fixture was never released.");
+            return new Dictionary<string, byte[]> { ["scene"] = new byte[1024] };
+        }
+    }
+}
