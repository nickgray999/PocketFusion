new file mode 100644
index 0000000..9cb5ed0
--- /dev/null
+++ b/Assets/Editor/IOSXcodePostprocess.cs
@@ -0,0 +1,86 @@
+using System;
+using System.IO;
+using System.Xml;
+using UnityEditor;
+using UnityEditor.Build;
+using UnityEditor.Build.Reporting;
+using UnityEngine;
+#if UNITY_IOS
+using UnityEditor.iOS.Xcode;
+#endif
+
+namespace OpenFusion.EditorTools
+{
+    public sealed class IOSXcodePostprocess : IPostprocessBuildWithReport
+    {
+        public int callbackOrder => 1000;
+
+        public void OnPostprocessBuild(BuildReport report)
+        {
+            if (report.summary.platform != BuildTarget.iOS) return;
+            Apply(report.summary.outputPath);
+        }
+
+        // Shared by the Editor callback and the explicit batch/menu export path.
+        // Applying this more than once must preserve URL schemes and PBX entries.
+        public static void Apply(string output)
+        {
+            IOSSceneLifecycle.Apply(output);
+            string plistPath = Path.Combine(output, "Info.plist");
+            IOSPlist.Configure(plistPath);
+            foreach (string file in new[] { "UnityScene.h", "UnityScene.mm" })
+                if (!File.Exists(Path.Combine(output, "Classes", "UI", file)))
+                    throw new BuildFailedException("Export is missing Classes/UI/" + file + ". Re-export with the project's iPhone exporter; a plist-only scene manifest cannot repair a legacy player.");
+#if UNITY_IOS
+            string projectPath = PBXProject.GetPBXProjectPath(output);
+            var project = new PBXProject(); project.ReadFromFile(projectPath);
+            string target = project.GetUnityFrameworkTargetGuid();
+            if (!project.ContainsFramework(target, "Security.framework"))
+                project.AddFrameworkToProject(target, "Security.framework", false);
+            project.WriteToFile(projectPath);
+#endif
+            VerifyPlist(plistPath);
+            Debug.Log("OpenFusion: verified native scene lifecycle, registered ofl:// links and restricted iOS transport exceptions to public asset hosts.");
+        }
+
+        static void VerifyPlist(string path)
+        {
+            try { IOSPlist.VerifyGeneratedSceneManifest(path); }
+            catch (InvalidDataException e) { throw new BuildFailedException(e.Message); }
+            var doc = new XmlDocument { XmlResolver = null }; doc.Load(path);
+            var root = doc.SelectSingleNode("/plist/dict");
+            var ats = Value(root, "NSAppTransportSecurity");
+            if (ats == null || ats.Name != "dict" || Value(ats, "NSAllowsArbitraryLoads")?.Name != "false")
+                throw new BuildFailedException("Exported Info.plist must disable the global ATS bypass.");
+            foreach (string key in new[] { "NSAllowsArbitraryLoadsInWebContent", "NSAllowsArbitraryLoadsForMedia", "NSAllowsLocalNetworking" })
+                if (Value(ats, key) != null)
+                    throw new BuildFailedException("Exported Info.plist retained a broad ATS exception: " + key);
+            var domains = Value(ats, "NSExceptionDomains");
+            if (domains == null || domains.Name != "dict" || domains.SelectNodes("key").Count != IOSPlist.HttpAssetHosts.Length)
+                throw new BuildFailedException("Exported Info.plist must contain only the configured asset host exceptions.");
+            foreach (string host in IOSPlist.HttpAssetHosts)
+            {
+                var domain = Value(domains, host);
+                if (domain == null || domain.Name != "dict" || Value(domain, "NSExceptionAllowsInsecureHTTPLoads")?.Name != "true" || Value(domain, "NSIncludesSubdomains")?.Name != "false")
+                    throw new BuildFailedException("Exported Info.plist is missing the exact HTTP asset exception for " + host);
+            }
+            bool hasScheme = false;
+            foreach (XmlNode scheme in doc.SelectNodes("/plist/dict/key[text()='CFBundleURLTypes']/following-sibling::*[1]/dict/key[text()='CFBundleURLSchemes']/following-sibling::*[1]/string"))
+                if (string.Equals(scheme.InnerText, "ofl", StringComparison.OrdinalIgnoreCase)) hasScheme = true;
+            if (!hasScheme) throw new BuildFailedException("Exported Info.plist did not register ofl:// server links.");
+        }
+
+        static XmlNode Value(XmlNode dict, string name)
+        {
+            if (dict == null) return null;
+            foreach (XmlNode node in dict.ChildNodes)
+                if (node.Name == "key" && node.InnerText == name)
+                {
+                    var value = node.NextSibling;
+                    while (value != null && !(value is XmlElement)) value = value.NextSibling;
+                    return value;
+                }
+            return null;
+        }
+    }
+}
