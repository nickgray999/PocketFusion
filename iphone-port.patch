@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+# Export an iPhone Xcode project with the pinned Unity Editor on macOS.
+set -euo pipefail
+
+project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+editor_version="$(awk '/^m_EditorVersion: / {print $2; exit}' "$project_dir/ProjectSettings/ProjectVersion.txt")"
+editor_bin="${UNITY_EDITOR_BIN:-/Applications/Unity/Hub/Editor/$editor_version/Unity.app/Contents/MacOS/Unity}"
+output_dir="$project_dir/Builds/iOS"
+check_only=false
+development=false
+
+usage() {
+    cat <<'USAGE'
+Usage: tools/unity-ios-build.sh [--check] [--development] [--editor PATH] [--output DIRECTORY]
+
+  --check         Report installed prerequisites without opening Unity.
+  --development   Export a development build with script debugging.
+  --editor PATH   Unity executable (or set UNITY_EDITOR_BIN).
+  --output DIR    Export directory; defaults to this project's Builds/iOS.
+
+Activate your Unity license in Unity Hub before exporting. Xcode signs and
+installs the exported project on a connected iPhone.
+USAGE
+}
+
+while (($#)); do
+    case "$1" in
+        --check) check_only=true; shift ;;
+        --development) development=true; shift ;;
+        --editor|--output)
+            option="$1"
+            if (($# < 2)) || [[ "$2" == --* ]]; then
+                printf '%s requires a value.\n' "$option" >&2
+                exit 2
+            fi
+            if [[ "$option" == --editor ]]; then editor_bin="$2"; else output_dir="$2"; fi
+            shift 2 ;;
+        --help|-h) usage; exit 0 ;;
+        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
+    esac
+done
+
+# Preserve a caller-relative executable path when we later enter the project.
+if [[ "$editor_bin" != /* && -x "$editor_bin" ]]; then
+    editor_bin="$(cd -- "$(dirname -- "$editor_bin")" && pwd)/$(basename -- "$editor_bin")"
+fi
+
+# Unity's native compiler needs the iPhone SDK even when xcode-select still
+# points at CommandLineTools. Select full Xcode for this process only, while
+# preserving a caller's explicit choice or a different selected Xcode install.
+if [[ -z "${DEVELOPER_DIR:-}" ]]; then
+    selected_developer_dir="$(xcode-select -p 2>/dev/null || true)"
+    if [[ "$selected_developer_dir" == */CommandLineTools && -d /Applications/Xcode.app/Contents/Developer ]]; then
+        export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
+    fi
+fi
+
+if $check_only; then
+    missing=false
+    printf 'Required Unity: %s\nProject: %s\n' "$editor_version" "$project_dir"
+    if [[ -x "$editor_bin" ]]; then
+        printf 'Unity Editor: %s\n' "$editor_bin"
+        ios_module="$(dirname -- "$editor_bin")/../../../PlaybackEngines/iOSSupport"
+        bundled_ios_module="$(dirname -- "$editor_bin")/../PlaybackEngines/iOSSupport"
+        if [[ -d "$ios_module" || -d "$bundled_ios_module" ]]; then printf 'iOS Build Support: installed\n';
+        else printf 'iOS Build Support: missing; add it in Unity Hub\n'; missing=true; fi
+    else
+        printf 'Unity Editor: missing at %s\n' "$editor_bin"
+        missing=true
+    fi
+    if xcodebuild -version 2>/dev/null; then :
+    else printf 'Xcode: missing or not selected; required to build/sign the export\n'; missing=true; fi
+    printf 'Unity license and Apple signing: checked by Unity Hub and Xcode when used.\n'
+    if $missing; then exit 1; fi
+    exit 0
+fi
+
+if [[ ! -x "$editor_bin" ]]; then
+    printf 'Unity %s was not found at %s.\nInstall it with iOS Build Support in Unity Hub, or pass --editor.\n' "$editor_version" "$editor_bin" >&2
+    exit 1
+fi
+mkdir -p "$project_dir/Logs"
+log_path="$project_dir/Logs/unity-ios-export.log"
+args=(-batchmode -nographics -buildTarget iOS -projectPath "$project_dir"
+      -executeMethod OpenFusion.EditorTools.IOSBuild.Batch
+      -iosOutput "$output_dir" -logFile "$log_path")
+if $development; then args+=(-iosDevelopment); fi
+printf 'Unity: %s\nXcode export: %s\nBuild log: %s\n' "$editor_bin" "$output_dir" "$log_path"
+cd -- "$project_dir"
+exec "$editor_bin" "${args[@]}"
