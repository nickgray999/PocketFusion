+        static void CheckCameraFloor(List<string> results)
+        {
+            var fixtures = new List<GameObject>();
+            var correct = typeof(GameClient).GetMethod("CorrectTouchCameraFloor", HiddenStatic);
+            Check(correct != null, "Production camera-floor correction helper must be present.");
+            // Isolate the fixture from any camera or startup-scene geometry.
+            var origin = new Vector3(4096f, 0f, 4096f);
+            try
+            {
+                Func<string, float, float, Transform, bool, BoxCollider> box = (name, top, thickness, parent, trigger) =>
+                {
+                    var host = new GameObject(name); fixtures.Add(host);
+                    if (parent != null) host.transform.SetParent(parent, false);
+                    host.transform.position = origin + Vector3.up * (top - thickness * .5f);
+                    var collider = host.AddComponent<BoxCollider>();
+                    collider.size = new Vector3(8f, thickness, 8f); collider.isTrigger = trigger;
+                    return collider;
+                };
+                var floor = box("camera check floor", 0f, 1f, null, false);
+                box("camera check overhead station roof", 5f, .5f, null, false);
+                var actor = new GameObject("camera check player"); fixtures.Add(actor);
+                actor.transform.position = origin;
+                Func<float, Vector3> position = y => origin + Vector3.up * y;
+                Func<float, Vector3> corrected = y => (Vector3)correct.Invoke(null, new object[] { position(y), actor.transform });
+                Physics.SyncTransforms();
+                Check((corrected(1f) - position(1f)).sqrMagnitude < .0001f,
+                    "A camera one metre above the floor must stay there instead of rising to the overhead roof.");
+                Check(Mathf.Abs(corrected(.1f).y - .25f) < Epsilon,
+                    "A camera close to physical support must retain 0.25m floor clearance.");
+
+                box("camera check trigger", .2f, .05f, null, true);
+                box("camera check actor child", .3f, .05f, actor.transform, false);
+                Physics.SyncTransforms();
+                var supported = corrected(.1f);
+                Check(Mathf.Abs(supported.y - .25f) < Epsilon && supported.x == origin.x && supported.z == origin.z,
+                    "Trigger and player-child colliders must not lift the camera above the actual floor or move it sideways.");
+                floor.enabled = false;
+                Physics.SyncTransforms();
+                Check((corrected(.1f) - position(.1f)).sqrMagnitude < .0001f,
+                    "Without nearby physical floor, ignored triggers, actor colliders and distant roofs must leave camera height unchanged.");
+                results.Add("PASS: real physics camera-floor probe ignores an overhead roof, triggers and player children while retaining nearby-floor clearance.");
+            }
+            finally
+            {
+                for (int i = fixtures.Count - 1; i >= 0; i--)
+                    if (fixtures[i] != null) UnityEngine.Object.DestroyImmediate(fixtures[i]);
+                Physics.SyncTransforms();
+            }
+        }
