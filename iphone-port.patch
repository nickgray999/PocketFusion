+using OpenFusion.Net;
+using OpenFusion.World;
+
+int assertions = 0;
+void Check(bool condition, string message) { assertions++; if (!condition) throw new Exception(message); }
+void Near(float actual, float expected, string message) => Check(Math.Abs(actual - expected) < .0001f, message);
+
+var gate = new SpawnSupportGate();
+Check(!gate.Ready, "An uninitialized gate must fail closed.");
+int ticket = gate.Begin(26.39f);
+Check(gate.Evaluate(ticket, true, true, 26.4f, false, 0f, 0d) == SpawnSupportGate.Result.Ready,
+    "A nearby physical platform releases the hold.");
+Near(gate.ResolvedHeight, 26.4f, "A small penetration repair must use only the nearby support.");
+Check(!gate.Water, "A solid platform must not become water.");
+
+ticket = gate.Begin(10f);
+Check(gate.Evaluate(ticket, true, true, 2.1f, false, 0f, 0d) == SpawnSupportGate.Result.Ready,
+    "A verified floor below the spawn permits normal controller settling.");
+Near(gate.ResolvedHeight, 10f, "The gate must not snap the avatar downward through intervening geometry.");
+
+ticket = gate.Begin(-46.15f);
+Check(gate.Evaluate(ticket, true, true, -50.156f, false, 0f, 0d) == SpawnSupportGate.Result.Ready,
+    "The real Warp Away spawn deliberately four metres above decoded terrain must allow a verified fall to that floor.");
+Near(gate.ResolvedHeight, -46.15f, "A verified four-metre drop preserves authoritative feet until controller settling.");
+
+ticket = gate.Begin(10f);
+Check(gate.Evaluate(ticket, false, true, 10f, false, 0f, 100d) == SpawnSupportGate.Result.Waiting,
+    "A floor result must not release a destination map that is not ready.");
+for (int frame = 0; frame < 1200; frame++)
+    Check(gate.Evaluate(ticket, false, false, 0f, false, 0f, 101d + frame) == SpawnSupportGate.Result.Waiting,
+        "Slow map download/build time must not consume the support timeout.");
+Check(gate.Evaluate(ticket, true, false, 0f, false, 0f, 2000d) == SpawnSupportGate.Result.Waiting,
+    "Support timeout begins only when the map becomes ready.");
+for (int frame = 1; frame < 600; frame++)
+    Check(gate.Evaluate(ticket, true, false, 0f, false, 0f, 2000d + frame / 60d) == SpawnSupportGate.Result.Waiting,
+        "Missing support must remain blocked for more than the old ten-frame limit.");
+Check(gate.Evaluate(ticket, true, false, 0f, false, 0f, 2010d) == SpawnSupportGate.Result.Failed,
+    "Missing support must fail closed after ten ready-map seconds.");
+Check(gate.Evaluate(ticket, true, true, 10f, false, 0f, 2011d) == SpawnSupportGate.Result.Failed && !gate.Ready,
+    "A failed gate must not silently recover and start sending movement.");
+
+ticket = gate.Begin(-46.15f);
+Check(gate.Evaluate(ticket, true, true, 49f, false, 0f, 0d) == SpawnSupportGate.Result.Waiting,
+    "The real approximately 95m terrain mismatch must not authorize a teleport to the roof or a fall.");
+Check(gate.Evaluate(ticket, true, true, 49f, false, 0f, 10d) == SpawnSupportGate.Result.Failed,
+    "A fully loaded mismatched terrain must fail rather than release gravity.");
+Near(gate.ResolvedHeight, -46.15f, "A failed hold preserves authoritative feet.");
+
+ticket = gate.Begin(10f);
+Check(gate.Evaluate(ticket, true, false, 0f, true, 9.8f, 0d) == SpawnSupportGate.Result.Ready && gate.Water,
+    "Registered nearby water may support a valid spawn without solid ground.");
+Near(gate.ResolvedHeight, 10f, "A water surface below the feet is settled by physics after release.");
+ticket = gate.Begin(10f);
+Check(gate.Evaluate(ticket, true, true, 8.5f, true, 10.1f, 0d) == SpawnSupportGate.Result.Ready && gate.Water,
+    "Nearby water wins over a more distant underwater floor.");
+Near(gate.ResolvedHeight, 10.1f, "Small water-surface penetration may be repaired.");
+ticket = gate.Begin(10f);
+Check(gate.Evaluate(ticket, true, true, 10f, true, 10.5f, 0d) == SpawnSupportGate.Result.Ready && !gate.Water,
+    "A nearer dry platform wins over an unrelated water surface.");
+
+int oldTicket = gate.Begin(1f);
+ticket = gate.Begin(40f);
+Check(gate.Evaluate(oldTicket, true, true, 1f, false, 0f, 0d) == SpawnSupportGate.Result.Stale && !gate.Ready,
+    "An old spawn callback must not release the newer spawn's hold.");
+Check(gate.Evaluate(ticket, true, false, 0f, false, 0f, 20d) == SpawnSupportGate.Result.Waiting,
+    "A stale result must not start or expire the current spawn's timeout.");
+Check(gate.Evaluate(ticket, true, true, 40f, false, 0f, 20.1d) == SpawnSupportGate.Result.Ready,
+    "The current spawn can still validate after rejecting the stale result.");
+gate.Invalidate();
+Check(gate.Evaluate(ticket, true, true, 40f, false, 0f, 20.2d) == SpawnSupportGate.Result.Stale && !gate.Ready,
+    "Owner teardown invalidates pending results.");
+
+ticket = gate.Begin(10f);
+Check(gate.Evaluate(ticket, true, false, 0f, false, 0f, 0d) == SpawnSupportGate.Result.Waiting,
+    "A new pending hold starts its ready-map timer.");
+Check(gate.Evaluate(ticket, false, false, 0f, false, 0f, 30d) == SpawnSupportGate.Result.Waiting,
+    "Defeated-character recovery can pause support validation without timing out the server revive clock.");
+Check(gate.Evaluate(ticket, true, false, 0f, false, 0f, 31d) == SpawnSupportGate.Result.Waiting,
+    "Returning from a paused recovery starts a fresh floor-validation window.");
+ticket = gate.Begin(-46.15f);
+Check(gate.Evaluate(ticket, true, true, -50.156f, false, 0f, 32d) == SpawnSupportGate.Result.Ready,
+    "A new server-approved respawn can validate its own floor after an old hold or failure.");
+
+foreach (float bad in new[] { float.NaN, float.NegativeInfinity, float.PositiveInfinity })
+{
+    ticket = gate.Begin(bad);
+    Check(gate.Evaluate(ticket, true, true, 0f, true, 0f, 0d) == SpawnSupportGate.Result.Failed && !gate.Ready,
+        "Malformed authoritative height must fail closed.");
+    ticket = gate.Begin(0f);
+    Check(gate.Evaluate(ticket, true, true, bad, true, bad, 0d) == SpawnSupportGate.Result.Waiting,
+        "Invalid surface samples must not release movement.");
+}
+foreach (float far in new[] { -8.01f, 1.01f, -95f, 95f })
+{
+    ticket = gate.Begin(0f);
+    Check(gate.Evaluate(ticket, true, true, far, true, far, 0d) == SpawnSupportGate.Result.Waiting,
+        "Out-of-range physical or water support must not release movement.");
+}
+
+foreach (uint id in new[] { PacketIds.P_CL2FE_REQ_PC_MOVE, PacketIds.P_CL2FE_REQ_PC_STOP, PacketIds.P_CL2FE_REQ_PC_JUMP,
+    PacketIds.P_CL2FE_REQ_PC_JUMPPAD, PacketIds.P_CL2FE_REQ_PC_ZIPLINE, PacketIds.P_CL2FE_REQ_PC_MOVEPLATFORM,
+    PacketIds.P_CL2FE_REQ_PC_SLOPE, PacketIds.P_CL2FE_REQ_PC_MOVETRANSPORTATION,
+    PacketIds.P_CL2FE_REQ_PC_ROPE, PacketIds.P_CL2FE_REQ_PC_BELT })
+    Check(SpawnSupportGate.IsMovementPacket(id), "Every movement packet family must be held behind support validation.");
+Check(!SpawnSupportGate.IsMovementPacket(PacketIds.P_CL2FE_REQ_PC_LOADING_COMPLETE),
+    "Map handshake remains available while movement is held.");
+Check(!SpawnSupportGate.IsMovementPacket(PacketIds.P_CL2FE_REQ_PC_REGEN),
+    "Authoritative recovery requests are not mistaken for local movement.");
+Check(!SpawnSupportGate.IsMovementPacket(PacketIds.P_CL2FE_REQ_PC_EXIT),
+    "Session exit remains available while movement is held.");
+
+Console.WriteLine($"PASS {assertions} production spawn-support gate assertions: bounded floors/water, preserved authoritative feet, map readiness, ten-second fail-closed timeout, stale results, teardown and all movement packet families.");
