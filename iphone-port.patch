+                run(new[] { Finger(51, left, TouchPhase.Began), Finger(52, center, TouchPhase.Began) });
+                process(new[] { Finger(51, leftMoved, TouchPhase.Moved), Finger(52, deflected, TouchPhase.Moved) }, true, true);
+                Check(!TouchControls.JoystickHeld && !TouchControls.CameraHeld && Zero(TouchControls.Move) && Zero(TouchControls.Look),
+                    "Blocking UI must cancel movement and a held camera-stick turn together.");
+                run(new[] { Finger(51, leftMoved, TouchPhase.Stationary), Finger(52, deflected, TouchPhase.Stationary) });
+                Check(!TouchControls.JoystickHeld && !TouchControls.CameraHeld && Zero(TouchControls.Look),
+                    "A pre-dialog camera finger must not resume rotating when blocking UI closes.");
+
+                run(new[] { Finger(52, center, TouchPhase.Began) });
+                run(new[] { Finger(52, deflected, TouchPhase.Moved) });
+                reset();
+                Check(!TouchControls.CameraHeld && Zero(TouchControls.Look),
+                    "Surface cancellation must clear a stationary camera-stick hold immediately.");
+                run(new[] { Finger(52, deflected, TouchPhase.Stationary) });
+                Check(!TouchControls.CameraHeld && Zero(TouchControls.Look),
+                    "The old stick finger must not reacquire after surface cancellation.");
+
+                // Custom profiles can intentionally overlap UI. Visible HUD
+                // ownership must still win rather than acquiring the stick.
+                for (int hud = 0; hud < 3; hud++)
+                {
+                    reset();
+                    if (hud == 0) PlayerHud.StatusScreen = stick;
+                    else if (hud == 1) NanocomHud.MinimapScreen = stick;
+                    else NanocomHud.MissionScreen = stick;
+                    run(new[] { Finger(52, center, TouchPhase.Began) });
+                    run(new[] { Finger(52, deflected, TouchPhase.Moved) });
+                    Check(!TouchControls.CameraHeld && !TouchControls.JoystickHeld && Zero(TouchControls.Look)
+                        && !TouchControls.Held(ControlMap.K.Fire1),
+                        "A custom camera-stick position overlapping HUD surface " + hud + " must preserve HUD ownership.");
+                    PlayerHud.StatusScreen = NanocomHud.MinimapScreen = NanocomHud.MissionScreen = Rect.zero;
+                }
+
+                reset();
+                Vector2 free = new Vector2(area.x + area.width * .65f, height - (area.y + area.height * .45f));
+                run(new[] { Finger(53, free, TouchPhase.Began) });
+                run(new[] { Finger(53, free + Vector2.right * stick.width, TouchPhase.Moved) });
+                Check(TouchControls.CameraHeld && !Zero(TouchControls.Look) && !TouchControls.Held(ControlMap.K.Fire1),
+                    "The free camera area outside the stick must continue accepting ordinary right-thumb drags.");
+                process(Array.Empty<Touch>(), false, false);
+                Check(!TouchControls.Active && !TouchControls.CameraHeld && Zero(TouchControls.Look),
+                    "Leaving gameplay must cancel the camera-stick and free-drag roles.");
+                results.Add("PASS: camera-stick dead zone/curve, independent yaw/pitch speeds, three-second continuous holds at 30/60/120 Hz, both-thumb ownership, action crossing, release/cancel/lost finger/UI cancellation and free-drag fallback.");
+            }
+            finally
+            {
+                PlayerHud.StatusScreen = savedStatus; NanocomHud.MinimapScreen = savedMap; NanocomHud.MissionScreen = savedMission;
+                if (host != null)
+                {
+                    typeof(TouchControls).GetMethod("OnDestroy", HiddenInstance).Invoke(host.GetComponent<TouchControls>(), null);
+                    UnityEngine.Object.DestroyImmediate(host);
+                }
+            }
+        }
+
+        public static void Batch()
+        {
+            try { Run(); EditorApplication.Exit(0); }
+            catch (Exception error) { Debug.LogException(error); EditorApplication.Exit(1); }
+        }
+    }
+}
