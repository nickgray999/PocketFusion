@@ -0,0 +1,142 @@
+using System.Reflection;
+using System.Diagnostics;
+using OpenFusion;
+using OpenFusion.World;
+using UnityEngine;
+
+var font = BitmapFont.FromJson(File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "font.json")), new Texture2D(), false);
+var advance = typeof(BitmapFont).GetMethod("Adv", BindingFlags.Instance | BindingFlags.NonPublic).CreateDelegate<Func<char, float>>(font);
+var kern = typeof(BitmapFont).GetMethod("Kern", BindingFlags.Instance | BindingFlags.NonPublic).CreateDelegate<Func<char, char, float>>(font);
+var padding = new RectOffset { left = 3, right = 5, top = 2, bottom = 4 };
+var offset = new Vector2(9, 24);
+const float scale = 1.75f;
+var tint = new Color(.2f, .8f, .9f, .7f);
+var oldColor = new Color(.1f, .3f, .6f, .6f);
+int checks = 0;
+void Check(bool value, string issue) { checks++; if (!value) throw new Exception(issue); }
+
+// Freeze the previous client word-wrap and line-placement rules as the oracle.
+List<string> LegacyLines(string text, float maxWidth)
+{
+    text = (text ?? "").Replace("\r", "");
+    if (font.ConvertCase == 1) text = text.ToUpperInvariant();
+    if (font.ConvertCase == 2) text = text.ToLowerInvariant();
+    var lines = new List<string>();
+    foreach (string paragraph in text.Split('\n'))
+    {
+        if (maxWidth <= 0f) { lines.Add(paragraph); continue; }
+        string line = "";
+        foreach (var word in paragraph.Split(' '))
+        {
+            string joined = line.Length == 0 ? word : line + " " + word;
+            if (line.Length == 0 || font.Width(joined) <= maxWidth) line = joined;
+            else { lines.Add(line); line = word; }
+        }
+        lines.Add(line);
+    }
+    return lines;
+}
+void LegacyDraw(Rect rect, string text, TextAnchor anchor, bool wrap)
+{
+    if (string.IsNullOrEmpty(text)) return;
+    float cx = rect.x + padding.left, cy = rect.y + padding.top;
+    float cw = rect.width - padding.left - padding.right, ch = rect.height - padding.top - padding.bottom;
+    var lines = LegacyLines(Loc.T(text), wrap ? cw : 0);
+    float height = lines.Count * font.LineHeight;
+    int v = (int)anchor / 3, hz = (int)anchor % 3;
+    float top = v == 0 ? cy : v == 1 ? cy + (ch - height) * .5f : cy + ch - height;
+    var color = GUI.color;
+    GUI.color = new Color(tint.r, tint.g, tint.b, tint.a * color.a);
+    for (int row = 0; row < lines.Count; row++)
+    {
+        string line = lines[row];
+        float width = font.Width(line.TrimEnd(' '));
+        float pen = hz == 0 ? cx : hz == 1 ? cx + (cw - width) * .5f : cx + cw - width;
+        float y = top + row * font.LineHeight;
+        for (int i = 0; i < line.Length; i++)
+        {
+            char c = line[i];
+            if (font.Glyphs.TryGetValue(c, out var g) && g.HasQuad)
+            {
+                float gx = MathF.Floor(pen + g.X + .5f), gy = MathF.Floor(y + g.Y + .5f);
+                var dst = new Rect(offset.x + (gx - offset.x) * scale, offset.y + (gy - offset.y) * scale, g.W * scale, g.H * scale);
+                var uv = font.AtlasUpsideDown ? new Rect(g.U, 1f - g.V, g.UW, -g.VH) : new Rect(g.U, g.V, g.UW, g.VH);
+                GUI.DrawTextureWithTexCoords(dst, font.Atlas, uv, true);
+            }
+            pen += advance(c);
+            if (i + 1 < line.Length) pen += kern(c, line[i + 1]);
+        }
+    }
+    GUI.color = color;
+}
+
+var samples = new List<string> { null, "", " ", "  ", "  foo   b ", "\nA\n", " A  B  \n\n  C ", "ß\té\r\nÅA𐐨", "AV AV", "translated", "hold LOOK to turn", new string('S', 160) };
+var random = new Random(4501);
+const string alphabet = " AV  y\t\r\n\nXF!";
+for (int i = 0; i < 80; i++) samples.Add(string.Concat(Enumerable.Range(0, random.Next(42)).Select(_ => alphabet[random.Next(alphabet.Length)])));
+GUI.color = oldColor;
+foreach (int convertCase in new[] { 0, 1, 2, 1 })
+{
+    font.ConvertCase = convertCase;
+    foreach (string s in samples)
+    foreach (float width in new[] { -2f, 0f, .01f, font.Width("A V"), 75.5f, float.PositiveInfinity, float.NaN })
+    {
+        var expected = LegacyLines(s, width);
+        Check(expected.SequenceEqual(font.Lines(s, width)), "Line break mismatch: '" + s + "' width=" + width);
+        Check(font.Height(s, width) == expected.Count * font.LineHeight, "height");
+        Check(font.MaxLineWidth(s) == LegacyLines(s, 0).Max(font.Width), "untrimmed width");
+        var rect = new Rect(35f, 1479f, width + padding.left + padding.right, 108f);
+        if (!float.IsFinite(width)) continue;
+        foreach (var anchor in Enum.GetValues<TextAnchor>())
+        {
+            font.AtlasUpsideDown = ((int)anchor % 2) == 0;
+            GUI.Quads.Clear();
+            LegacyDraw(rect, s, anchor, true);
+            var reference = GUI.Quads.ToArray();
+            GUI.Quads.Clear();
+            font.Draw(rect, s, anchor, true, tint, padding, offset, scale);
+            Check(reference.SequenceEqual(GUI.Quads) && GUI.color == oldColor, "glyph positions/UV/color differ");
+        }
+    }
+}
+font.ConvertCase = 1;
+var glyph = font.Glyphs['A']; glyph.Advance += 12;
+font.Glyphs['A'] = glyph; font.KerningScale = .82f; font.LineHeight += 3;
+Check(font.Height("AV AV", 40) == LegacyLines("AV AV", 40).Count * font.LineHeight, "mutated font metrics");
+font.Lines("MAP", 0).Clear();
+Check(font.Lines("MAP", 0).Count == 1, "public Lines returned shared mutable storage");
+for (int i = 0; i < 500; i++) font.Convert("name" + i);
+var retained = (Dictionary<string,string>)typeof(BitmapFont).GetField("normalized", BindingFlags.Instance | BindingFlags.NonPublic).GetValue(font);
+Check(retained.Count <= 64 && retained.Keys.All(s => s.Length <= 128), "conversion cache grew beyond its bounds");
+string[] hud = { "CHAT", "BAG", "MISSIONS", "MAP", "MENU", "Samurai Jack", "Forsaken Valley", "32", "0004", "Nearby Player", "Talk to Samurai Jack\nin Forsaken Valley." };
+var sampleRect = new Rect(45, 1810, 140, 68);
+(long bytes, double milliseconds, int quads) Measure(bool legacy)
+{
+    int run(int frames)
+    {
+        int quads = 0;
+        for (int i = 0; i < frames; i++)
+        {
+            GUI.Quads.Clear();
+            foreach (string label in hud)
+            {
+                if (legacy) LegacyDraw(sampleRect, label, TextAnchor.MiddleCenter, true);
+                else font.Draw(sampleRect, label, TextAnchor.MiddleCenter, true, tint, padding, offset, scale);
+            }
+            quads += GUI.Quads.Count;
+        }
+        return quads;
+    }
+    run(1000);
+    var timer = Stopwatch.StartNew();
+    long start = GC.GetAllocatedBytesForCurrentThread();
+    int quads = run(10000);
+    long bytes = GC.GetAllocatedBytesForCurrentThread() - start;
+    return (bytes, timer.Elapsed.TotalMilliseconds, quads);
+}
+var before = Measure(true); var after = Measure(false);
+Check(before.quads == after.quads && after.quads > 0, "benchmark draw count");
+Check(before.bytes > 0 && after.bytes == 0, "warmed HUD draw allocated managed memory");
+Console.WriteLine($"PASS: {checks:N0} checks of wrapping, widths, heights, glyph placement, UVs, tint, mutable metrics and bounded storage.");
+Console.WriteLine($"10,000 warmed HUD passes × {hud.Length} labels, {after.quads:N0} matching glyph quads: {before.bytes:N0} → {after.bytes:N0} managed bytes ({before.bytes / 10000.0:F1} → {after.bytes / 10000.0:F1} per pass).");
+Console.WriteLine($".NET 8 elapsed time (stub draw sink, no GPU): {before.milliseconds:F1} → {after.milliseconds:F1} ms.");
