diff --git a/Assets/Editor/IOSPlist.cs b/Assets/Editor/IOSPlist.cs
new file mode 100644
index 0000000..23db00e
--- /dev/null
+++ b/Assets/Editor/IOSPlist.cs
@@ -0,0 +1,141 @@
+using System;
+using System.IO;
+using System.Xml;
+
+namespace OpenFusion.EditorTools
+{
+    // No Unity platform extension dependency: this can also be fixture-tested
+    // without an iOS or Android build module installed in the Editor.
+    public static class IOSPlist
+    {
+        public static readonly string[] HttpAssetHosts = { "cdn.ffretrobution.net" };
+
+        // IOSSceneLifecycle supplies both native integration and this metadata
+        // for the pinned player. A plist entry alone cannot repair an old player.
+        public static void VerifyGeneratedSceneManifest(string path)
+        {
+            var doc = new XmlDocument { XmlResolver = null }; doc.Load(path);
+            var root = doc.SelectSingleNode("/plist/dict") as XmlElement;
+            var manifest = root != null ? Find(root, "UIApplicationSceneManifest") : null;
+            if (manifest == null || manifest.Name != "dict")
+                throw new InvalidDataException("Exported Info.plist is missing UIApplicationSceneManifest. Re-export with the project's iPhone exporter; adding scene entries manually does not implement the native UIScene lifecycle.");
+            var multiple = Find(manifest, "UIApplicationSupportsMultipleScenes");
+            var configurations = Find(manifest, "UISceneConfigurations");
+            var roles = configurations != null && configurations.Name == "dict" ? Find(configurations, "UIWindowSceneSessionRoleApplication") : null;
+            var scene = roles != null && roles.Name == "array" ? roles.SelectSingleNode("*[1]") as XmlElement : null;
+            var name = scene != null && scene.Name == "dict" ? Find(scene, "UISceneConfigurationName") : null;
+            var sceneDelegate = scene != null && scene.Name == "dict" ? Find(scene, "UISceneDelegateClassName") : null;
+            if (multiple == null || (multiple.Name != "false" && multiple.Name != "true") ||
+                name == null || name.Name != "string" || string.IsNullOrWhiteSpace(name.InnerText) ||
+                sceneDelegate == null || sceneDelegate.Name != "string" || string.IsNullOrWhiteSpace(sceneDelegate.InnerText))
+                throw new InvalidDataException("Exported Info.plist is missing the default application scene configuration or delegate. Re-export with the project's iPhone exporter and preserve its scene metadata.");
+        }
+
+        public static void Configure(string path)
+        {
+            if (!File.Exists(path)) throw new FileNotFoundException("Xcode export did not contain Info.plist.", path);
+            var doc = new XmlDocument { XmlResolver = null };
+            doc.Load(path);
+            var root = doc.SelectSingleNode("/plist/dict") as XmlElement;
+            if (root == null) throw new InvalidDataException("Expected a plist dictionary at " + path);
+            Set(root, "CFBundleDisplayName", "string", "PocketFusion");
+            Set(root, "CFBundleName", "string", "PocketFusion");
+
+            // Preserve the complete UIApplicationSceneManifest and delegate
+            // configuration; IOSSceneLifecycle owns native lifecycle setup.
+            var types = DictionaryValue(root, "CFBundleURLTypes", "array");
+            bool hasScheme = false;
+            foreach (XmlNode item in types.ChildNodes)
+                if (item is XmlElement type && type.Name == "dict")
+                {
+                    var schemes = Find(type, "CFBundleURLSchemes");
+                    if (schemes == null || schemes.Name != "array") continue;
+                    foreach (XmlNode scheme in schemes.ChildNodes)
+                        if (scheme.Name == "string" && string.Equals(scheme.InnerText, "ofl", StringComparison.OrdinalIgnoreCase)) hasScheme = true;
+                }
+            if (!hasScheme)
+            {
+                var type = doc.CreateElement("dict"); types.AppendChild(type);
+                Set(type, "CFBundleURLName", "string", "OpenFusion server link");
+                Set(type, "CFBundleTypeRole", "string", "Viewer");
+                var schemes = DictionaryValue(type, "CFBundleURLSchemes", "array");
+                var scheme = doc.CreateElement("string"); scheme.InnerText = "ofl"; schemes.AppendChild(scheme);
+            }
+
+            var ats = DictionaryValue(root, "NSAppTransportSecurity", "dict");
+            Set(ats, "NSAllowsArbitraryLoads", "false");
+            Remove(ats, "NSAllowsArbitraryLoadsInWebContent");
+            Remove(ats, "NSAllowsArbitraryLoadsForMedia");
+            Remove(ats, "NSAllowsLocalNetworking");
+            // Do not inherit a blanket/subdomain exception from an earlier export.
+            var domains = DictionaryValue(ats, "NSExceptionDomains", "dict"); domains.RemoveAll();
+            foreach (string host in HttpAssetHosts)
+            {
+                var domain = DictionaryValue(domains, host, "dict");
+                Set(domain, "NSExceptionAllowsInsecureHTTPLoads", "true");
+                Set(domain, "NSIncludesSubdomains", "false");
+            }
+            Set(root, "UIStatusBarHidden", "true");
+            // Opt into the Duo's real scene bounds instead of the compatibility
+            // canvas that scales a landscape-only app across the inner display.
+            // Unity still starts with landscape autorotation on ordinary phones;
+            // the fold controller permits portrait only for a verified inner display.
+            Set(root, "UIRequiresFullScreen", "false");
+            var orientations = DictionaryValue(root, "UISupportedInterfaceOrientations", "array"); orientations.RemoveAll();
+            foreach (string value in new[] { "UIInterfaceOrientationLandscapeLeft", "UIInterfaceOrientationLandscapeRight", "UIInterfaceOrientationPortrait", "UIInterfaceOrientationPortraitUpsideDown" })
+            {
+                var orientation = doc.CreateElement("string"); orientation.InnerText = value; orientations.AppendChild(orientation);
+            }
+            // The launcher/game use sockets for OpenFusion traffic. This text is
+            // shown only when iOS requests local network access for a local server.
+            Set(root, "NSLocalNetworkUsageDescription", "string", "Connect to an OpenFusion game server on your local network when you choose one.");
+            // XmlDocument can save an empty DTD subset as "[]", which Apple's
+            // plist parser rejects. A plist does not require the optional DTD.
+            if (doc.DocumentType != null) doc.RemoveChild(doc.DocumentType);
+            doc.Save(path);
+        }
+
+        static XmlElement Find(XmlElement dict, string name)
+        {
+            foreach (XmlNode node in dict.ChildNodes)
+                if (node.Name == "key" && node.InnerText == name)
+                {
+                    var value = node.NextSibling;
+                    while (value != null && !(value is XmlElement)) value = value.NextSibling;
+                    return value as XmlElement;
+                }
+            return null;
+        }
+
+        static XmlElement DictionaryValue(XmlElement dict, string key, string type)
+        {
+            var value = Find(dict, key);
+            return value != null && value.Name == type ? value : Set(dict, key, type);
+        }
+
+        static XmlElement Set(XmlElement dict, string key, string type, string text = null)
+        {
+            var doc = dict.OwnerDocument;
+            var old = Find(dict, key);
+            var value = doc.CreateElement(type);
+            if (text != null) value.InnerText = text;
+            if (old != null) dict.ReplaceChild(value, old);
+            else
+            {
+                var name = doc.CreateElement("key"); name.InnerText = key;
+                dict.AppendChild(name); dict.AppendChild(value);
+            }
+            return value;
+        }
+
+        static void Remove(XmlElement dict, string name)
+        {
+            var value = Find(dict, name);
+            if (value == null) return;
+            var key = value.PreviousSibling;
+            while (key != null && !(key is XmlElement)) key = key.PreviousSibling;
+            dict.RemoveChild(value);
+            if (key != null) dict.RemoveChild(key);
+        }
+    }
+}
