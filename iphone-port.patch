diff --git a/Assets/Editor/IOSEfficiencyChecks.cs b/Assets/Editor/IOSEfficiencyChecks.cs
new file mode 100644
index 0000000..ae8a858
--- /dev/null
+++ b/Assets/Editor/IOSEfficiencyChecks.cs
@@ -0,0 +1,242 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using OpenFusion.World;
+using UnityEditor;
+using UnityEngine;
+
+namespace OpenFusion.EditorTools
+{
+    public static class IOSEfficiencyChecks
+    {
+        const BindingFlags HiddenInstance = BindingFlags.Instance | BindingFlags.NonPublic;
+        static Touch Finger(int id, Vector2 position, TouchPhase phase)
+            => new Touch { fingerId = id, position = position, phase = phase };
+
+        static void CheckBufferPrefixes(TouchControls controls, Action<Touch[], int, bool, bool> process,
+            Vector2 left, Vector2 right, float height, List<string> results)
+        {
+            int assertions = 0;
+            void Check(bool condition, string message)
+            {
+                assertions++;
+                if (!condition) throw new InvalidOperationException("Reused touch buffer: " + message);
+            }
+            bool Zero(Vector2 value) => value.sqrMagnitude < .000001f;
+            controls.CancelForSurfaceChange();
+            TouchLayout.Enable(0, true);
+            var attack = controls.LayoutRect(0).center; attack.y = height - attack.y;
+            var leftMoved = left + Vector2.up * controls.LayoutRect(TouchLayout.Joystick).width * .3f;
+            var rightMoved = right + Vector2.right * 40f;
+            var buffer = new Touch[10];
+
+            buffer[0] = Finger(101, left, TouchPhase.Began);
+            buffer[1] = Finger(102, right, TouchPhase.Began);
+            buffer[2] = Finger(103, attack, TouchPhase.Began);
+            process(buffer, 3, true, false);
+            buffer[0] = Finger(101, leftMoved, TouchPhase.Moved);
+            buffer[1] = Finger(102, rightMoved, TouchPhase.Moved);
+            buffer[2] = Finger(103, attack, TouchPhase.Stationary);
+            process(buffer, 3, true, false);
+            Check(TouchControls.JoystickHeld && TouchControls.Move.y > .15f && TouchControls.CameraHeld
+                && TouchControls.Look.x > 0f && TouchControls.Held(ControlMap.K.Fire1),
+                "Three live prefix fingers must establish movement, drag and attack.");
+            int firstGesture = TouchControls.JoystickGestureId;
+
+            // The old drag/action entries remain unchanged after count shrinks.
+            buffer[0] = Finger(101, leftMoved, TouchPhase.Stationary);
+            process(buffer, 1, true, false);
+            Check(TouchControls.JoystickHeld && TouchControls.JoystickGestureId == firstGesture && TouchControls.Move.y > .15f,
+                "Shrinking the prefix must preserve its live movement finger.");
+            Check(!TouchControls.CameraHeld && Zero(TouchControls.Look) && TouchControls.Pinch == 0f,
+                "A stale tail must neither retain drag ownership nor replay its look delta.");
+            Check(!TouchControls.Held(ControlMap.K.Fire1) && TouchControls.Up(ControlMap.K.Fire1)
+                && !TouchControls.Down(ControlMap.K.Fire1), "A lost tail action must release exactly as a missing touch.");
+
+            buffer[1] = Finger(102, right, TouchPhase.Began);
+            buffer[2] = Finger(103, attack, TouchPhase.Began);
+            process(buffer, 1, true, false);
+            Check(!TouchControls.CameraHeld && Zero(TouchControls.Look) && TouchControls.Pinch == 0f
+                && !TouchControls.Held(ControlMap.K.Fire1) && !TouchControls.Down(ControlMap.K.Fire1)
+                && !TouchControls.Up(ControlMap.K.Fire1), "Poisoned Began entries outside the prefix must not acquire roles or replay action edges.");
+            process(buffer, 0, true, false);
+            Check(!TouchControls.JoystickHeld && !TouchControls.CameraHeld && Zero(TouchControls.Move)
+                && Zero(TouchControls.Look) && TouchControls.Pinch == 0f && !TouchControls.TryTap(out _),
+                "An empty prefix must release movement and camera without a tap despite populated storage.");
+            buffer[0] = Finger(101, leftMoved, TouchPhase.Stationary);
+            process(buffer, 1, true, false);
+            Check(!TouchControls.JoystickHeld && Zero(TouchControls.Move), "A lost finger must not reacquire movement from Stationary.");
+            buffer[0] = Finger(101, left, TouchPhase.Began);
+            process(buffer, 1, true, false);
+            Check(TouchControls.JoystickHeld && TouchControls.JoystickGestureId != firstGesture,
+                "A reused finger ID must acquire a new gesture only after Began.");
+
+            // Unity may compact a surviving finger into the first buffer slot.
+            controls.CancelForSurfaceChange();
+            buffer[0] = Finger(201, left, TouchPhase.Began);
+            buffer[1] = Finger(202, right, TouchPhase.Began);
+            buffer[2] = Finger(203, attack, TouchPhase.Began);
+            process(buffer, 3, true, false);
+            buffer[0] = Finger(202, rightMoved, TouchPhase.Moved);
+            buffer[1] = Finger(201, leftMoved, TouchPhase.Moved);
+            process(buffer, 1, true, false);
+            Check(!TouchControls.JoystickHeld && Zero(TouchControls.Move) && TouchControls.CameraHeld && TouchControls.Look.x > 0f,
+                "Compacted prefixes must follow finger IDs, retaining the camera and releasing missing movement.");
+            Check(!TouchControls.Held(ControlMap.K.Fire1) && TouchControls.Up(ControlMap.K.Fire1),
+                "A compacted prefix must release a missing action even when its old slot still contains Began.");
+            buffer[0] = Finger(202, rightMoved, TouchPhase.Stationary);
+            process(buffer, 1, true, false);
+            Check(TouchControls.CameraHeld && Zero(TouchControls.Look) && !TouchControls.Up(ControlMap.K.Fire1),
+                "The surviving stationary camera must not repeat its prior delta or the action-release edge.");
+
+            controls.CancelForSurfaceChange();
+            buffer[0] = Finger(301, right, TouchPhase.Began);
+            buffer[1] = Finger(302, right + Vector2.right * 30f, TouchPhase.Began);
+            process(buffer, 2, true, false);
+            buffer[0] = Finger(301, right - Vector2.right * 20f, TouchPhase.Moved);
+            buffer[1] = Finger(302, right + Vector2.right * 60f, TouchPhase.Moved);
+            process(buffer, 2, true, false);
+            Check(TouchControls.Pinch > 0f && Zero(TouchControls.Look), "Two live look fingers must still produce pinch.");
+            buffer[0] = Finger(301, buffer[0].position, TouchPhase.Stationary);
+            process(buffer, 1, true, false);
+            Check(TouchControls.CameraHeld && TouchControls.Pinch == 0f && Zero(TouchControls.Look),
+                "Dropping a stale second look finger must end pinch without replaying its movement.");
+
+            controls.CancelForSurfaceChange(); TouchLayout.CameraStickEnabled = true;
+            var stick = controls.LayoutRect(TouchLayout.CameraStick).center; stick.y = height - stick.y;
+            buffer[0] = Finger(401, left, TouchPhase.Began);
+            buffer[1] = Finger(402, stick, TouchPhase.Began);
+            process(buffer, 2, true, false);
+            Check(TouchControls.JoystickHeld && TouchControls.CameraHeld, "The live prefix must also preserve independent joystick and LOOK-stick ownership.");
+            buffer[0] = Finger(401, leftMoved, TouchPhase.Moved);
+            buffer[1] = Finger(402, stick + Vector2.right * 30f, TouchPhase.Moved);
+            process(buffer, 1, true, false);
+            Check(TouchControls.JoystickHeld && !TouchControls.CameraHeld && Zero(TouchControls.Look) && TouchControls.Pinch == 0f,
+                "A stale LOOK-stick tail must not keep turning while movement survives.");
+
+            controls.CancelForSurfaceChange();
+            buffer[0] = Finger(501, attack, TouchPhase.Began);
+            process(buffer, 1, true, false);
+            Check(TouchControls.Held(ControlMap.K.Fire1) && TouchControls.Down(ControlMap.K.Fire1), "A live action prefix must still acquire its action edge.");
+            process(buffer, 0, true, false);
+            Check(!TouchControls.Held(ControlMap.K.Fire1) && TouchControls.Up(ControlMap.K.Fire1)
+                && !TouchControls.Down(ControlMap.K.Fire1) && !TouchControls.TryTap(out _),
+                "Zero count must release a stale Began action without reacquiring or tapping.");
+            process(buffer, 0, true, false);
+            Check(!TouchControls.Up(ControlMap.K.Fire1) && !TouchControls.Down(ControlMap.K.Fire1)
+                && !TouchControls.CameraHeld && !TouchControls.JoystickHeld && Zero(TouchControls.Move)
+                && Zero(TouchControls.Look) && TouchControls.Pinch == 0f,
+                "Repeated empty prefixes must remain neutral, including one-frame action edges.");
+            controls.CancelForSurfaceChange(); TouchLayout.CameraStickEnabled = false; TouchLayout.Enable(0, false);
+            results.Add("PASS reused capture prefix: " + assertions + " assertions against production count-aware frame processing.");
+        }
+
+        public static void Run(bool requireAllocationFree)
+        {
+            if (TouchControls.Instance != null) throw new InvalidOperationException("Run without a live touch controller.");
+            var results = new List<string> { "UTC " + DateTime.UtcNow.ToString("O") };
+            string layout = TouchLayout.Snapshot();
+            Rect status = PlayerHud.StatusScreen, map = NanocomHud.MinimapScreen, mission = NanocomHud.MissionScreen;
+            GameObject host = null;
+            try
+            {
+                TouchLayout.Reset(); TouchLayout.CameraStickEnabled = false;
+                for (int i = 0; i < TouchLayout.Actions.Length; i++) TouchLayout.Enable(i, false);
+                PlayerHud.StatusScreen = NanocomHud.MinimapScreen = NanocomHud.MissionScreen = Rect.zero;
+                host = new GameObject("iOS input allocation check");
+                var controls = host.AddComponent<TouchControls>();
+                if (TouchControls.Instance == null) typeof(TouchControls).GetMethod("Awake", HiddenInstance).Invoke(controls, null);
+                var method = typeof(TouchControls).GetMethod("ProcessTouchFrame", HiddenInstance);
+                var process = (Action<Touch[], int, bool, bool>)Delegate.CreateDelegate(typeof(Action<Touch[], int, bool, bool>), controls, method);
+                float height = Screen.height > 0 ? Screen.height : 720f;
+                var area = TouchControls.LayoutArea;
+                Vector2 left = new Vector2(area.x + area.width * .25f, height - area.y - area.height * .65f);
+                Vector2 right = new Vector2(area.x + area.width * .7f, height - area.y - area.height * .45f);
+                CheckBufferPrefixes(controls, process, left, right, height, results);
+                var began = new[] { Finger(1, left, TouchPhase.Began), Finger(2, right, TouchPhase.Began) };
+                var moved = new[] { Finger(1, left + Vector2.up * 30f, TouchPhase.Moved), Finger(2, right + Vector2.right * 30f, TouchPhase.Moved) };
+                var held = new[] { Finger(1, moved[0].position, TouchPhase.Stationary), Finger(2, moved[1].position, TouchPhase.Stationary) };
+                var empty = Array.Empty<Touch>();
+                bool allocationCounterAvailable = false;
+                try
+                {
+                    long beforeProbe = GC.GetAllocatedBytesForCurrentThread();
+                    var probe = new byte[4096];
+                    GC.KeepAlive(probe);
+                    long probeBytes = GC.GetAllocatedBytesForCurrentThread() - beforeProbe;
+                    allocationCounterAvailable = probeBytes >= 4096;
+                    results.Add(allocationCounterAvailable
+                        ? "Managed allocation counter sanity probe PASS: " + probeBytes + " bytes for a retained 4096-byte allocation."
+                        : "Managed allocation counter UNAVAILABLE: retained 4096-byte sanity allocation reported " + probeBytes + " bytes. No allocation-free claim can be made in this Editor runtime.");
+                }
+                catch (NotSupportedException error)
+                {
+                    results.Add("Managed allocation counter UNAVAILABLE: " + error.Message);
+                }
+                catch (NotImplementedException error)
+                {
+                    results.Add("Managed allocation counter UNAVAILABLE: " + error.Message);
+                }
+                if (requireAllocationFree && !allocationCounterAvailable)
+                    throw new InvalidOperationException("Cannot enforce allocation-free input: this Editor's managed allocation counter failed its sanity probe.");
+                void Measure(string name, Touch[] frame)
+                {
+                    const int frames = 1024;
+                    for (int i = 0; i < 128; i++) process(frame, frame.Length, true, false);
+                    long before = allocationCounterAvailable ? GC.GetAllocatedBytesForCurrentThread() : 0;
+                    for (int i = 0; i < frames; i++) process(frame, frame.Length, true, false);
+                    if (allocationCounterAvailable)
+                    {
+                        long bytes = GC.GetAllocatedBytesForCurrentThread() - before;
+                        results.Add(name + ": frames=" + frames + " managedBytes=" + bytes + " bytesPerFrame=" + (bytes / (double)frames).ToString("F2"));
+                        if (requireAllocationFree && bytes != 0) throw new InvalidOperationException(name + " still allocates " + bytes + " bytes after warmup.");
+                    }
+                    else results.Add(name + ": frames=" + frames + " managedBytes=UNAVAILABLE (counter failed sanity probe).");
+                }
+                Measure("idle touch state", empty);
+                process(began, began.Length, true, false); process(moved, moved.Length, true, false);
+                Measure("held movement plus camera drag", held);
+                if (!TouchControls.JoystickHeld || !TouchControls.CameraHeld || TouchControls.Move.y <= .15f || TouchControls.Pinch != 0f)
+                    throw new InvalidOperationException("Warmed touch fixture lost independent movement/camera ownership.");
+                process(empty, empty.Length, true, false);
+                var pinch = new[] { Finger(2, right, TouchPhase.Began), Finger(3, right + Vector2.right * 30f, TouchPhase.Began) };
+                process(pinch, pinch.Length, true, false);
+                pinch[0] = Finger(2, right, TouchPhase.Stationary); pinch[1] = Finger(3, right + Vector2.right * 30f, TouchPhase.Stationary);
+                Measure("held pinch", pinch);
+                process(empty, empty.Length, true, false);
+                TouchLayout.Enable(0, true);
+                var action = controls.LayoutRect(0).center; action.y = height - action.y;
+                var actionFrame = new[] { Finger(4, action, TouchPhase.Began) };
+                process(actionFrame, actionFrame.Length, true, false); actionFrame[0] = Finger(4, action, TouchPhase.Stationary);
+                Measure("held attack action", actionFrame);
+                if (!TouchControls.Held(ControlMap.K.Fire1)) throw new InvalidOperationException("Held-action benchmark must retain attack ownership.");
+                results.Add("PASS production input state remained intact. Allocation figures, when available, are Editor-only; phone frame time, memory pressure and thermals require device testing.");
+                Debug.Log("[iOS efficiency] " + string.Join("\n", results));
+            }
+            catch (Exception error) { results.Add("FAIL " + error); throw; }
+            finally
+            {
+                if (host != null)
+                {
+                    typeof(TouchControls).GetMethod("OnDestroy", HiddenInstance).Invoke(host.GetComponent<TouchControls>(), null);
+                    UnityEngine.Object.DestroyImmediate(host);
+                }
+                TouchLayout.Restore(layout);
+                PlayerHud.StatusScreen = status; NanocomHud.MinimapScreen = map; NanocomHud.MissionScreen = mission;
+                Directory.CreateDirectory("Logs"); File.WriteAllLines("Logs/ios-efficiency-results.txt", results);
+            }
+        }
+
+        public static void Batch()
+        {
+            try
+            {
+                IOSInputChecks.Run(); IOSThirdPersonChecks.Run();
+                Run(Array.IndexOf(Environment.GetCommandLineArgs(), "-requireAllocationFree") >= 0);
+                EditorApplication.Exit(0);
+            }
+            catch (Exception error) { Debug.LogException(error); EditorApplication.Exit(1); }
+        }
+    }
+}
