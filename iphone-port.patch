diff --git a/Assets/Editor/IOSBuild.cs b/Assets/Editor/IOSBuild.cs
new file mode 100644
index 0000000..178e147
--- /dev/null
+++ b/Assets/Editor/IOSBuild.cs
@@ -0,0 +1,128 @@
+using System;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEditor.Build;
+using UnityEditor.Build.Reporting;
+using UnityEngine;
+using UnityEngine.Rendering;
+
+namespace OpenFusion.EditorTools
+{
+    /// <summary>Exports source for Xcode. Signing and installation happen in Xcode.</summary>
+    public static class IOSBuild
+    {
+        public const string DefaultOutput = "Builds/iOS";
+
+        [MenuItem("OpenFusion/iPhone/1 Configure iPhone")]
+        public static void ConfigurePlayer()
+        {
+            var target = NamedBuildTarget.iOS;
+            // Preserve an identifier chosen for the developer's own signing team.
+            string identifier = PlayerSettings.GetApplicationIdentifier(target);
+            if (string.IsNullOrEmpty(identifier) || identifier == "com.Company.ProductName")
+                identifier = "com.openfusion.pocket.ios";
+            ProjectSetup.ConfigureCommonPlayer();
+            PlayerSettings.productName = "PocketFusion";
+            // Persist even an automatically generated identifier before renaming.
+            // iOS keys the existing cache and Keychain access to this identity.
+            PlayerSettings.SetApplicationIdentifier(target, identifier);
+            PlayerSettings.SetScriptingBackend(target, ScriptingImplementation.IL2CPP);
+            PlayerSettings.SetManagedStrippingLevel(target, ManagedStrippingLevel.Low);
+            PlayerSettings.SetArchitecture(target, 1); // Unity 2022.3: ARM64.
+            PlayerSettings.SetIl2CppCodeGeneration(target, Il2CppCodeGeneration.OptimizeSpeed);
+            PlayerSettings.iOS.sdkVersion = iOSSdkVersion.DeviceSDK;
+            PlayerSettings.iOS.targetDevice = iOSTargetDevice.iPhoneOnly;
+            PlayerSettings.iOS.targetOSVersionString = "15.0";
+            PlayerSettings.iOS.buildNumber = OpenFusion.Api.PocketRelease.BuildCode.ToString(CultureInfo.InvariantCulture);
+            PlayerSettings.SetUseDefaultGraphicsAPIs(BuildTarget.iOS, false);
+            PlayerSettings.SetGraphicsAPIs(BuildTarget.iOS, new[] { GraphicsDeviceType.Metal });
+            // Unity's switch cannot express per-host exceptions. The postprocessor
+            // removes the blanket ATS bypass and permits only the known asset CDN.
+            PlayerSettings.insecureHttpOption = InsecureHttpOption.AlwaysAllowed;
+            var icon = PlayerSettings.GetIconsForTargetGroup(BuildTargetGroup.Unknown, IconKind.Any).FirstOrDefault();
+            int count = PlayerSettings.GetIconSizesForTargetGroup(BuildTargetGroup.iOS, IconKind.Application).Length;
+            if (icon != null && count > 0)
+                PlayerSettings.SetIconsForTargetGroup(BuildTargetGroup.iOS, Enumerable.Repeat(icon, count).ToArray(), IconKind.Application);
+            AssetDatabase.SaveAssets();
+            Debug.Log("OpenFusion: iPhone, iOS 15+, ARM64 IL2CPP, Metal, landscape. Choose your signing team in Xcode after export.");
+        }
+
+        [MenuItem("OpenFusion/iPhone/2 Export Xcode project")]
+        public static void ExportMenu()
+        {
+            if (Build(false, DefaultOutput)) EditorUtility.RevealInFinder(Path.GetFullPath(DefaultOutput));
+        }
+
+        // Unity -batchmode -buildTarget iOS -executeMethod OpenFusion.EditorTools.IOSBuild.Batch
+        // Optional: -iosOutput /absolute/output/directory -iosDevelopment
+        public static void Batch()
+        {
+            bool ok = false;
+            try
+            {
+                string[] args = Environment.GetCommandLineArgs();
+                string output = DefaultOutput;
+                int index = Array.IndexOf(args, "-iosOutput");
+                if (index >= 0)
+                {
+                    if (index + 1 >= args.Length || args[index + 1].StartsWith("-", StringComparison.Ordinal))
+                        throw new ArgumentException("-iosOutput requires an output directory.");
+                    output = args[index + 1];
+                }
+                ok = Build(args.Contains("-iosDevelopment"), output);
+            }
+            catch (Exception e) { Debug.LogException(e); }
+            EditorApplication.Exit(ok ? 0 : 1);
+        }
+
+        public static bool Build(bool development, string output)
+        {
+            if (!BuildPipeline.IsBuildTargetSupported(BuildTargetGroup.iOS, BuildTarget.iOS))
+                throw new BuildFailedException("Install iOS Build Support for Unity " + Application.unityVersion + " in Unity Hub before exporting.");
+            if (EditorUserBuildSettings.activeBuildTarget != BuildTarget.iOS)
+                throw new BuildFailedException("Switch to iOS in File > Build Settings first. For batch builds, pass -buildTarget iOS.");
+            output = IOSExportPath.Validate(Path.GetDirectoryName(Application.dataPath), output);
+            ConfigurePlayer();
+            IOSRenderResources.Ensure();
+            ProjectSetup.ConfigureRenderPipeline();
+            ProjectSetup.ConfigureShaders();
+            ProjectSetup.CreateScenes();
+            string[] scenes = EditorBuildSettings.scenes.Where(s => s.enabled && File.Exists(s.path)).Select(s => s.path).ToArray();
+            if (scenes.Length == 0) throw new BuildFailedException("No enabled startup scene is available.");
+            EditorUserBuildSettings.development = development;
+            EditorUserBuildSettings.allowDebugging = development;
+            // iOS selects native compiler optimization in the generated Xcode
+            // configuration. Use Release there for normal device builds.
+            Directory.CreateDirectory(output);
+            BuildReport report = BuildPipeline.BuildPlayer(new BuildPlayerOptions
+            {
+                scenes = scenes,
+                locationPathName = output,
+                target = BuildTarget.iOS,
+                targetGroup = BuildTargetGroup.iOS,
+                options = BuildOptions.CompressWithLz4 | (development ? BuildOptions.Development | BuildOptions.AllowDebugging : BuildOptions.None)
+            });
+            // Unity can omit the interface callback during a first batch export.
+            // Apply again after the completed export; both paths are idempotent.
+            if (report.summary.result == BuildResult.Succeeded)
+            {
+                VerifyTerrainPhysicsRegistration(output);
+                IOSXcodePostprocess.Apply(output);
+            }
+            Debug.Log("OpenFusion: Xcode export " + report.summary.result + ", " + report.summary.totalErrors + " errors → " + Path.GetFullPath(output));
+            return report.summary.result == BuildResult.Succeeded && report.summary.totalErrors == 0;
+        }
+
+        static void VerifyTerrainPhysicsRegistration(string output)
+        {
+            string registryPath = Path.Combine(output, "Il2CppOutputProject/Source/il2cppOutput/UnityClassRegistration.cpp");
+            if (!File.Exists(registryPath)) throw new BuildFailedException("The iPhone native class registry is missing; terrain collision could not be verified.");
+            string registry = File.ReadAllText(registryPath);
+            if (!registry.Contains("RegisterUnityClass<TerrainCollider>(") || !registry.Contains("RegisterModule_TerrainPhysics()"))
+                throw new BuildFailedException("The iPhone export stripped TerrainCollider or TerrainPhysics. Keep an explicit TerrainCollider construction path before installing.");
+            Debug.Log("OpenFusion: native TerrainCollider and TerrainPhysics registration verified.");
+        }
+    }
+}
