diff --git a/Assets/Editor/IOSRenderResources.cs b/Assets/Editor/IOSRenderResources.cs
new file mode 100644
index 0000000..e80193e
--- /dev/null
+++ b/Assets/Editor/IOSRenderResources.cs
@@ -0,0 +1,71 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using UnityEditor;
+using UnityEditor.Build;
+using PackageInfo = UnityEditor.PackageManager.PackageInfo;
+using UnityEngine;
+using UnityEngine.Rendering;
+using UnityEngine.Rendering.Universal;
+
+namespace OpenFusion.EditorTools
+{
+    public static class IOSRenderResources
+    {
+        const string PackagePath = "Packages/com.unity.render-pipelines.universal";
+
+        // A first package restore can leave shader/texture folders unregistered
+        // even though UPM has downloaded their files. Import missing resources
+        // before URP reloads renderer references or the player strips shaders.
+        public static void Ensure()
+        {
+            var package = PackageInfo.FindForAssetPath(PackagePath);
+            if (package == null) throw new BuildFailedException("Restore the pinned URP package before exporting iOS.");
+            int imported = ImportMissing(package.resolvedPath, "Shaders", new[] { ".shader", ".compute" });
+            imported += ImportMissing(package.resolvedPath, "Textures", new[] { ".png", ".tga", ".exr", ".asset" });
+            foreach (string shader in new[]
+            {
+                "Shaders/Utils/Blit.shader", "Shaders/Utils/CoreBlit.shader", "Shaders/Unlit.shader",
+                "Shaders/Terrain/TerrainLit.shader", "Shaders/Terrain/TerrainLitAdd.shader",
+                "Shaders/Terrain/TerrainLitBase.shader", "Shaders/Terrain/TerrainLitBasemapGen.shader"
+            })
+                if (AssetDatabase.LoadAssetAtPath<Shader>(PackagePath + "/" + shader) == null)
+                    throw new BuildFailedException("URP shader could not be imported: " + shader + ". Reimport or restore the URP package before exporting.");
+
+            foreach (string guid in AssetDatabase.FindAssets("t:UniversalRendererData", new[] { "Assets" }))
+            {
+                var renderer = AssetDatabase.LoadAssetAtPath<UniversalRendererData>(AssetDatabase.GUIDToAssetPath(guid));
+                if (renderer == null) continue;
+                var result = ResourceReloader.TryReloadAllNullIn(renderer, PackagePath);
+                if (result.assetDatabaseNotReady) throw new BuildFailedException("URP renderer resources are not ready. Finish importing packages before exporting.");
+                if (result.hasChange) EditorUtility.SetDirty(renderer);
+                if (renderer.postProcessData != null)
+                {
+                    var postProcess = ResourceReloader.TryReloadAllNullIn(renderer.postProcessData, PackagePath);
+                    if (postProcess.assetDatabaseNotReady) throw new BuildFailedException("URP post-processing resources are not ready.");
+                    if (postProcess.hasChange) EditorUtility.SetDirty(renderer.postProcessData);
+                }
+            }
+            AssetDatabase.SaveAssets();
+            Debug.Log("OpenFusion: URP renderer resources verified; " + imported + " missing package resources imported.");
+        }
+
+        static int ImportMissing(string resolvedPackagePath, string folder, string[] extensions)
+        {
+            string directory = Path.Combine(resolvedPackagePath, folder);
+            if (!Directory.Exists(directory)) throw new BuildFailedException("URP package resources are missing: " + folder);
+            var supported = new HashSet<string>(extensions, StringComparer.OrdinalIgnoreCase);
+            int count = 0;
+            foreach (string file in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
+            {
+                if (!supported.Contains(Path.GetExtension(file))) continue;
+                string relative = file.Substring(resolvedPackagePath.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar).Replace('\\', '/');
+                string asset = PackagePath + "/" + relative;
+                if (!string.IsNullOrEmpty(AssetDatabase.AssetPathToGUID(asset))) continue;
+                AssetDatabase.ImportAsset(asset, ImportAssetOptions.ForceSynchronousImport);
+                count++;
+            }
+            return count;
+        }
+    }
+}
