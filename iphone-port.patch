+                var matte = new Color(.075f, .105f, .13f, 1);
+                UiKit.Fill(new Rect(0, world.yMax, Screen.width, Screen.height - world.yMax), matte);
+                UiKit.Fill(new Rect(0, 0, Screen.width, world.yMin), matte);
+                UiKit.Fill(new Rect(0, world.yMin, world.xMin, world.height), matte);
+                UiKit.Fill(new Rect(world.xMax, world.yMin, Screen.width - world.xMax, world.height), matte);
+                if (!worldReady)
+                {
+                    UiKit.Fill(world, matte);
+                    var client = GameClient.FindSelf;
+                    bool preview = client != null &&
+                        (client.GetComponent<TutorialIntroScreen>()?.DrawFoldPreview(world) == true ||
+                         client.GetComponent<CharCreateScreen>()?.DrawFoldPreview(world) == true ||
+                         client.GetComponent<CharSelectScreen>()?.DrawFoldPreview(world) == true);
+                    if (!preview) UiKit.Img(world, UiKit.Tex("load"), ScaleMode.ScaleToFit);
+                }
+            }
+            finally { GUI.matrix = matrix; GUI.color = color; }
+        }
+        void OnApplicationPause(bool paused) { if (paused) { TouchControls.Instance?.CancelForSurfaceChange(); MobileHudDock.Instance?.CancelForSurfaceChange(); } }
+        void OnDisable()
+        {
+            RenderPipelineManager.endContextRendering -= RestoreGuiViewport;
+            RestoreCamera(); active = false; lastGuiViewport = default; lastControlState = -1;
+        }
+        void OnDestroy()
+        {
+            RestoreCamera(); if (Instance == this) Instance = null;
+            if (rotationSaved) { Screen.autorotateToPortrait = oldPortrait; Screen.autorotateToPortraitUpsideDown = oldUpsideDown; }
+        }
+    }
+}
