+++ b/tests/IOSSceneLifecycleTest/run.sh
@@ -0,0 +1,71 @@
+#!/bin/bash
+set -euo pipefail
+
+script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
+project_root="$(cd -- "$script_dir/../.." && pwd)"
+ios_module="${UNITY_IOS_MODULE:-/Applications/Unity/Hub/Editor/2022.3.62f3/PlaybackEngines/iOSSupport}"
+existing_export=""
+dotnet_exe="${DOTNET_EXE:-}"
+
+usage() {
+    cat <<'EOF'
+Usage: tests/IOSSceneLifecycleTest/run.sh [--ios-module PATH] [--export PATH] [--dotnet PATH]
+
+Checks an isolated copy of the installed Unity .62 iOS trampoline using its real
+PBXProject library. Optionally checks a copy of an existing .62 Xcode export too.
+The installed module and supplied export are read-only. No Unity/Xcode build runs.
+EOF
+}
+
+while (($#)); do
+    case "$1" in
+        --ios-module|--export|--dotnet)
+            if (($# < 2)); then usage >&2; exit 2; fi
+            case "$1" in
+                --ios-module) ios_module="$2" ;;
+                --export) existing_export="$2" ;;
+                --dotnet) dotnet_exe="$2" ;;
+            esac
+            shift 2 ;;
+        --help|-h) usage; exit 0 ;;
+        *) usage >&2; exit 2 ;;
+    esac
+done
+
+if [[ -z "$dotnet_exe" ]]; then
+    for candidate in "$project_root/.tools/dotnet/dotnet" "$project_root/../.tools/dotnet/dotnet"; do
+        if [[ -x "$candidate" ]]; then dotnet_exe="$candidate"; break; fi
+    done
+fi
+if [[ -z "$dotnet_exe" ]]; then dotnet_exe="$(command -v dotnet || true)"; fi
+if [[ ! -x "$dotnet_exe" ]]; then
+    echo "A local .NET 8 SDK is required. Set DOTNET_EXE or pass --dotnet." >&2
+    exit 2
+fi
+
+ios_module="$(cd -- "$ios_module" && pwd)"
+xcode_assembly="$ios_module/UnityEditor.iOS.Extensions.Xcode.dll"
+trampoline="$ios_module/Trampoline"
+if [[ ! -f "$xcode_assembly" || ! -f "$trampoline/Classes/UnityAppController.mm" || ! -f "$trampoline/Unity-iPhone.xcodeproj/project.pbxproj" ]]; then
+    echo "Expected the installed Unity 2022.3.62f3 iOS module, including its Xcode library and trampoline." >&2
+    exit 2
+fi
+if [[ -n "$existing_export" ]]; then existing_export="$(cd -- "$existing_export" && pwd)"; fi
+
+task_cli_home="$(mktemp -d "${TMPDIR:-/tmp}/openfusion-scene-dotnet.XXXXXX")"
+trap 'rm -rf -- "$task_cli_home"' EXIT
+export DOTNET_CLI_HOME="$task_cli_home"
+export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
+export DOTNET_CLI_TELEMETRY_OPTOUT=1
+export DOTNET_GENERATE_ASPNET_CERTIFICATE=false
+export DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=true
+
+cd -- "$project_root"
+run_fixture() {
+    echo "Checking isolated .62 scene fixture from: $1"
+    "$dotnet_exe" run --project "$script_dir/IOSSceneLifecycleTest.csproj" \
+        "-p:UnityIosXcodeAssembly=$xcode_assembly" \
+        -p:RestoreSources=/nonexistent -p:NuGetAudit=false -- "$1"
+}
+run_fixture "$trampoline"
+if [[ -n "$existing_export" ]]; then run_fixture "$existing_export"; fi
