@@ -0,0 +1,150 @@
+using System;
+using System.Reflection;
+using System.Threading.Tasks;
+using OpenFusion.Api;
+using OpenFusion.Screens;
+using UnityEngine;
+using UnityEngine.Networking;
+
+static class Program
+{
+    static void Require(bool condition, string message)
+    {
+        if (!condition) throw new Exception(message);
+    }
+
+    static async Task Main()
+    {
+        Application.platform = RuntimePlatform.IPhonePlayer;
+        var updater = new PocketUpdater();
+        typeof(PocketUpdater).GetMethod("Awake", BindingFlags.Instance | BindingFlags.NonPublic).Invoke(updater, null);
+        Require(!PocketUpdater.Supported, "iOS must not use the APK updater.");
+        Require(updater.Status.Contains("iPhone") && !updater.Status.Contains("up to date"), "iOS must explain how to update without claiming an Android version is current.");
+
+        // An Android release accidentally retained by another caller must not enable an iOS APK action.
+        typeof(PocketUpdater).GetProperty("Latest").SetValue(updater, new PocketRelease());
+        typeof(PocketUpdater).GetProperty("Ready").SetValue(updater, true);
+        Require(!updater.Available, "Android release metadata must never offer an iOS update.");
+        await updater.CheckAsync();
+        await updater.DownloadAsync();
+        updater.Install();
+        Require(UnityWebRequest.RequestCount == 0, "iOS update actions must not request Android metadata or APK files.");
+        Require(!updater.Checking && !updater.Downloading, "Unsupported update actions must not leave busy state.");
+        Require(updater.Status == PocketUpdater.UnsupportedStatus, "Unsupported update actions must keep the platform explanation.");
+
+        Application.platform = RuntimePlatform.OSXPlayer;
+        await updater.CheckAsync();
+        Require(UnityWebRequest.RequestCount == 0, "Desktop must not run the APK update flow.");
+        Require(!PocketPlatform.Available && PocketPlatform.NavigationHat() == 0, "Android hardware bridge must be unavailable outside Android.");
+        Require(!PocketPlatform.Save("", "secret") && PocketPlatform.Load("") == "", "Empty identities must not reach native credential storage.");
+
+#if UNITY_IOS
+        Application.platform = RuntimePlatform.IPhonePlayer;
+        Require(PocketPlatform.SupportsSavedPasswords, "An iOS player must expose Keychain password storage.");
+        // No Apple player library is loaded in this host-only harness. Native failures must fail closed.
+        Require(!PocketPlatform.Save("test-identity", "test-password"), "Unavailable Keychain bridge must not claim a successful save.");
+        Require(PocketPlatform.Load("test-identity") == "", "Unavailable Keychain bridge must return no password.");
+        PocketPlatform.Forget("test-identity");
+        PocketPlatform.ForgetAll();
+#elif UNITY_ANDROID
+        Application.platform = RuntimePlatform.Android;
+        Require(PocketPlatform.Available && PocketPlatform.SupportsSavedPasswords, "Android credential support must remain available.");
+        Require(PocketPlatform.Save("test-identity", "test-password"), "Android save must use its existing bridge.");
+        Require(PocketPlatform.Load("test-identity") == "android-test-secret", "Android load must use its existing bridge.");
+        PocketPlatform.Forget("test-identity");
+        PocketPlatform.ForgetAll();
+        Require(PocketPlatform.NavigationHat() == 2, "Android navigation must retain its native bridge.");
+        updater = new PocketUpdater();
+        typeof(PocketUpdater).GetMethod("Awake", BindingFlags.Instance | BindingFlags.NonPublic).Invoke(updater, null);
+        await updater.CheckAsync();
+        Require(PocketUpdater.Supported && UnityWebRequest.RequestCount == 2 && updater.Available, "Android must still check release and manifest metadata.");
+#else
+        Require(!PocketPlatform.SupportsSavedPasswords, "A desktop build must not offer unsupported native password storage.");
+#endif
+        Console.WriteLine("Platform/updater checks passed. This harness does not verify Unity, iOS linking, Keychain access or device behavior.");
+    }
+}
+
+// Host-side substitutes intentionally omit all AndroidJava types from iOS/desktop compilation.
+namespace UnityEngine
+{
+    public enum RuntimePlatform { Android, IPhonePlayer, OSXPlayer }
+    public class MonoBehaviour { }
+    public static class Application
+    {
+        public static RuntimePlatform platform;
+        public static string version = "2.1";
+        public static string temporaryCachePath = System.IO.Path.GetTempPath();
+    }
+    public struct Vector2 { public float x, y; }
+    public static class Mathf { public static float Clamp01(float value) => Math.Clamp(value, 0f, 1f); }
+    public static class Debug { public static void LogWarning(string message) { } }
+    public sealed class AsyncOperation
+    {
+        public bool isDone = true;
+        public event Action<AsyncOperation> completed { add { } remove { } }
+    }
+#if UNITY_ANDROID
+    public class AndroidJavaObject : IDisposable { public void Dispose() { } }
+    public sealed class AndroidJavaClass : AndroidJavaObject
+    {
+        public AndroidJavaClass(string name) { }
+        public T GetStatic<T>(string name) => (T)(object)new AndroidJavaObject();
+        public void CallStatic(string method, params object[] args) { }
+        public T CallStatic<T>(string method, params object[] args)
+        {
+            object value = method switch {
+                "save" => true,
+                "load" => "android-test-secret",
+                "navigationHat" => 2,
+                "installedCode" => 5L,
+                "updatePath" => System.IO.Path.Combine(System.IO.Path.GetTempPath(), "OpenFusion-test.apk"),
+                _ => default(T)
+            };
+            return (T)value;
+        }
+    }
+#endif
+}
+
+namespace UnityEngine.Networking
+{
+    public class DownloadHandler { public string text = "test metadata"; }
+    public sealed class DownloadHandlerFile : DownloadHandler
+    {
+        public bool removeFileOnAbort;
+        public DownloadHandlerFile(string path) { }
+    }
+    public sealed class UnityWebRequest : IDisposable
+    {
+        public enum Result { Success }
+        public static int RequestCount;
+        public int timeout;
+        public float downloadProgress;
+        public ulong downloadedBytes;
+        public long responseCode = 200;
+        public Result result = Result.Success;
+        public DownloadHandler downloadHandler = new DownloadHandler();
+        public static UnityWebRequest Get(string url) { RequestCount++; return new UnityWebRequest(); }
+        public void SetRequestHeader(string name, string value) { }
+        public AsyncOperation SendWebRequest() => new AsyncOperation();
+        public void Abort() { }
+        public void Dispose() { }
+    }
+}
+
+namespace OpenFusion.Api
+{
+    // Release parsing and checksum validation are outside these platform-gating checks.
+    public sealed class PocketRelease
+    {
+        public const int BuildCode = 5;
+        public const string LatestApi = "https://example.invalid/release";
+        public string ManifestUrl = "https://example.invalid/manifest", ApkUrl, Sha256 = "test", Title = "Test release";
+        public long Size, VersionCode;
+        public bool NewerThan(string version, long code) => true;
+        public static PocketRelease Read(string json) => new PocketRelease();
+        public void ApplyManifest(string manifest, string release) { }
+        public bool Verify(string path) => false;
+    }
+}
