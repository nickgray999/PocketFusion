diff --git a/tests/TouchCameraFollowTest/Program.cs b/tests/TouchCameraFollowTest/Program.cs
new file mode 100644
index 0000000..a95c26c
--- /dev/null
+++ b/tests/TouchCameraFollowTest/Program.cs
@@ -0,0 +1,99 @@
+using OpenFusion.World;
+
+int assertions = 0;
+void Check(bool condition, string label)
+{
+    assertions++;
+    if (!condition) throw new Exception(label);
+}
+void Near(float actual, float expected, float tolerance, string label)
+    => Check(float.IsFinite(actual) && Math.Abs(actual - expected) <= tolerance,
+        label + $": expected {expected}, got {actual}");
+
+// Project the visible body's feet and head through the default rig. This checks
+// actual framing, not just the multipliers used by the helper: the character
+// must stay readable and the camera must sit close to head height.
+double BodyViewportY(double bodyY, TouchCameraRig rig, double? orbitDistance = null, double? pitchDegrees = null)
+{
+    double pitch = (pitchDegrees ?? TouchCameraRig.DefaultPitch) * Math.PI / 180d;
+    double distance = orbitDistance ?? rig.Distance;
+    double cameraY = rig.PivotHeight + distance * Math.Sin(pitch);
+    double cameraZ = -distance * Math.Cos(pitch);
+    double relativeY = bodyY - cameraY, relativeZ = -cameraZ;
+    double up = relativeY * Math.Cos(pitch) + relativeZ * Math.Sin(pitch);
+    double forward = -relativeY * Math.Sin(pitch) + relativeZ * Math.Cos(pitch);
+    return .5d + up / (2d * forward * Math.Tan(30d * Math.PI / 180d));
+}
+
+// The closest user-selected orbit must still show the complete avatar, even at
+// either pitch limit. Checking projected head/feet catches a nominal "minimum"
+// that remains large in metres but actually frames the face like first person.
+for (int centimetres = 90; centimetres <= 220; centimetres++)
+{
+    float height = centimetres / 100f;
+    var rig = new TouchCameraRig(height);
+    float closest = rig.ClampDistance(float.MinValue);
+    Near(closest, rig.MinDistance, .00001f, "Minimum distance and zoom clamp agree");
+    Check(closest >= 1.8f && closest >= height * 1.99f && closest < rig.Distance,
+        "Closest user-selected orbit remains outside the full body across plausible avatar sizes");
+    foreach (float pitch in new[] { TouchCameraRig.MinPitch, TouchCameraRig.DefaultPitch, TouchCameraRig.MaxPitch })
+    {
+        double feet = BodyViewportY(0, rig, closest, pitch);
+        double head = BodyViewportY(height, rig, closest, pitch);
+        Check(double.IsFinite(feet) && double.IsFinite(head) && feet >= .15d && head <= .8d && head - feet >= .25d,
+            "Closest orbit keeps head and feet visible throughout manual pitch range");
+    }
+    Near(rig.ClampDistance(rig.Distance), rig.Distance, .00001f, "Default orbit survives zoom clamping");
+    Near(rig.ClampDistance(1f), closest, .00001f, "Legacy one-metre zoom cannot enter the body");
+    Near(rig.ClampDistance(0f), closest, .00001f, "Zero zoom request cannot enter the body");
+    Near(rig.ClampDistance(float.MaxValue), 15f, .00001f, "Finite extreme zoom-out stays bounded");
+    foreach (float invalid in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity })
+        Near(rig.ClampDistance(invalid), rig.Distance, .00001f, "Nonfinite zoom request restores the usable default orbit");
+
+    float previous = closest;
+    foreach (float requested in new[] { -1000f, -1f, 0f, .01f, 1f, 2f, 3f, 5f, 10f, 15f, 16f, 1000f })
+    {
+        float actual = rig.ClampDistance(requested);
+        Check(float.IsFinite(actual) && actual >= closest && actual <= 15f && actual >= previous,
+            "Increasing finite zoom requests remain monotonic and inside the third-person range");
+        Near(rig.ClampDistance(actual), actual, .00001f, "Repeated clamp cannot drift the requested distance");
+        previous = actual;
+    }
+}
+
+foreach (float height in new[] { .9f, 1.1f, 1.39f, 1.5f, 1.8f, 2.2f })
+{
+    var rig = new TouchCameraRig(height);
+    double cameraY = rig.PivotHeight + rig.Distance * Math.Sin(TouchCameraRig.DefaultPitch * Math.PI / 180d);
+    Check(cameraY >= height && cameraY <= height * 1.25f,
+        "Default camera stays near head height instead of several body heights overhead");
+    Check(rig.PivotHeight < height && rig.PivotHeight > height * .5f,
+        "Default view aims at the upper body rather than above the head");
+    double feet = BodyViewportY(0, rig), head = BodyViewportY(height, rig);
+    Check(feet >= .28d && feet < .4d && head > .55d && head <= .7d,
+        "Default body is fully visible near the lower centre of a 60-degree view");
+    Check(head - feet >= .22d && head - feet <= .32d,
+        "Default visible body occupies a readable quarter of the screen height");
+}
+{
+    var currentBody = new TouchCameraRig(1.39f);
+    double oldCameraY = 2d + 7d * Math.Sin(18d * Math.PI / 180d);
+    double newCameraY = currentBody.PivotHeight + currentBody.Distance * Math.Sin(TouchCameraRig.DefaultPitch * Math.PI / 180d);
+    Check(newCameraY < oldCameraY * .5d && newCameraY < 1.8d,
+        "Measured 1.39m avatar no longer inherits the old 4.16m camera height");
+}
+foreach (float invalid in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity, 0f, -1f })
+{
+    var rig = new TouchCameraRig(invalid);
+    Check(rig.BodyHeight == TouchCameraRig.FallbackBodyHeight && float.IsFinite(rig.Distance) && rig.Distance > 0f && rig.ClampDistance(1f) >= 2.99f,
+        "Missing or invalid body bounds produce a finite usable rig");
+}
+{
+    var tiny = new TouchCameraRig(.001f); var huge = new TouchCameraRig(1000f);
+    Check(tiny.BodyHeight >= .9f && tiny.Distance > 2f, "Tiny import bounds cannot put the default camera inside the avatar");
+    Check(huge.BodyHeight <= 2.2f && huge.Distance < 8f, "Corrupt accessory-sized bounds cannot zoom the camera far away");
+    Check(TouchCameraRig.MinPitch < 0f && TouchCameraRig.MaxPitch < 45f,
+        "Manual pitch can reach the horizon while avoiding an accidental near-vertical overhead view");
+}
+
+Console.WriteLine($"PASS {assertions} third-person rig assertions using the production helper");
