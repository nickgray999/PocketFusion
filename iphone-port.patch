+
+            internal PanelScope(bool enabled, Rect area)
+            {
+                clipped = enabled;
+                previousMatrix = GUI.matrix;
+                previousPane = guiPane;
+                if (!clipped) return;
+                if (previousPane.HasValue) EndPaneClip();
+                RenderTexture.active = null;
+                guiPane = area;
+                BeginPaneClip(area, Matrix4x4.Translate(area.position));
+            }
+
+            public void Dispose()
+            {
+                if (!clipped) return;
+                EndPaneClip();
+                guiPane = previousPane;
+                if (previousPane.HasValue) BeginPaneClip(previousPane.Value, previousMatrix);
