+                if (floorHost != null) UnityEngine.Object.DestroyImmediate(floorHost);
+                if (terrainHost != null) UnityEngine.Object.DestroyImmediate(terrainHost);
+                if (terrainData != null) UnityEngine.Object.DestroyImmediate(terrainData);
