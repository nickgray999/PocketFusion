diff --git a/Assets/Editor/IOSSpawnSupportChecks.cs b/Assets/Editor/IOSSpawnSupportChecks.cs
new file mode 100644
index 0000000..2a544c3
--- /dev/null
+++ b/Assets/Editor/IOSSpawnSupportChecks.cs
@@ -0,0 +1,123 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using OpenFusion.World;
+using UnityEditor;
+using UnityEngine;
+
+namespace OpenFusion.EditorTools
+{
+    public static class IOSSpawnSupportChecks
+    {
+        static int assertions;
+        static void Check(bool condition, string message)
+        { assertions++; if (!condition) throw new InvalidOperationException(message); }
+
+        public static void Run()
+        {
+            assertions = 0;
+            var objects = new List<GameObject>();
+            TerrainData terrainData = null; Mesh waterMesh = null; Material waterMaterial = null;
+            var results = new List<string> { "UTC " + DateTime.UtcNow.ToString("O") };
+            bool ignoredPair = Physics.GetIgnoreLayerCollision(25, 26);
+            var probe = typeof(GameClient).GetMethod("TryIPhoneSpawnSupport", BindingFlags.Static | BindingFlags.NonPublic);
+            Check(probe != null, "Production spawn-support physical probe must be present.");
+            var origin = new Vector3(12288f, 0f, 12288f);
+            WaterSurface.Clear();
+            try
+            {
+                var actor = new GameObject("support check player"); objects.Add(actor); actor.transform.position = origin;
+                var floorHost = new GameObject("support check floor"); objects.Add(floorHost);
+                floorHost.transform.position = origin + Vector3.down * .5f;
+                var floor = floorHost.AddComponent<BoxCollider>(); floor.size = new Vector3(8f, 1f, 8f);
+                var roofHost = new GameObject("support check roof"); objects.Add(roofHost);
+                roofHost.transform.position = origin + Vector3.up * 49f;
+                var roof = roofHost.AddComponent<BoxCollider>(); roof.size = new Vector3(8f, .5f, 8f);
+                Func<float, object[]> sample = y => new object[] { origin + Vector3.up * y, actor.transform, 50f, 0f, false };
+                Func<object[], bool> test = args => (bool)probe.Invoke(null, args);
+
+                var args = sample(-.01f);
+                Check(test(args) && Mathf.Abs((float)args[3]) < .001f && !(bool)args[4],
+                    "Nearby penetration must find the local floor while ignoring a roof 49m above.");
+                args = sample(4.006f);
+                Check(test(args) && Mathf.Abs((float)args[3]) < .001f,
+                    "A verified physical floor four metres below may release a deliberate spawn drop.");
+                actor.layer = 25; floorHost.layer = 26;
+                Physics.IgnoreLayerCollision(25, 26, true);
+                args = sample(.1f);
+                Check(!test(args), "A ray-visible floor whose layer pair ignores the player cannot authorize movement.");
+                Physics.IgnoreLayerCollision(25, 26, false);
+                args = sample(.1f);
+                Check(test(args), "Restoring the controller/floor layer pair restores valid physical support.");
+                actor.layer = floorHost.layer = 0;
+                args = sample(8.02f);
+                Check(!test(args), "A floor beyond the eight-metre drop limit must not release movement.");
+                floor.enabled = false;
+                var triggerHost = new GameObject("support check trigger"); objects.Add(triggerHost);
+                var trigger = triggerHost.AddComponent<BoxCollider>(); trigger.size = new Vector3(8f, .1f, 8f);
+                trigger.isTrigger = true; triggerHost.transform.position = origin;
+                var childHost = new GameObject("support check actor collider"); objects.Add(childHost);
+                childHost.transform.SetParent(actor.transform, false);
+                var child = childHost.AddComponent<BoxCollider>(); child.size = new Vector3(8f, .1f, 8f);
+                args = sample(0f);
+                Check(!test(args), "Missing local floor cannot be replaced by triggers, actor colliders or a distant roof.");
+
+                // Reproduce the real map's authoritative spawn/floor heights with
+                // a true TerrainCollider, rather than a scalar support substitute.
+                terrainData = new TerrainData { heightmapResolution = 33, size = new Vector3(8f, 1f, 8f) };
+                var terrainHost = Terrain.CreateTerrainGameObject(terrainData); objects.Add(terrainHost);
+                terrainHost.name = "support check real terrain";
+                terrainHost.transform.position = origin + new Vector3(-4f, -50.156f, -4f);
+                args = sample(-46.15f);
+                Check(test(args) && Mathf.Abs((float)args[3] + 50.156f) < .005f,
+                    "Actual TerrainCollider must support feet −46.15m over terrain −50.156m.");
+                terrainHost.GetComponent<TerrainCollider>().enabled = false;
+                args = sample(-46.15f);
+                Check(!test(args), "A visually present terrain with its collider disabled must fail closed.");
+
+                var waterHost = new GameObject("support check registered water"); objects.Add(waterHost);
+                waterHost.transform.position = origin;
+                waterMesh = new Mesh();
+                waterMesh.vertices = new[] { new Vector3(-4f, 0f, -4f), new Vector3(-4f, 0f, 4f), new Vector3(4f, 0f, 4f), new Vector3(4f, 0f, -4f) };
+                waterMesh.triangles = new[] { 0, 1, 2, 0, 2, 3 }; waterMesh.RecalculateBounds(); waterMesh.RecalculateNormals();
+                waterHost.AddComponent<MeshFilter>().sharedMesh = waterMesh;
+                var shader = Shader.Find("OpenFusion/Water"); Check(shader != null, "Water fixture needs the production water shader.");
+                waterMaterial = new Material(shader) { name = "ffWaterSupportCheck" };
+                waterHost.AddComponent<MeshRenderer>().sharedMaterial = waterMaterial;
+                Check(WaterSurface.TryRegister(waterHost), "Fixture must register through the production water path.");
+                args = sample(.2f);
+                Check(test(args) && (bool)args[4] && Mathf.Abs((float)args[3]) < .001f,
+                    "A nearby registered water collider on ignored-raycast layer 2 must support a water spawn.");
+                args = sample(8.02f);
+                Check(!test(args), "A distant registered water surface must not release movement.");
+                floor.enabled = true;
+                floorHost.transform.position = origin + Vector3.up * -.3f; // solid top .2m above water
+                args = sample(.2f);
+                Check(test(args) && !(bool)args[4] && Mathf.Abs((float)args[3] - .2f) < .001f,
+                    "A nearer solid platform must win over water beneath it.");
+                results.Add("PASS " + assertions + " assertions against the production physical/water spawn-support probe.");
+                results.Add("Editor fixtures only; real-map collider correctness and physical-device world entry remain unverified.");
+                Debug.Log("[iOS spawn support] " + string.Join("\n", results));
+            }
+            catch (Exception error) { results.Add("FAIL " + error); throw; }
+            finally
+            {
+                WaterSurface.Clear();
+                Physics.IgnoreLayerCollision(25, 26, ignoredPair);
+                for (int i = objects.Count - 1; i >= 0; i--) if (objects[i] != null) UnityEngine.Object.DestroyImmediate(objects[i]);
+                if (waterMaterial != null) UnityEngine.Object.DestroyImmediate(waterMaterial);
+                if (waterMesh != null) UnityEngine.Object.DestroyImmediate(waterMesh);
+                if (terrainData != null) UnityEngine.Object.DestroyImmediate(terrainData);
+                Physics.SyncTransforms();
+                Directory.CreateDirectory("Logs"); File.WriteAllLines("Logs/ios-spawn-support-results.txt", results);
+            }
+        }
+
+        public static void Batch()
+        {
+            try { Run(); EditorApplication.Exit(0); }
+            catch (Exception error) { Debug.LogException(error); EditorApplication.Exit(1); }
+        }
+    }
+}
