diff --git a/Assets/Editor/IOSThirdPersonChecks.cs b/Assets/Editor/IOSThirdPersonChecks.cs
new file mode 100644
index 0000000..d446a70
--- /dev/null
+++ b/Assets/Editor/IOSThirdPersonChecks.cs
@@ -0,0 +1,226 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using OpenFusion.World;
+using UnityEditor;
+using UnityEngine;
+
+namespace OpenFusion.EditorTools
+{
+    // Real physics fixtures exercise the same camera and movement helpers used
+    // on the phone. No server connection or live scene objects are required.
+    public static class IOSThirdPersonChecks
+    {
+        const BindingFlags HiddenStatic = BindingFlags.Static | BindingFlags.NonPublic;
+        const float Epsilon = .015f;
+        static int assertions;
+        static readonly MethodInfo MoveMethod = typeof(GameClient).GetMethod("TouchMoveDirection", HiddenStatic);
+        static readonly MethodInfo PositionMethod = typeof(GameClient).GetMethod("TouchCameraPosition", HiddenStatic);
+        static readonly MethodInfo ObstructionMethod = typeof(GameClient).GetMethod("TryTouchCameraObstruction", HiddenStatic);
+
+        static void Check(bool condition, string message)
+        { assertions++; if (!condition) throw new InvalidOperationException(message); }
+
+        static Vector3 Move(Vector2 input, float yaw)
+            => (Vector3)MoveMethod.Invoke(null, new object[] { input, yaw });
+
+        static Vector3 CameraPosition(Vector3 pivot, Quaternion rotation, float distance, Transform player, bool collision, out Collider obstacle)
+        {
+            var arguments = new object[] { pivot, rotation, distance, player, ~0, collision, null };
+            var result = (Vector3)PositionMethod.Invoke(null, arguments);
+            obstacle = (Collider)arguments[6];
+            return result;
+        }
+
+        static bool Obstruction(Vector3 pivot, Vector3 direction, float distance, Transform player, out RaycastHit hit)
+        {
+            var arguments = new object[] { pivot, direction, distance, player, ~0, default(RaycastHit) };
+            bool result = (bool)ObstructionMethod.Invoke(null, arguments);
+            hit = (RaycastHit)arguments[5];
+            return result;
+        }
+
+        static BoxCollider Box(List<GameObject> objects, string name, Vector3 position, Vector3 size, Quaternion rotation, Transform parent = null, bool trigger = false)
+        {
+            var host = new GameObject(name); objects.Add(host);
+            if (parent != null) host.transform.SetParent(parent, false);
+            host.transform.SetPositionAndRotation(position, rotation);
+            var collider = host.AddComponent<BoxCollider>(); collider.size = size; collider.isTrigger = trigger;
+            return collider;
+        }
+
+        public static void Run()
+        {
+            assertions = 0;
+            var results = new List<string> { "UTC " + DateTime.UtcNow.ToString("O") };
+            var objects = new List<GameObject>();
+            try
+            {
+                Check(MoveMethod != null && PositionMethod != null && ObstructionMethod != null,
+                    "Production touch movement and camera helpers must exist.");
+                var origin = new Vector3(20000f, 1000f, 20000f);
+                var actor = new GameObject("third-person check player"); objects.Add(actor);
+                actor.transform.position = origin;
+                var rig = new TouchCameraRig(1.38f);
+                Box(objects, "third-person own body", origin + Vector3.up * rig.PivotHeight,
+                    new Vector3(.7f, 1.38f, .7f), Quaternion.identity, actor.transform);
+                var equipment = Box(objects, "third-person own equipment", origin,
+                    new Vector3(.45f, .45f, .45f), Quaternion.identity, actor.transform);
+                CheckHeldMovement(results, actor.transform, equipment.transform, origin, rig);
+                CheckOrbitTurn(results, actor.transform, equipment.transform, origin, rig);
+                CheckWorldObstructions(results, objects, actor.transform, equipment.transform, origin, rig);
+                results.Add("PASS " + assertions + " assertions against production WASD movement, third-person placement and Unity sphere-cast collision.");
+                results.Add("Editor fixtures only; physical-device camera feel still requires a phone play test.");
+                Debug.Log("[iOS third person] " + string.Join("\n", results));
+            }
+            catch (Exception error) { results.Add("FAIL " + error); throw; }
+            finally
+            {
+                for (int i = objects.Count - 1; i >= 0; i--)
+                    if (objects[i] != null) UnityEngine.Object.DestroyImmediate(objects[i]);
+                Physics.SyncTransforms();
+                Directory.CreateDirectory("Logs"); File.WriteAllLines("Logs/ios-third-person-results.txt", results);
+            }
+        }
+
+        static void CheckHeldMovement(List<string> results, Transform actor, Transform equipment, Vector3 origin, TouchCameraRig rig)
+        {
+            var inputs = new[] { Vector2.up, Vector2.down, Vector2.left, Vector2.right };
+            int sequences = 0;
+            foreach (int hz in new[] { 30, 60 })
+            foreach (float startingYaw in new[] { 0f, 90f })
+            foreach (var input in inputs)
+            {
+                actor.position = origin;
+                Vector3 cameraBefore = Vector3.zero, pivotBefore = Vector3.zero;
+                float yawBefore = startingYaw;
+                int frames = hz * 3;
+                for (int frame = 0; frame < frames; frame++)
+                {
+                    // A right-thumb turn halfway through a held left-thumb
+                    // gesture must change the WASD basis exactly once.
+                    float yaw = startingYaw + (frame >= frames / 2 ? 70f : 0f);
+                    var expectedDirection = Quaternion.Euler(0f, yaw, 0f) * new Vector3(input.x, 0f, input.y);
+                    var direction = Move(input, yaw);
+                    Check(Vector3.Distance(direction, expectedDirection) < .0001f,
+                        "Held movement changed its camera-relative WASD direction at " + hz + " Hz, frame " + frame + ".");
+                    actor.position += direction * (5f / hz);
+                    actor.rotation = Quaternion.LookRotation(direction, Vector3.up);
+                    var pivot = actor.position + Vector3.up * rig.PivotHeight;
+                    var rotation = Quaternion.Euler(TouchCameraRig.DefaultPitch, yaw, 0f);
+                    equipment.SetPositionAndRotation(pivot + rotation * Vector3.back * .9f, rotation);
+                    Physics.SyncTransforms();
+                    var camera = CameraPosition(pivot, rotation, rig.Distance, actor, true, out var obstacle);
+                    Check(obstacle == null, "The local body or equipment shortened the camera during a held movement gesture.");
+                    Check(Mathf.Abs(Vector3.Distance(camera, pivot) - rig.Distance) < Epsilon,
+                        "Held movement let the character catch the camera instead of preserving third-person distance.");
+                    Check(Vector3.Distance(camera, pivot + rotation * Vector3.back * rig.Distance) < Epsilon,
+                        "The camera did not follow the current live character pivot.");
+                    if (frame > 0 && yaw == yawBefore)
+                        Check(Vector3.Distance(camera - cameraBefore, pivot - pivotBefore) < Epsilon,
+                            "The follow camera lagged behind the moving pivot at " + hz + " Hz.");
+                    cameraBefore = camera; pivotBefore = pivot; yawBefore = yaw;
+                }
+                sequences++;
+            }
+            Check(Vector3.Distance(Move(new Vector2(.3f, -.4f), 90f), new Vector3(-.4f, 0f, -.3f)) < .0001f,
+                "Partial joystick input must preserve analog speed in the camera-relative basis.");
+            Check(Mathf.Abs(Move(Vector2.one, 23f).magnitude - 1f) < .0001f,
+                "Diagonal WASD movement must not move faster than the speed limit.");
+            results.Add("PASS " + sequences + " three-second forward/back/strafe holds at 30/60 Hz, including right-thumb turns, own-body collision filtering and immediate camera following.");
+        }
+
+        static void CheckOrbitTurn(List<string> results, Transform actor, Transform equipment, Vector3 origin, TouchCameraRig rig)
+        {
+            actor.position = origin;
+            var pivot = origin + Vector3.up * rig.PivotHeight;
+            Vector3 previous = Vector3.zero;
+            foreach (float yaw in new[] { 0f, 180f, 0f, -180f })
+            {
+                var rotation = Quaternion.Euler(TouchCameraRig.DefaultPitch, yaw, 0f);
+                equipment.SetPositionAndRotation(pivot + rotation * Vector3.back * .9f, rotation);
+                Physics.SyncTransforms();
+                var camera = CameraPosition(pivot, rotation, rig.Distance, actor, true, out var obstacle);
+                Check(obstacle == null && Mathf.Abs(Vector3.Distance(camera, pivot) - rig.Distance) < Epsilon,
+                    "A 180-degree turn must stay at the third-person orbit distance, without crossing the body.");
+                Check(Vector3.Distance(camera, pivot + rotation * Vector3.back * rig.Distance) < Epsilon,
+                    "A 180-degree turn must place the camera on the orbit, not on a chord through the body.");
+                if (previous != Vector3.zero)
+                {
+                    var horizontal = camera - pivot; horizontal.y = 0f;
+                    var before = previous - pivot; before.y = 0f;
+                    Check(Vector3.Dot(horizontal.normalized, before.normalized) < -.999f,
+                        "A half-turn must reach the opposite side of the character immediately.");
+                }
+                previous = camera;
+            }
+            results.Add("PASS 180-degree orbit reversals stay outside the body rather than interpolating a camera chord through it.");
+        }
+
+        static void CheckWorldObstructions(List<string> results, List<GameObject> objects, Transform actor, Transform equipment, Vector3 origin, TouchCameraRig rig)
+        {
+            actor.position = origin;
+            var pivot = origin + Vector3.up * rig.PivotHeight;
+            var rotation = Quaternion.Euler(TouchCameraRig.DefaultPitch, 0f, 0f);
+            var back = rotation * Vector3.back;
+            equipment.SetPositionAndRotation(pivot + back * .7f, rotation);
+            var trigger = Box(objects, "third-person ignored world trigger", pivot + back * .8f,
+                new Vector3(3f, 3f, .1f), rotation, null, true);
+            var far = Box(objects, "third-person far wall", pivot + back * 3.5f,
+                new Vector3(3f, 3f, .2f), rotation);
+            var near = Box(objects, "third-person near wall", pivot + back * 1.9f,
+                new Vector3(3f, 3f, .2f), rotation);
+            Physics.SyncTransforms();
+            Check(Obstruction(pivot, back, rig.Distance, actor, out var hit) && hit.collider == near,
+                "The nearest world wall must win over equipment, a nearer trigger, and the far wall.");
+            var camera = CameraPosition(pivot, rotation, rig.Distance, actor, true, out var obstacle);
+            float actualDistance = Vector3.Distance(camera, pivot);
+            Check(obstacle == near && Mathf.Abs(actualDistance - (hit.distance - .05f)) < Epsilon,
+                "The final camera position must honor the physical wall and its safety margin.");
+            Check(actualDistance < rig.MinDistance && actualDistance > .1f,
+                "A real close wall must shorten the orbit instead of forcing a minimum distance through solid geometry.");
+            Check(Vector3.Dot(camera - near.transform.position, back) < -.15f,
+                "The camera must remain on the character side of the wall.");
+            near.enabled = false;
+            Physics.SyncTransforms();
+            Check(Obstruction(pivot, back, rig.Distance, actor, out hit) && hit.collider == far,
+                "Disabling the near wall must reveal the farther world obstruction.");
+            far.enabled = false;
+            Physics.SyncTransforms();
+            camera = CameraPosition(pivot, rotation, rig.Distance, actor, true, out obstacle);
+            Check(obstacle == null && Mathf.Abs(Vector3.Distance(camera, pivot) - rig.Distance) < Epsilon,
+                "Removing world walls must restore the full orbit despite the remaining trigger and equipment.");
+            trigger.enabled = false;
+
+            // Force the production 32-hit NonAlloc buffer to saturate, then
+            // require its fallback to preserve the closest wall correctly.
+            for (int i = 0; i < 40; i++)
+                Box(objects, "third-person dense wall " + i, pivot + back * (.8f + i * .075f),
+                    new Vector3(3f, 3f, .025f), rotation);
+            var denseClosest = Box(objects, "third-person dense closest wall", pivot + back * .5f,
+                new Vector3(3f, 3f, .025f), rotation);
+            Physics.SyncTransforms();
+            var probe = new RaycastHit[32];
+            Check(Physics.SphereCastNonAlloc(pivot, .18f, back, probe, rig.Distance, ~0, QueryTriggerInteraction.Ignore) == probe.Length,
+                "The dense fixture must actually saturate the production-sized hit buffer.");
+            Check(Physics.SphereCastAll(pivot, .18f, back, rig.Distance, ~0, QueryTriggerInteraction.Ignore).Length > probe.Length,
+                "The dense fixture must contain more world hits than the NonAlloc capacity.");
+            Check(Obstruction(pivot, back, rig.Distance, actor, out hit) && hit.collider == denseClosest,
+                "Saturated collision queries must still choose the closest world wall.");
+            camera = CameraPosition(pivot, rotation, rig.Distance, actor, true, out obstacle);
+            Check(obstacle == denseClosest && Mathf.Abs(Vector3.Distance(camera, pivot) - (hit.distance - .05f)) < Epsilon,
+                "The dense-geometry camera must remain on the near side of its closest wall.");
+            var unrestricted = CameraPosition(pivot, rotation, rig.Distance, actor, false, out obstacle);
+            Check(obstacle == null && Mathf.Abs(Vector3.Distance(unrestricted, pivot) - rig.Distance) < Epsilon,
+                "The explicit collision-disabled path must preserve the same complete orbit placement.");
+            results.Add("PASS actual Unity sphere casts ignore owned body/equipment and triggers, choose nearest walls, enforce wall clearance, and retain correctness beyond 32 hits.");
+        }
+
+        public static void Batch()
+        {
+            try { IOSInputChecks.Run(); Run(); EditorApplication.Exit(0); }
+            catch (Exception error) { Debug.LogException(error); EditorApplication.Exit(1); }
+        }
+    }
+}
