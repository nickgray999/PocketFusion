diff --git a/tests/WorldColorAllocationTest/Program.cs b/tests/WorldColorAllocationTest/Program.cs
new file mode 100644
index 0000000..11d3f70
--- /dev/null
+++ b/tests/WorldColorAllocationTest/Program.cs
@@ -0,0 +1,131 @@
+using OpenFusion.World;
+
+// The reference below is the pre-optimization sampler. Keep it separate from
+// production so a changed blend, missing-cell rule or default cannot agree with itself.
+int checks = 0;
+void Check(bool ok, string message)
+{
+    checks++;
+    if (!ok) throw new InvalidOperationException(message);
+}
+void Equal(float actual, float expected, string message) =>
+    Check(BitConverter.SingleToInt32Bits(actual) == BitConverter.SingleToInt32Bits(expected), message);
+var manifest = new CachingManifest25 { PaidCoords = new[] { 4, 4, 5, 4, 15, 15 } };
+var registry = new DongRegistry(manifest);
+var emptyRegistry = new DongRegistry(manifest);
+var random = new Random(0x5046);
+float[] fog = new float[4], sky = new float[4], light = new float[4], rim = new float[4];
+Func<int, int, DongColors> get = registry.ColorsAt;
+Func<int, int, bool> loaded = registry.Loaded, loadable = registry.Loadable;
+float[] RandomColor() => new[] { (float)random.NextDouble(), (float)random.NextDouble(), (float)random.NextDouble(), (float)random.NextDouble() };
+
+void Compare(float x, float z)
+{
+    Legacy.PositionColor(x, z, get, out var oldFog, out var oldSky, out var oldLight, out var oldDepth, out var oldRim);
+    Array.Fill(fog, float.NaN); Array.Fill(sky, float.NaN); Array.Fill(light, float.NaN); Array.Fill(rim, float.NaN);
+    registry.PositionColor(x, z, fog, sky, light, rim, out var depth);
+    for (int c = 0; c < 4; c++)
+    {
+        Equal(fog[c], oldFog[c], "fog component differs"); Equal(sky[c], oldSky[c], "sky component differs");
+        Equal(light[c], oldLight[c], "light component differs"); Equal(rim[c], oldRim[c], "rim component differs");
+    }
+    Equal(depth, oldDepth, "fog depth differs");
+    registry.PositionColor(x, z, out var apiFog, out var apiSky, out var apiLight, out var apiDepth, out var apiRim);
+    for (int c = 0; c < 4; c++)
+    {
+        Equal(apiFog[c], oldFog[c], "compatibility fog differs"); Equal(apiSky[c], oldSky[c], "compatibility sky differs");
+        Equal(apiLight[c], oldLight[c], "compatibility light differs"); Equal(apiRim[c], oldRim[c], "compatibility rim differs");
+    }
+    Equal(apiDepth, oldDepth, "compatibility depth differs");
+    Check(registry.Step(x, z) == DongGrid.Step(x, z, loaded, loadable), "cached streaming callbacks differ");
+}
+
+// Empty, single-cell, sparse and full grids; repeated use must overwrite every
+// component rather than accumulate old samples. Include all four world edges,
+// blend plateaus, exact seams, negative coordinates and missing neighbors.
+for (int scenario = 0; scenario < 4; scenario++)
+{
+    foreach (var cell in registry.Dongs)
+    {
+        bool set = scenario == 1 ? cell.X == 4 && cell.Y == 4 : scenario == 2 ? random.Next(3) != 0 : scenario == 3;
+        cell.Colors = new DongColors { Set = set, Fog = RandomColor(), Sky = RandomColor(), Light = RandomColor(), FogDepth = (float)random.NextDouble() * 4f };
+        cell.Loaded = set && random.Next(2) == 0;
+    }
+    float[] special = { -2048f, -0.001f, 0f, 128f, 256f, 384f, 511.999f, 512f, 640f, 2304f, 2560f, 7680f, 8064f, 8191.999f, 8192f, 9000f };
+    foreach (var x in special) foreach (var z in special) Compare(x, z);
+    for (int i = 0; i < 2000; i++) Compare((float)random.NextDouble() * 10000f - 1000f, (float)random.NextDouble() * 10000f - 1000f);
+}
+
+// Delegates must read live registry state and remain independent per instance.
+registry.Zone = ZoneType.Paid;
+registry.At(4, 4).Loaded = false;
+Check(registry.Step(2304, 2304) == DongGrid.Step(2304, 2304, loaded, loadable), "live loaded state ignored");
+registry.Manifest = new CachingManifest25 { PaidCoords = new[] { 5, 5 } };
+Check(registry.Step(2816, 2816) == DongGrid.Step(2816, 2816, loaded, loadable), "live manifest state ignored");
+registry.At(4, 4).Colors = new DongColors { Set = true, Fog = new[] { .25f, .5f, .75f, 1f }, Sky = new[] { .1f, .2f, .3f, 1f }, Light = new[] { .8f, .7f, .6f, 1f }, FogDepth = 2f };
+registry.PositionColor(2304, 2304, fog, sky, light, rim, out var liveDepth);
+Equal(fog[0], .25f, "live color update ignored"); Equal(liveDepth, 2f, "live depth update ignored");
+emptyRegistry.PositionColor(2304, 2304, fog, sky, light, rim, out var emptyDepth);
+Equal(fog[0], 0f, "different registry reused colors"); Equal(emptyDepth, 0f, "different registry reused depth");
+registry.PositionColor(2304, 2304, out var firstFog, out _, out _, out _, out _);
+firstFog[0] = -100f;
+registry.PositionColor(2304, 2304, out var nextFog, out _, out _, out _, out _);
+Equal(nextFog[0], .25f, "compatibility API shares mutable result buffers");
+bool invalidRejected = false;
+try { registry.PositionColor(2304, 2304, new float[3], sky, light, rim, out _); }
+catch (ArgumentException) { invalidRejected = true; }
+Check(invalidRejected, "short buffers were not rejected");
+
+const int iterations = 100000;
+double consumer = 0;
+long Measure(Action sample)
+{
+    for (int i = 0; i < 10000; i++) sample();
+    long before = GC.GetAllocatedBytesForCurrentThread();
+    for (int i = 0; i < iterations; i++) sample();
+    return GC.GetAllocatedBytesForCurrentThread() - before;
+}
+long beforeBytes = Measure(() =>
+{
+    // This matches the old registry's per-call method-group conversions as
+    // well as its allocating sampler and the world streaming step.
+    Legacy.PositionColor(2304, 2304, registry.ColorsAt, out var f, out var s, out var l, out var d, out var r);
+    var step = DongGrid.Step(2304, 2304, registry.Loaded, registry.Loadable);
+    consumer += f[0] + s[1] + l[2] + d + r[0] + step.x;
+});
+long afterBytes = Measure(() =>
+{
+    registry.PositionColor(2304, 2304, fog, sky, light, rim, out var d);
+    var step = registry.Step(2304, 2304);
+    consumer += fog[0] + sky[1] + light[2] + d + rim[0] + step.x;
+});
+long emptyBytes = Measure(() =>
+{
+    emptyRegistry.PositionColor(-100f, -100f, fog, sky, light, rim, out var d);
+    consumer += fog[3] + sky[0] + light[0] + d + rim[3];
+});
+Check(beforeBytes > 0, "legacy allocation control did not allocate");
+Check(afterBytes == 0, "world color/streaming hot path allocated after warmup");
+Check(emptyBytes == 0, "empty-world fallback allocated after warmup");
+Check(double.IsFinite(consumer) && consumer > 0, "benchmark output was not consumed");
+Console.WriteLine($"PASS: {checks:N0} assertions; bit-identical legacy interpolation and compatible allocating API.");
+Console.WriteLine($"Warmed {iterations:N0} color + streaming samples: before={beforeBytes:N0} bytes ({beforeBytes / (double)iterations:0.##}/sample), after={afterBytes:N0} bytes; empty fallback={emptyBytes:N0} bytes.");
+Console.WriteLine("Allocation measurements use .NET 8; device CPU, temperature and Unity/IL2CPP memory require separate physical measurements.");
+
+static class Legacy
+{
+    public static void PositionColor(float px, float pz, Func<int, int, DongColors> get, out float[] fog, out float[] sky, out float[] light, out float fogDepth, out float[] rim)
+    {
+        float u = px / DongGrid.Size - 0.5f, v = pz / DongGrid.Size - 0.5f; int x0 = (int)Math.Floor(u), x1 = x0 + 1, y0 = (int)Math.Floor(v), y1 = y0 + 1;
+        float fx = Clamp01((u - x0 - 0.25f) * 2f), fz = Clamp01((v - y0 - 0.25f) * 2f);
+        var fg = new float[4]; var sk = new float[4]; var lt = new float[4]; float fd = 0, sum = 0;
+        void Add(int cx, int cy, float w) { if (cx < 0 || cy < 0 || cx >= DongGrid.Count || cy >= DongGrid.Count) return; var c = get(cx, cy); if (!c.Set) return;
+            for (int i = 0; i < 4; i++) { fg[i] += w * c.Fog[i]; sk[i] += w * c.Sky[i]; lt[i] += w * c.Light[i]; } fd += w * c.FogDepth; sum += w; }
+        Add(x0, y0, (1 - fx) * (1 - fz)); Add(x1, y0, fx * (1 - fz)); Add(x0, y1, (1 - fx) * fz); Add(x1, y1, fx * fz);
+        if (sum > 0) { float k = 1f / sum; for (int i = 0; i < 4; i++) { fg[i] *= k; sk[i] *= k; lt[i] *= k; } fd *= k; }
+        else { fd = 0; sk = new float[] { 1, 1, 1, 1 }; fg = new float[] { 0, 0, 0, 1 }; lt = new float[] { 1, 1, 1, 1 }; }
+        fog = fg; sky = sk; light = lt; fogDepth = fd;
+        rim = new[] { fog[0] * 0.35f, fog[1] * 0.35f, fog[2] * 0.35f, 1f };
+    }
+    static float Clamp01(float v) => v < 0 ? 0 : v > 1 ? 1 : v;
+}
diff --git a/tests/WorldColorAllocationTest/README.md b/tests/WorldColorAllocationTest/README.md
new file mode 100644
index 0000000..d77db9a
--- /dev/null
+++ b/tests/WorldColorAllocationTest/README.md
@@ -0,0 +1,11 @@
+Runs the actual production `DongGrid` and `DongRegistry` without Unity or game assets.
+
+The sampler is compared bit-for-bit against the pre-optimization algorithm across empty, single-cell, sparse and full maps, exact boundaries, missing neighbors, out-of-world coordinates and randomized positions. Poisoned reusable buffers check that every sample resets all channels; the compatibility API must still return independent arrays. Streaming callbacks must observe live registry state.
+
+After warmup, 100,000 combined color/streaming calls are measured with `GC.GetAllocatedBytesForCurrentThread`. The old pipeline is the positive allocation control; production reusable-buffer calls and empty-map defaults must allocate zero bytes. This measures managed allocations on .NET 8, not iPhone temperature or IL2CPP frame time.
+
+Run from a clean local copy using the bundled .NET 8 runtime:
+
+```sh
+dotnet run --project Tests/WorldColorAllocationTest -c Release
+```
