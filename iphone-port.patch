diff --git a/Assets/Editor/IOSSceneLifecycle.cs b/Assets/Editor/IOSSceneLifecycle.cs
new file mode 100644
index 0000000..2e0a182
--- /dev/null
+++ b/Assets/Editor/IOSSceneLifecycle.cs
@@ -0,0 +1,182 @@
+using System;
+using System.IO;
+using System.Xml;
+#if UNITY_IOS
+using UnityEditor.iOS.Xcode;
+#endif
+
+namespace OpenFusion.EditorTools
+{
+    // Project-owned source-export adaptation for the Personal-compatible 2022.3.62f3
+    // trampoline. Compared with Unity's installed 2022.3.76f1 UIScene glue; preserves
+    // the original .62 runtime, rendering, startUnity: and CADisplayLink interfaces.
+    // Unity's migration guidance: https://discussions.unity.com/t/1709065
+    public static class IOSSceneLifecycle
+    {
+        const string Marker = "// OpenFusion Pocket UIScene backport for Unity 2022.3.62f3";
+
+        public static void Apply(string output)
+        {
+            Apply(output, Path.Combine("Assets", "Editor", "IOSSceneLifecycle"));
+        }
+
+        // Explicit template directory also permits regression tests without Unity.
+        public static void Apply(string output, string templates)
+        {
+            string controllerPath = Path.Combine(output, "Classes", "UnityAppController.mm");
+            string headerPath = Path.Combine(output, "Classes", "UnityAppController.h");
+            string controller = Normalize(File.ReadAllText(controllerPath));
+            string header = Normalize(File.ReadAllText(headerPath));
+            bool patched = controller.Contains(Marker);
+            if (!patched && !controller.Contains("- (void)initUnityWithApplication:(UIApplication*)application"))
+            {
+                // A newer supported Unity template already owns its native lifecycle.
+                if (controller.Contains("- (void)initUnityWithScene:(UIWindowScene*)scene") &&
+                    File.Exists(Path.Combine(output, "Classes", "UI", "UnityScene.mm"))) return;
+                throw new InvalidDataException("Unsupported Unity iOS trampoline. UIScene backport expects the project's pinned 2022.3.62f3 template; export a fresh project rather than patching unknown native code.");
+            }
+
+            if (!patched)
+            {
+                controller = ReplaceOnce(controller,
+                    "    // if application is in background, don't initialize Unity\n" +
+                    "    // this happens if app uses location fence, notifications with content/actions, ...\n" +
+                    "    // initUnityWithApplication: initializes rendering, possibly loads scene and calls Start(), none meant for background\n" +
+                    "    if (UIApplication.sharedApplication.applicationState == UIApplicationStateBackground)\n" +
+                    "        return YES;\n\n" +
+                    "    [self initUnityWithApplication: application];\n",
+                    "    // Window/graphics startup belongs to sceneWillEnterForeground, after UIKit connects the scene.\n");
+                controller = ReplaceOnce(controller,
+                    "- (void)initUnityWithApplication:(UIApplication*)application\n{\n    if (_unityEngineInitialized)\n        return;\n",
+                    "- (void)initUnityWithScene:(UIWindowScene*)scene\n{\n" +
+                    "    if (scene == nil) return;\n" +
+                    "    if (_unityEngineInitialized)\n    {\n" +
+                    "        // A disconnected scene may be replaced without reloading the Unity runtime.\n" +
+                    "        if (_window.windowScene != scene)\n        {\n" +
+                    "            _window.windowScene = scene;\n            [_window makeKeyAndVisible];\n        }\n" +
+                    "        return;\n    }\n" +
+                    "    UIApplication* application = UIApplication.sharedApplication;\n");
+                controller = ReplaceOnce(controller,
+                    "#if !PLATFORM_VISIONOS\n" +
+                    "    if (@available(iOS 13, tvOS 13, *))\n" +
+                    "        _window = [[UIWindow alloc] initWithWindowScene: [self pickStartupWindowScene: application.connectedScenes]];\n" +
+                    "    else\n        _window = [[UIWindow alloc] initWithFrame: [UIScreen mainScreen].bounds];\n" +
+                    "#else\n    _window = [[UIWindow alloc] init]; \n#endif",
+                    "    _window = [[UIWindow alloc] initWithWindowScene: scene];");
+                controller = ReplaceOnce(controller, "        [self initUnityWithApplication: application];",
+                    "        [self initUnityWithScene: [self pickStartupWindowScene: application.connectedScenes]];");
+                header = ReplaceOnce(header, "- (void)preStartUnity;", "- (void)preStartUnity;\n\n" +
+                    "// OpenFusion Pocket: explicit connected-scene startup, using the original .62 runtime.\n" +
+                    "- (void)initUnityApplicationNoGraphics;\n- (void)initUnityWithScene:(UIWindowScene*)scene;");
+                controller = Marker + "\n" + controller;
+            }
+            if (controller.Contains("initUnityWithApplication:") || !header.Contains("- (void)initUnityWithScene:(UIWindowScene*)scene;"))
+                throw new InvalidDataException("Incomplete UIScene backport; export a fresh project from the pinned Unity editor.");
+
+            string ui = Path.Combine(output, "Classes", "UI");
+            string viewPath = Path.Combine(ui, "UnityView.mm");
+            string viewHandlingPath = Path.Combine(ui, "UnityAppController+ViewHandling.mm");
+            // Live resize/rendering must follow the screen attached to this scene.
+            // The initial unattached-view frame remains owned by Unity; UIKit's
+            // autoresizing later supplies its real bounds. Keep a preattach fallback.
+            string view = ReplaceOrVerify(Normalize(File.ReadAllText(viewPath)),
+                "    float requestedContentScaleFactor = UnityScreenScaleFactor([UIScreen mainScreen]);",
+                "    float requestedContentScaleFactor = UnityScreenScaleFactor(self.window.windowScene.screen ?: self.window.screen ?: [UIScreen mainScreen]);");
+            string viewHandling = ReplaceOrVerify(Normalize(File.ReadAllText(viewHandlingPath)),
+                "    _unityView.contentScaleFactor   = UnityScreenScaleFactor([UIScreen mainScreen]);",
+                "    _unityView.contentScaleFactor   = UnityScreenScaleFactor(_window.windowScene.screen ?: _window.screen ?: [UIScreen mainScreen]);");
+
+            string sceneHeader = File.ReadAllText(Path.Combine(templates, "UnityScene.h.txt"));
+            string sceneSource = File.ReadAllText(Path.Combine(templates, "UnityScene.mm.txt"));
+            string plistPath = Path.Combine(output, "Info.plist");
+            var plist = new XmlDocument { XmlResolver = null }; plist.Load(plistPath);
+            var root = plist.SelectSingleNode("/plist/dict") as XmlElement;
+            if (root == null) throw new InvalidDataException("Expected the generated iOS Info.plist dictionary.");
+            ConfigureSceneManifest(root);
+            // All source matching and template/plist parsing happens before export files change.
+            WriteChanged(headerPath, header);
+            WriteChanged(controllerPath, controller);
+            WriteChanged(viewPath, view);
+            WriteChanged(viewHandlingPath, viewHandling);
+            Directory.CreateDirectory(ui);
+            WriteChanged(Path.Combine(ui, "UnityScene.h"), sceneHeader);
+            WriteChanged(Path.Combine(ui, "UnityScene.mm"), sceneSource);
+            if (plist.DocumentType != null) plist.RemoveChild(plist.DocumentType);
+            plist.Save(plistPath);
+#if UNITY_IOS
+            string projectPath = PBXProject.GetPBXProjectPath(output);
+            var project = new PBXProject(); project.ReadFromFile(projectPath);
+            string target = project.GetUnityFrameworkTargetGuid();
+            foreach (string file in new[] { "Classes/UI/UnityScene.h", "Classes/UI/UnityScene.mm" })
+            {
+                string guid = project.FindFileGuidByProjectPath(file);
+                if (string.IsNullOrEmpty(guid)) guid = project.AddFile(file, file, PBXSourceTree.Source);
+                if (file.EndsWith(".mm", StringComparison.Ordinal)) project.AddFileToBuild(target, guid);
+            }
+            project.WriteToFile(projectPath);
+#endif
+        }
+
+        static string Normalize(string value) { return value.Replace("\r\n", "\n"); }
+        static string ReplaceOrVerify(string source, string before, string after)
+        {
+            int index = source.IndexOf(after, StringComparison.Ordinal);
+            if (index < 0) return ReplaceOnce(source, before, after);
+            if (source.Contains(before) || source.IndexOf(after, index + after.Length, StringComparison.Ordinal) >= 0)
+                throw new InvalidDataException("The Unity iOS display scale adaptation is incomplete or ambiguous. No native source has been changed; use a fresh export.");
+            return source;
+        }
+        static string ReplaceOnce(string source, string before, string after)
+        {
+            int index = source.IndexOf(before, StringComparison.Ordinal);
+            if (index < 0 || source.IndexOf(before, index + before.Length, StringComparison.Ordinal) >= 0)
+                throw new InvalidDataException("The Unity iOS trampoline does not match the pinned .62 startup layout. No native source has been changed; use a fresh export.");
+            return source.Substring(0, index) + after + source.Substring(index + before.Length);
+        }
+        static void WriteChanged(string path, string value)
+        {
+            if (!File.Exists(path) || File.ReadAllText(path) != value) File.WriteAllText(path, value);
+        }
+        static XmlElement Value(XmlElement dict, string key)
+        {
+            foreach (XmlNode node in dict.ChildNodes)
+                if (node.Name == "key" && node.InnerText == key)
+                {
+                    var next = node.NextSibling;
+                    while (next != null && !(next is XmlElement)) next = next.NextSibling;
+                    return next as XmlElement;
+                }
+            return null;
+        }
+        static XmlElement Put(XmlElement dict, string key, string type, string text = null)
+        {
+            var existing = Value(dict, key);
+            if (existing != null)
+            {
+                if (existing.Name != type) throw new InvalidDataException("Unexpected scene metadata type for " + key);
+                if (text != null) existing.InnerText = text;
+                return existing;
+            }
+            var doc = dict.OwnerDocument;
+            var name = doc.CreateElement("key"); name.InnerText = key; dict.AppendChild(name);
+            var value = doc.CreateElement(type); if (text != null) value.InnerText = text; dict.AppendChild(value);
+            return value;
+        }
+        static void ConfigureSceneManifest(XmlElement root)
+        {
+            var manifest = Put(root, "UIApplicationSceneManifest", "dict");
+            Put(manifest, "UIApplicationSupportsMultipleScenes", "false");
+            var configurations = Put(manifest, "UISceneConfigurations", "dict");
+            var application = Put(configurations, "UIWindowSceneSessionRoleApplication", "array");
+            if (!application.HasChildNodes)
+            {
+                var scene = application.OwnerDocument.CreateElement("dict"); application.AppendChild(scene);
+                Put(scene, "UISceneConfigurationName", "string", "Default Configuration");
+                Put(scene, "UISceneDelegateClassName", "string", "UnityScene");
+            }
+            var first = application.SelectSingleNode("*[1]") as XmlElement;
+            if (first == null || first.Name != "dict" || Value(first, "UISceneDelegateClassName")?.InnerText != "UnityScene")
+                throw new InvalidDataException("Existing scene metadata uses a different delegate. The .62 backport does not replace custom lifecycle configuration.");
+        }
+    }
+}
