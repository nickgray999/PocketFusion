+// Capture the actual glyph draw calls. No rendering engine is needed for layout.
+namespace OpenFusion
+{
+    static class Loc { public static string T(string value) => value == "translated" ? "Fusion Fall" : value; }
+}
+namespace UnityEngine
+{
+    public readonly record struct Vector2(float x, float y);
+    public readonly record struct Rect(float x, float y, float width, float height);
+    public readonly record struct Color(float r, float g, float b, float a)
+    { public static Color white => new(1, 1, 1, 1); }
+    public class RectOffset { public int left, right, top, bottom; }
+    public enum TextAnchor { UpperLeft, UpperCenter, UpperRight, MiddleLeft, MiddleCenter, MiddleRight, LowerLeft, LowerCenter, LowerRight }
+    public enum EventType { Repaint, Layout }
+    public class Event { public static Event current = new(); public EventType type; }
+    public static class GUI
+    {
+        public static Color color = Color.white;
+        public static readonly List<(Rect dst, Rect uv, Color tint)> Quads = new();
+        public static void DrawTextureWithTexCoords(Rect dst, Texture2D texture, Rect uv, bool blend)
+        { Quads.Add((dst, uv, color)); }
+    }
+    public static class Mathf
+    {
+        public static float Max(float a, float b) => MathF.Max(a, b);
+        public static float Floor(float x) => MathF.Floor(x);
+        public static int RoundToInt(float x) => (int)MathF.Round(x);
+    }
+    public enum FilterMode { Bilinear }
+    public enum TextureWrapMode { Clamp }
+    public enum FontStyle { Normal }
+    public class Texture2D { public FilterMode filterMode; public TextureWrapMode wrapMode; }
+    public class TextAsset { public string text; }
+    public static class Resources { public static T Load<T>(string path) where T : class => null; }
+    public static class Debug { public static void LogWarning(string text) { } }
+    public class Shader { public static Shader Find(string name) => null; }
+    public class Material { public Material(Shader shader) {} public Texture2D mainTexture; public Color color; }
+    public class Font { public string name; public Material material; public CharacterInfo[] characterInfo; }
+    public struct CharacterInfo
+    {
+        public int index, advance, minX, maxX, minY, maxY, glyphWidth, glyphHeight, bearing, size;
+        public Vector2 uvBottomLeft, uvBottomRight, uvTopLeft, uvTopRight;
+        public FontStyle style;
+    }
+}
diff --git a/tests/IOSInputChecks/README.md b/tests/IOSInputChecks/README.md
new file mode 100644
index 0000000..9b14d6d
--- /dev/null
+++ b/tests/IOSInputChecks/README.md
@@ -0,0 +1,133 @@
+# iPhone touch regression
+
+`Assets/Editor/IOSInputChecks.cs` drives the real `TouchControls.ProcessTouches`
+state machine with synthetic Unity touches. It checks simultaneous movement and
+look, held movement without look or pinch, stationary camera ownership, stable
+roles across the divider, an extra left finger, reused finger IDs, action
+ownership, HUD exclusion, blocked UI, cancel,
+missing fingers, surface changes, and leaving gameplay. It also checks all 15
+optional iPhone action cells, the five-cell vertical left rail and chat placement
+beside that rail across 48 viewport/scale cases. Real Unity physics fixtures call
+the production camera-floor and own-spawn correction helpers with nearby floors,
+a roof, ignored triggers/actor colliders and higher terrain. Local terrain-height
+checks cover bounded step/skin correction and missing terrain.
+
+Camera-thumbstick checks cover the radial dead zone and fine-control curve,
+independent horizontal/vertical rates, continuous three-second holds at
+30/60/120 Hz, simultaneous movement, sticky ownership across action buttons,
+release/cancel/lost fingers, UI/surface cancellation, HUD ownership and free-drag
+fallback. Default placement clears all optional action cells and the Nano wheel
+at scaled and unscaled UI settings across the viewport cases.
+
+The updated input suite passed **13,915 assertions**, including right-camera
+thumbstick controls and placement. The production Unity
+`IOSThirdPersonChecks` fixture passed another **10,793 assertions**, covering
+three-second forward/backward/strafe holds at 30/60 Hz with right-thumb turns,
+analog speed, diagonal normalization, direct pivot following, 180-degree orbit
+reversals, owned body/equipment filtering and real sphere-cast wall handling,
+including a saturated 32-hit buffer. The standalone production rig suite at
+`tests/TouchCameraFollowTest` passed **4,749 assertions** for body framing,
+third-person zoom limits and invalid requests. The right-camera thumbstick
+revision passed Unity export with zero errors and both terrain-physics
+registrations retained, native Release compilation, strict
+deep signature verification, in-place phone installation and launch. Its signed
+archive is saved at `Builds/iPhone/PocketFusion-iPhone-Development.ipa`. It also
+entered the Retrobution world and passed a physical continuous-turn test; the
+user confirmed the new LOOK control feels better.
+
+Run from a clean, nonsynced Unity checkout with no scene or running game instance:
+
+```sh
+"/Applications/Unity/Hub/Editor/2022.3.62f3/Unity.app/Contents/MacOS/Unity" \
+  -batchmode -nographics -buildTarget iOS -projectPath "$PWD" \
+  -executeMethod OpenFusion.EditorTools.IOSInputChecks.Batch \
+  -logFile Logs/unity-ios-input-checks.log
+```
+
+The command exits nonzero on a failed assertion and writes the result to
+`Logs/ios-input-regression-results.txt`. It restores in-memory touch preferences
+and does not write PlayerPrefs. Pair it with `IOSViewportChecks.Batch` for the
+existing HUD/viewport coverage. Run `OpenFusion.EditorTools.IOSThirdPersonChecks.Batch`
+in the same command to run both the input suite and the production movement/camera
+physics fixture. Pair these with the standalone `TouchCameraFollowTest` for
+body framing and zoom limits. Movement uses the current camera yaw each frame;
+the previous movement-driven camera follow has been removed. These checks do
+not replace a physical iPhone play test of control feel.
+
+The iPhone 14 Pro Max/iOS 27.2 tests entered the Retrobution world and
+confirmed that the vertical rail stays visible over Bag, Journal and the full
+Map, with switching between those panels working. Chat opens beside the rail
+without opening the keyboard and collapses; Menu shows a LOG OUT confirmation
+with CANCEL, and confirming logout returns to the PocketFusion server list.
+The lower body-sized rig, corrected City Station terrain collision, jump/landing
+and second world entry have passed physical checks. The user subsequently
+reported that holding a direction made the camera become first person and asked
+for WASD-style movement. The new source removes movement-driven orbit, follows
+the live pivot directly, clamps user-selected zoom above twice body height and
+filters the local body/equipment from camera obstruction checks. World walls
+can still shorten the camera distance. The exact cause of the reported collapse
+has not been established. This revision authenticated, displayed character
+selection and entered the world on the phone, with the full avatar visible.
+Its initial live log reported requested and actual orbit distances both 4.54 m,
+no obstruction, 8-degree pitch, the body renderer enabled and its centre at
+viewport (0.50, 0.46). Two subsequent physical samples after more than a second
+of held movement also retained 4.54 m with no obstruction and body centre near
+viewport (0.50, 0.45), including a changed yaw/pitch during right-thumb adjustment.
+The user confirmed that the revised WASD movement “Feels good!” and requested
+easier camera turning without repeated swipes. A default right camera thumbstick
+is installed, with a centre dead zone, gentle fine-control response and
+continuous turning while held; direct drag remains available elsewhere. Its
+fallback stays in the safe right half, clear of default actions and the Nano
+wheel, including the small unscaled-HUD case. Custom geometry is retained. The
+thumbstick revision passed updated input checks, Unity export, native Release
+compilation, signing, installation, launch and Retrobution world entry. The
+LOOK pad was visible beside Swap/Jump. Holding a fixed off-centre point for
+1.8 seconds turned the camera continuously while the character stayed
+stationary and fully visible. The user confirmed “Yes, this feels better.”
+Two iOS memory warnings followed the previous second world entry without
+termination; sustained memory, thermal and frame-time improvements remain
+unmeasured.
+
+## October 28 efficiency regression
+
+`Assets/Editor/IOSEfficiencyChecks.cs` runs the existing input and camera suites
+against the collection/style reuse changes, then exercises the production
+count-aware touch path. **18 new assertions** cover a shrinking or empty live
+prefix with poisoned old entries, Unity compacting surviving fingers, missing
+and reused finger IDs, stale LOOK/action ownership and one-frame action edges.
+The existing **13,915 input** and **10,793 camera** assertions also pass.
+
+Run it from the same clean Unity checkout with:
+
+```sh
+"/Applications/Unity/Hub/Editor/2022.3.62f3/Unity.app/Contents/MacOS/Unity" \
+  -batchmode -nographics -buildTarget iOS -projectPath "$PWD" \
+  -executeMethod OpenFusion.EditorTools.IOSEfficiencyChecks.Batch \
+  -logFile Logs/unity-ios-efficiency-checks.log
+```
+
+The fixture writes `Logs/ios-efficiency-results.txt` and restores the temporary
+touch preferences. Warmed idle, movement/drag, pinch and held-action scenarios
+preserve their production input state. The allocation counter is tested first
+with a retained 4,096-byte allocation. In the tested Editor runtime it reported
+zero for that probe, so every allocation result is **UNAVAILABLE**. No
+allocation-free touch or HUD claim follows from this run. Supplying
+`-requireAllocationFree` enforces measurement only when the counter passes its
+sanity probe; an unavailable counter makes that strict run fail.
+
+The separate `Tests/WorldColorAllocationTest` uses .NET 8's working counter and
+the production interpolation/registry methods. It passed **315,852 assertions**
+with bit-identical output and measured **35.2 MB before versus zero after** for
+100,000 warmed colour/streaming samples. That result belongs to the standalone
+world path, not to Unity touch handling or physical iPhone performance.
+
+The October 28 candidate passed a zero-error Unity export retaining terrain
+physics, native ARM64 Release compilation, strict deep signature verification
+and archive CRC/app-identifier checks. Its archive is
+`Builds/iPhone/PocketFusion-Efficiency-iPhone-Development.ipa`, with
+`Builds/iPhone/validation-efficiency.json`, separate from the October 27
+user-endorsed controls archive. The candidate installed in place on October 28
+with its original bundle identifier and app data retained. Saved Retrobution
+login and character selection passed visual and console checks. Candidate world
+entry and controls, heat, frame times and repeated-session memory remain pending
+on the connected iPhone.
