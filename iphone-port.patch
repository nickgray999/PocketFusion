diff --git a/Assets/Scripts/OpenFusion/Screens/LauncherScreen.Keyboard.cs b/Assets/Scripts/OpenFusion/Screens/LauncherScreen.Keyboard.cs
new file mode 100644
index 0000000..447d061
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/Screens/LauncherScreen.Keyboard.cs
@@ -0,0 +1,122 @@
+using UnityEngine;
+
+namespace OpenFusion.Screens
+{
+    public sealed partial class LauncherScreen
+    {
+        readonly LauncherKeyboardState nativeKeyboardState = new LauncherKeyboardState();
+        int nativeKeyboardTouchFrame = -1;
+        bool nativeHideInputSaved, nativeHideInput;
+        bool UsesNativeLauncherKeyboard => Application.platform == RuntimePlatform.IPhonePlayer;
+        bool NativeKeyboardInCurrentScope => UsesNativeLauncherKeyboard && nativeKeyboardState.Scope == NavigationScope;
+
+        void ReleaseLauncherKeyboardHandle()
+        {
+            if (navKeyboard != null) navKeyboard.active = false;
+            navKeyboard = null; navKeyboardName = null;
+            if (nativeHideInputSaved) { TouchScreenKeyboard.hideInput = nativeHideInput; nativeHideInputSaved = false; }
+        }
+        void CloseLauncherKeyboard(bool discard)
+        {
+            if (discard) nativeKeyboardState.Clear();
+            else
+            {
+                PollLauncherKeyboard();
+                nativeKeyboardState.Finish(false);
+            }
+            ReleaseLauncherKeyboardHandle();
+        }
+        void PollLauncherKeyboard()
+        {
+            if (!nativeKeyboardState.Editing || navKeyboard == null) return;
+            if (!Visible || nativeKeyboardState.Scope != NavigationScope)
+            { nativeKeyboardState.Clear(); ReleaseLauncherKeyboardHandle(); return; }
+            var status = navKeyboard.status;
+            nativeKeyboardState.Update(navKeyboard.text, status != TouchScreenKeyboard.Status.Visible,
+                status == TouchScreenKeyboard.Status.Canceled);
+            if (!nativeKeyboardState.Editing) ReleaseLauncherKeyboardHandle();
+        }
+        void ForgetLauncherKeyboardField(string field)
+        {
+            bool owned = nativeKeyboardState.Field == field;
+            nativeKeyboardState.Forget(field);
+            if (owned) ReleaseLauncherKeyboardHandle();
+        }
+        bool NativeFieldPressed(Rect rect)
+        {
+            var e = Event.current;
+            if (nativeKeyboardTouchFrame == Time.frameCount)
+            {
+                if (e.type == EventType.MouseDown && e.button == 0) e.Use();
+                return false;
+            }
+            if (e.type == EventType.MouseDown && e.button == 0 && rect.Contains(e.mousePosition))
+            {
+                nativeKeyboardTouchFrame = Time.frameCount;
+                e.Use(); GUIUtility.hotControl = 0; return true;
+            }
+            // Some scene-based iOS configurations deliver real touches without
+            // the first touch's synthetic IMGUI MouseDown. Use the same scaled
+            // screen rectangle as launcher navigation, including scroll offsets.
+            Rect screenRect = NavigationScreenRect(rect);
+            screenRect.position += UiKit.CanvasOrigin;
+            for (int i = 0; i < UnityEngine.Input.touchCount; i++)
+            {
+                var touch = UnityEngine.Input.GetTouch(i);
+                if (touch.phase != TouchPhase.Began || !screenRect.Contains(new Vector2(touch.position.x, Screen.height - touch.position.y))) continue;
+                nativeKeyboardTouchFrame = Time.frameCount; GUIUtility.hotControl = 0; return true;
+            }
+            return false;
+        }
+        string NativeLauncherInput(Rect rect, string value, int max, string name, bool secure, string placeholder)
+        {
+            if (nativeKeyboardState.Scope != NavigationScope)
+            {
+                if (nativeKeyboardState.Editing) ReleaseLauncherKeyboardHandle();
+                nativeKeyboardState.ChangeScope(NavigationScope);
+            }
+            PollLauncherKeyboard();
+            value = nativeKeyboardState.Value(NavigationScope, name, value);
+            bool enabled = inputOn && GUI.enabled;
+            bool pressed = enabled && NativeFieldPressed(rect);
+            bool navigated = NavigateControl(rect, "field:" + name, enabled);
+            if ((pressed || navigated) && nativeKeyboardState.Field != name)
+            {
+                // Poll the old owner before switching, including when the next
+                // field is drawn before the old one in this IMGUI pass.
+                PollLauncherKeyboard();
+                ReleaseLauncherKeyboardHandle();
+                nativeKeyboardState.Begin(NavigationScope, name, value, max, secure);
+                if (!nativeHideInputSaved) { nativeHideInput = TouchScreenKeyboard.hideInput; nativeHideInputSaved = true; }
+                TouchScreenKeyboard.hideInput = false;
+                try
+                {
+                    navKeyboard = TouchScreenKeyboard.Open(nativeKeyboardState.Text, TouchScreenKeyboardType.ASCIICapable,
+                        false, false, secure, false, "", max);
+                }
+                catch (System.Exception e)
+                {
+                    // Account text and exception messages never enter diagnostics.
+                    Debug.LogWarning("[launcher] Native keyboard unavailable: " + e.GetType().Name);
+                    Toast("error", "Could not open the keyboard. Tap the field again.");
+                }
+                navKeyboardName = name;
+                if (navKeyboard == null) { nativeKeyboardState.Finish(false); ReleaseLauncherKeyboardHandle(); }
+            }
+            value = nativeKeyboardState.Value(NavigationScope, name, value);
+            bool focused = nativeKeyboardState.Field == name;
+            // Explicit native editing avoids Unity opening a second automatic
+            // keyboard for an IMGUI TextField/PasswordField in a window scene.
+            if (Event.current.type == EventType.Repaint)
+            {
+                string display = secure ? new string('*', value.Length) : value;
+                stField.Draw(rect, new GUIContent(display), rect.Contains(Event.current.mousePosition), false, false, focused);
+            }
+            if (placeholder != null && string.IsNullOrEmpty(value) && !focused)
+                Lbl(new Rect(rect.x + 8, rect.y, rect.width - 16, rect.height), placeholder, stField.fontSize, A(CGray, .7f));
+            return value;
+        }
+        void OnDisable() { CloseLauncherKeyboard(true); }
+        void OnApplicationPause(bool paused) { if (paused) CloseLauncherKeyboard(false); }
+    }
+}
