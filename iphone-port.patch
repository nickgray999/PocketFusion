@@ -0,0 +1,61 @@
+using OpenFusion.Screens;
+
+int checks = 0;
+void Require(bool ok, string why) { checks++; if (!ok) throw new InvalidOperationException(why); }
+var keyboard = new LauncherKeyboardState();
+const string login = "Home:Login:10", otherServer = "Home:Login:11", register = "Home:Login:10:Register";
+Require(keyboard.Begin(login, "user", "start", 8, false), "Opening a field starts one edit.");
+Require(keyboard.Editing && keyboard.Field == "user" && keyboard.Scope == login && keyboard.Limit == 8 && !keyboard.Secure, "Owner includes form, field, limit and secure mode.");
+Require(!keyboard.Begin(login, "user", "stale", 8, false), "Repeated taps on the same active field must not open another keyboard.");
+Require(keyboard.Text == "start", "Repeated taps must not overwrite the current edit.");
+keyboard.Update("new-value-too-long", false, false);
+Require(keyboard.Text == "new-valu", "Native input must obey the UTF-16 field limit.");
+Require(keyboard.Value(login, "user", "old") == "new-valu", "An active edit is visible in its owning field.");
+Require(keyboard.Begin(login, "pass", "pw-start", 16, true), "Switching fields starts the new owner.");
+Require(keyboard.Field == "pass" && keyboard.Secure && keyboard.Text == "pw-start", "A password edit must retain secure mode.");
+Require(keyboard.Value(login, "user", "old") == "new-valu", "Switching fields must preserve the old owner's latest input.");
+Require(keyboard.Value(login, "user", "fallback") == "fallback", "A completed value must be delivered only once.");
+keyboard.Update("pw-edit", false, false);
+keyboard.Begin(login, "user", "new-valu", 8, false);
+Require(keyboard.Value(login, "pass", "stale") == "pw-edit", "Switching to an earlier-drawn field must preserve a later-drawn field's last edit.");
+keyboard.Update("commit", true, false);
+Require(!keyboard.Editing && keyboard.Field == null && keyboard.Text == "", "Done must release the active owner.");
+Require(keyboard.Value(login, "user", "old") == "commit", "Done must commit the latest bounded value.");
+keyboard.Begin(login, "user", "commit", 8, false);
+keyboard.Update("discard", true, true);
+Require(!keyboard.Editing, "Cancel must release the active owner.");
+Require(keyboard.Value(login, "user", "old") == "commit", "Cancel must restore the value from before editing.");
+keyboard.Begin(login, "pass", "pw-start", 16, true);
+keyboard.Update("pw-draft", false, false);
+keyboard.Finish(false);
+Require(keyboard.Value(login, "pass", "old") == "pw-draft", "Dismissal/field switch must commit without needing a later GUI repaint first.");
+keyboard.Begin(login, "pass", "pw-start", 16, true);
+keyboard.Update("pw-private", true, false);
+keyboard.ChangeScope(register);
+Require(keyboard.Value(register, "pass", "empty") == "empty", "Login values must not leak into a registration form.");
+keyboard.Begin(login, "user", "account", 8, false);
+keyboard.Update("edited", false, false);
+keyboard.Begin(otherServer, "user", "other", 8, false);
+Require(keyboard.Text == "other" && keyboard.Scope == otherServer, "A different server's identical field name must start fresh.");
+Require(keyboard.Value(otherServer, "pass", "empty") == "empty", "Form replacement must clear previous pending values.");
+keyboard.Begin(login, "pass", "pw-saved", 16, true);
+keyboard.Finish(false);
+keyboard.Forget("pass");
+Require(keyboard.Value(login, "pass", "cleared") == "cleared", "Changing remembered username must not restore a queued saved password.");
+keyboard.Begin(login, "pass", "pw-saved", 16, true);
+keyboard.Forget("pass");
+Require(!keyboard.Editing && keyboard.Text == "" && !keyboard.Secure, "Forgetting an active saved credential must release its edit.");
+keyboard.Begin(login, "pass", "pw-start", 16, true);
+keyboard.Update("pw-draft", false, false);
+keyboard.Clear();
+Require(!keyboard.Editing && keyboard.Scope == null && keyboard.Field == null && keyboard.Text == "" && !keyboard.Secure, "Launcher exit/destruction must discard keyboard-owned state.");
+Require(keyboard.Value(login, "pass", "cleared") == "cleared", "Closing the launcher must also discard completed edits.");
+for (int i = 0; i < 20; i++)
+{
+    string scope = "Login:" + i;
+    keyboard.Begin(scope, "user", "user" + i, 64, false);
+    keyboard.Update("typed" + i, true, false);
+    Require(keyboard.Value(scope, "user", "") == "typed" + i, "Repeated login cycles must deliver each current form's completed edit.");
+    keyboard.Clear();
+}
+Console.WriteLine($"PASS: {checks} keyboard ownership/lifecycle assertions. Native iOS presentation still requires a phone.");
