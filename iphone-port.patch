diff --git a/Assets/Scripts/OpenFusion/GameClient.SpawnSupport.cs b/Assets/Scripts/OpenFusion/GameClient.SpawnSupport.cs
new file mode 100644
index 0000000..4444970
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/GameClient.SpawnSupport.cs
@@ -0,0 +1,180 @@
+using System;
+using UnityEngine;
+using OpenFusion.Net;
+using OpenFusion.Screens;
+using OpenFusion.World;
+
+namespace OpenFusion
+{
+    public sealed partial class GameClient
+    {
+        readonly SpawnSupportGate spawnSupport = new SpawnSupportGate();
+        WorldEntities supportEntities;
+        Action<GameObject, EnterSucc> ownedSupportSpawn;
+        Transform supportPlayer;
+        Vector3 supportPosition;
+        int supportTicket, supportOwnerGeneration;
+        bool supportFailureShown, supportLoadingShown, supportProbeReported;
+        bool IPhoneSupportEnabled => Application.platform == RuntimePlatform.IPhonePlayer;
+        bool IPhoneMovementBlocked => IPhoneSupportEnabled && (!WorldConnected || tpPending || !spawnSupport.Ready
+            || WorldBootstrap.Travelling || supportPlayer == null);
+
+        void BindIPhoneSpawnSupport()
+        {
+            if (!IPhoneSupportEnabled) return;
+            var current = Bootstrap != null ? Bootstrap.Entities : null;
+            if (ReferenceEquals(current, supportEntities)) return;
+            UnbindIPhoneSpawnSupport();
+            supportEntities = current;
+            if (current == null) return;
+            int owner = supportOwnerGeneration;
+            ownedSupportSpawn = (go, snapshot) =>
+            {
+                if (this == null || owner != supportOwnerGeneration || Bootstrap == null
+                    || !ReferenceEquals(Bootstrap.Entities, current) || current.Self != go || go == null) return;
+                BeginIPhoneSpawnSupport(go.transform,
+                    PlayerAvatarFactory.ToClient(snapshot.Self.X, snapshot.Self.Y, snapshot.Self.Z));
+            };
+            current.SelfSpawned += ownedSupportSpawn;
+        }
+
+        void UnbindIPhoneSpawnSupport()
+        {
+            supportOwnerGeneration++;
+            if (supportEntities != null && ownedSupportSpawn != null) supportEntities.SelfSpawned -= ownedSupportSpawn;
+            supportEntities = null; ownedSupportSpawn = null;
+            supportPlayer = null;
+            spawnSupport.Invalidate();
+        }
+
+        void BeginIPhoneSpawnSupport(Transform player, Vector3 authoritativePosition)
+        {
+            if (!IPhoneSupportEnabled || player == null) return;
+            supportPlayer = player; supportPosition = authoritativePosition;
+            supportTicket = spawnSupport.Begin(authoritativePosition.y);
+            supportFailureShown = supportLoadingShown = supportProbeReported = false;
+            HoldIPhoneSpawnSupport();
+            GetComponent<TouchControls>()?.CancelForSurfaceChange();
+            Report("[world] holding authoritative spawn until destination support is verified: " + authoritativePosition);
+        }
+
+        void HoldIPhoneSpawnSupport()
+        {
+            if (!IPhoneSupportEnabled || supportPlayer == null || spawnSupport.Ready) return;
+            bool enabled = cc != null && cc.transform == supportPlayer && cc.enabled;
+            if (enabled) cc.enabled = false;
+            supportPlayer.position = supportPosition;
+            if (enabled) cc.enabled = true;
+            Physics.SyncTransforms();
+            lastPos = supportPosition; moving = airborne = ccGrounded = false;
+            vy = dashT = 0f;
+            lastSendT = Time.time; nextSend = Time.time + SendInterval;
+        }
+
+        // Returns true while movement must remain blocked, including the release
+        // frame. The controller starts settling only on the next validated frame.
+        bool WaitForIPhoneSpawnSupport(Transform player)
+        {
+            if (!IPhoneSupportEnabled) return false;
+            if (!WorldConnected) return true;
+            var own = Bootstrap != null && Bootstrap.Entities != null ? Bootstrap.Entities.Self : null;
+            if (own == null || own.transform != player) return true;
+            if (supportPlayer != player)
+            {
+                // The SelfSpawned event normally supplies the exact snapshot. This
+                // fallback covers a snapshot drained before the callback was bound.
+                var initial = Shard_.Enter.Self;
+                BeginIPhoneSpawnSupport(player, PlayerAvatarFactory.ToClient(initial.X, initial.Y, initial.Z));
+            }
+            if (spawnSupport.Ready) return false;
+            HoldIPhoneSpawnSupport();
+            EnsureCC(player); // Establish the actual controller's collision-layer rules before verifying support.
+            if (PlayerLife.Active)
+            {
+                // A defeated character can be saved below the map. Keep gravity
+                // and movement held, but leave the normal server-approved revive
+                // UI/clock and REGEN request available instead of timing them out.
+                spawnSupport.Evaluate(supportTicket, false, false, 0f, false, 0f, Time.unscaledTime);
+                if (supportLoadingShown) { LoadingScreen.Ensure().Hide(); supportLoadingShown = false; }
+                return true;
+            }
+            DongGrid.Cell(supportPosition.x, supportPosition.z, out int x, out int y);
+            bool mapReady = !WorldBootstrap.Travelling && Bootstrap.Loader != null && Bootstrap.Loader.IsDongLoaded(x, y);
+            bool found = false, wet = false; float surface = supportPosition.y;
+            if (mapReady) found = TryIPhoneSpawnSupport(supportPosition, player, CcSlope, out surface, out wet);
+            if (mapReady && !supportProbeReported) { supportProbeReported = true; ReportIPhoneSpawnSupport(player, found, surface, wet); }
+            var result = spawnSupport.Evaluate(supportTicket, mapReady, found && !wet, surface, found && wet, surface, Time.unscaledTime);
+            if (result == SpawnSupportGate.Result.Ready)
+            {
+                var settled = supportPosition; settled.y = spawnSupport.ResolvedHeight;
+                bool enabled = cc != null && cc.transform == player && cc.enabled;
+                if (enabled) cc.enabled = false;
+                player.position = settled;
+                if (enabled) cc.enabled = true;
+                Physics.SyncTransforms(); lastPos = settled;
+                if (supportLoadingShown) LoadingScreen.Ensure().Hide();
+                GetComponent<TouchControls>()?.CancelForSurfaceChange();
+                Report("[world] destination support verified at " + surface.ToString("F2") + "m" + (wet ? " (water)" : ""));
+            }
+            else if (result == SpawnSupportGate.Result.Failed && !supportFailureShown)
+            {
+                supportFailureShown = true;
+                StartupFailed("The destination floor could not be verified. Movement was stopped to protect your character. Return to the launcher and try again after the map issue is fixed.");
+            }
+            else if (!supportLoadingShown)
+            {
+                supportLoadingShown = true;
+                LoadingScreen.Ensure().ShowStage("VERIFYING DESTINATION FLOOR");
+            }
+            return true;
+        }
+
+        internal static bool TryIPhoneSpawnSupport(Vector3 position, Transform player, float slope, out float surface, out bool wet)
+        {
+            Physics.SyncTransforms();
+            bool floorFound = false; float floor = position.y, nearest = float.PositiveInfinity;
+            int actorLayer = player != null ? player.gameObject.layer : 0;
+            // A ray can hit a collider whose layer pair ignores the controller.
+            // Such geometry is visible to a query but cannot stop an actual fall.
+            var hits = Physics.RaycastAll(position + Vector3.up * (SpawnSupportGate.MaxRise + .02f), Vector3.down,
+                SpawnSupportGate.MaxRise + SpawnSupportGate.MaxDrop + .04f, ~((1 << 2) | (1 << 30)), QueryTriggerInteraction.Ignore);
+            foreach (var hit in hits)
+            {
+                if (hit.collider == null || hit.collider is CharacterController || player != null
+                    && (hit.transform == player || hit.transform.IsChildOf(player))) continue;
+                if (Physics.GetIgnoreLayerCollision(actorLayer, hit.collider.gameObject.layer)
+                    || hit.normal.y < Mathf.Cos(slope * Mathf.Deg2Rad)) continue;
+                if (!SpawnSupportGate.TryChooseSurface(position.y, true, hit.point.y, false, 0f, out _, out _)) continue;
+                float distance = Mathf.Abs(hit.point.y - position.y);
+                if (distance >= nearest) continue;
+                floorFound = true; nearest = distance; floor = hit.point.y;
+            }
+            bool waterFound = WaterSurface.TryGetSurface(position, out float water)
+                && !Physics.GetIgnoreLayerCollision(actorLayer, WaterSurface.WaterLayer);
+            return SpawnSupportGate.TryChooseSurface(position.y, floorFound, floor, waterFound, water, out surface, out wet);
+        }
+
+        void ReportIPhoneSpawnSupport(Transform player, bool found, float surface, bool wet)
+        {
+            var report = new System.Text.StringBuilder("[world-support] feet=" + supportPosition + " found=" + found
+                + " support=" + surface.ToString("F3") + " water=" + wet + " playerLayer=" + player.gameObject.layer
+                + " controller=" + (cc != null ? "enabled=" + cc.enabled + " layer=" + cc.gameObject.layer : "not-created"));
+            report.Append(" | ").Append(Ground.Describe(supportPosition));
+            foreach (var terrain in Terrain.activeTerrains)
+            {
+                if (terrain == null || terrain.terrainData == null) continue;
+                var origin = terrain.transform.position; var size = terrain.terrainData.size;
+                if (supportPosition.x < origin.x || supportPosition.x > origin.x + size.x
+                    || supportPosition.z < origin.z || supportPosition.z > origin.z + size.z) continue;
+                var collider = terrain.GetComponent<TerrainCollider>();
+                report.Append(" | terrain=").Append(terrain.name).Append(" origin=").Append(origin).Append(" size=").Append(size)
+                    .Append(" sampleWorldY=").Append((terrain.SampleHeight(supportPosition) + origin.y).ToString("F3"))
+                    .Append(" layer=").Append(terrain.gameObject.layer).Append(" collisionIgnored=")
+                    .Append(Physics.GetIgnoreLayerCollision(player.gameObject.layer, terrain.gameObject.layer))
+                    .Append(" collider=").Append(collider != null).Append(" colliderEnabled=").Append(collider != null && collider.enabled)
+                    .Append(" colliderDataMatches=").Append(collider != null && collider.terrainData == terrain.terrainData);
+            }
+            Report(report.ToString());
+        }
+    }
+}
