diff --git a/Assets/Editor/IOSFoldPanelRenderCheck.cs b/Assets/Editor/IOSFoldPanelRenderCheck.cs
new file mode 100644
index 0000000..452df02
--- /dev/null
+++ b/Assets/Editor/IOSFoldPanelRenderCheck.cs
@@ -0,0 +1,140 @@
+using System;
+using System.Reflection;
+using OpenFusion.Screens;
+using OpenFusion.World;
+using UnityEditor;
+using UnityEngine;
+
+namespace OpenFusion.EditorTools
+{
+    // Run with a graphical Unity editor and -executeMethod OpenFusion.EditorTools.IOSFoldPanelRenderCheck.Run.
+    // Reads only this fixture's HostView backing surface. GUIToScreenPoint alone misses clipped or blank draws.
+    public sealed class IOSFoldPanelRenderCheck : EditorWindow
+    {
+        static readonly Rect Pane = new Rect(60, 230, 300, 190);
+        const float Scale = 1.7f;
+        const BindingFlags InstanceMembers = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+        static readonly Action<Vector2, float> SetMatrix = (Action<Vector2, float>)typeof(FoldScreenController)
+            .GetMethod("SetPanelMatrix", BindingFlags.Static | BindingFlags.NonPublic, null,
+                new[] { typeof(Vector2), typeof(float) }, null).CreateDelegate(typeof(Action<Vector2, float>));
+
+        int repaints, cardHits, backgroundHits;
+        double started;
+
+        public static void Run()
+        {
+            var window = CreateInstance<IOSFoldPanelRenderCheck>();
+            window.titleContent = new GUIContent("PocketFusion folded panel check");
+            window.position = new Rect(50, 50, 420, 460);
+            window.ShowUtility();
+            window.started = EditorApplication.timeSinceStartup;
+            EditorApplication.update += window.CheckFrame;
+        }
+
+        void OnGUI()
+        {
+            UiKit.Fill(new Rect(0, 0, position.width, position.height), Color.black);
+            UiKit.Fill(new Rect(4, 4, 14, 14), Color.magenta);
+            using (new UiKit.ControlCanvasScope(true, Pane))
+            {
+                SetMatrix(Pane.size / 2f, Scale);
+                var oversized = new Rect(-130, -95, 260, 190);
+                UiKit.Fill(oversized, Color.red);
+                GUI.BeginGroup(new Rect(-50, -35, 100, 70));
+                var card = new Rect(0, 0, 100, 70);
+                UiKit.Fill(card, Color.green);
+                if (GUI.Button(card, GUIContent.none, GUIStyle.none)) cardHits++;
+                GUI.EndGroup();
+                if (GUI.Button(oversized, GUIContent.none, GUIStyle.none)) backgroundHits++;
+            }
+            if (Event.current.type == EventType.Repaint) repaints++;
+        }
+
+        void CheckFrame()
+        {
+            try
+            {
+                if (repaints < 2)
+                {
+                    if (EditorApplication.timeSinceStartup - started > 20)
+                        throw new InvalidOperationException("The dedicated graphics window did not repaint.");
+                    Repaint();
+                    return;
+                }
+                CheckPixels();
+                Tap(Pane.center);
+                Tap(new Vector2(Pane.xMin + 4, Pane.center.y));
+                foreach (var edge in EdgeCenters())
+                    Tap(edge + (edge - Pane.center).normalized * 4);
+                if (cardHits != 1 || backgroundHits != 1)
+                    throw new InvalidOperationException($"Expected one card and one inside-edge tap. Got {cardHits} and {backgroundHits}.");
+                Debug.Log("[iOS fold panel render] PASS: four nested card corners, four inside/outside clip edges and touch hit tests.");
+                Finish(0);
+            }
+            catch (Exception error) { Debug.LogException(error); Finish(1); }
+        }
+
+        static Vector2[] EdgeCenters() => new[] {
+            new Vector2(Pane.xMin, Pane.center.y), new Vector2(Pane.xMax, Pane.center.y),
+            new Vector2(Pane.center.x, Pane.yMin), new Vector2(Pane.center.x, Pane.yMax)
+        };
+
+        void CheckPixels()
+        {
+            var view = typeof(EditorWindow).GetField("m_Parent", InstanceMembers).GetValue(this);
+            var grab = typeof(EditorWindow).Assembly.GetType("UnityEditor.GUIView").GetMethod("GrabPixels", InstanceMembers);
+            float density = EditorGUIUtility.pixelsPerPoint;
+            int w = Mathf.RoundToInt(position.width * density), h = Mathf.RoundToInt(position.height * density);
+            var target = RenderTexture.GetTemporary(w, h, 0, RenderTextureFormat.ARGB32);
+            var previous = RenderTexture.active;
+            var pixels = new Texture2D(w, h, TextureFormat.RGB24, false);
+            try
+            {
+                grab.Invoke(view, new object[] { target, new Rect(0, 0, w, h) });
+                RenderTexture.active = target;
+                pixels.ReadPixels(new Rect(0, 0, w, h), 0, 0);
+                pixels.Apply();
+                int marker = Mathf.RoundToInt(10 * density);
+                bool flip = pixels.GetPixel(marker, marker).b < .5f;
+                void Pixel(Vector2 point, Color expected)
+                {
+                    int x = Mathf.RoundToInt(point.x * density), y = Mathf.RoundToInt(point.y * density);
+                    Color actual = pixels.GetPixel(x, flip ? h - 1 - y : y);
+                    if (Mathf.Abs(actual.r - expected.r) > .1f || Mathf.Abs(actual.g - expected.g) > .1f ||
+                        Mathf.Abs(actual.b - expected.b) > .1f)
+                        throw new InvalidOperationException($"At {point}, expected {expected}, read {actual}.");
+                }
+
+                Pixel(new Vector2(10, 10), Color.magenta);
+                foreach (int x in new[] { -1, 1 })
+                    foreach (int y in new[] { -1, 1 })
+                        Pixel(Pane.center + new Vector2(x * 45, y * 30) * Scale, Color.green);
+                foreach (var edge in EdgeCenters())
+                {
+                    var offset = (edge - Pane.center).normalized * 4;
+                    Pixel(edge - offset, Color.red);
+                    Pixel(edge + offset, Color.black);
+                }
+            }
+            finally
+            {
+                RenderTexture.active = previous;
+                DestroyImmediate(pixels);
+                RenderTexture.ReleaseTemporary(target);
+            }
+        }
+
+        void Tap(Vector2 point)
+        {
+            SendEvent(new Event { type = EventType.MouseDown, mousePosition = point, button = 0 });
+            SendEvent(new Event { type = EventType.MouseUp, mousePosition = point, button = 0 });
+        }
+
+        void Finish(int code)
+        {
+            EditorApplication.update -= CheckFrame;
+            Close();
+            EditorApplication.Exit(code);
+        }
+    }
+}
