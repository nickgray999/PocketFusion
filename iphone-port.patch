+using OpenFusion.EditorTools;
+using System.Xml;
+
+if (args.Length != 1) throw new ArgumentException("Pass the pinned Unity iOSSupport/Trampoline directory.");
+string trampoline = Path.GetFullPath(args[0]);
+string templates = Path.GetFullPath("Assets/Editor/IOSSceneLifecycle");
+string output = Path.Combine(Path.GetTempPath(), "openfusion-scene-test-" + Guid.NewGuid().ToString("N"));
+Directory.CreateDirectory(Path.Combine(output, "Classes"));
+Directory.CreateDirectory(Path.Combine(output, "Classes", "UI"));
+try
+{
+    foreach (string file in new[] { "UnityAppController.h", "UnityAppController.mm" })
+        File.Copy(Path.Combine(trampoline, "Classes", file), Path.Combine(output, "Classes", file));
+    foreach (string file in new[] { "UnityView.mm", "UnityAppController+ViewHandling.mm" })
+        File.Copy(Path.Combine(trampoline, "Classes", "UI", file), Path.Combine(output, "Classes", "UI", file));
+    File.Copy(Path.Combine(trampoline, "Info.plist"), Path.Combine(output, "Info.plist"));
+#if UNITY_IOS
+    Directory.CreateDirectory(Path.Combine(output, "Unity-iPhone.xcodeproj"));
+    File.Copy(Path.Combine(trampoline, "Unity-iPhone.xcodeproj", "project.pbxproj"), Path.Combine(output, "Unity-iPhone.xcodeproj", "project.pbxproj"));
+#endif
+    string original = File.ReadAllText(Path.Combine(output, "Classes", "UnityAppController.mm"));
+    IOSSceneLifecycle.Apply(output, templates);
+    var first = Directory.GetFiles(output, "*", SearchOption.AllDirectories).ToDictionary(p => p, File.ReadAllText);
+    IOSSceneLifecycle.Apply(output, templates);
+    foreach (var entry in first) Require(File.ReadAllText(entry.Key) == entry.Value, "Repeated backport changed " + entry.Key);
+    string controller = File.ReadAllText(Path.Combine(output, "Classes", "UnityAppController.mm"));
+    Require(!controller.Contains("initUnityWithApplication:"), "Legacy init selectors must all be replaced.");
+    Require(controller.Contains("initWithWindowScene: scene"), "Window must use the actual connected scene.");
+    Require(controller.Contains("_window.windowScene = scene") && controller.Contains("[_window makeKeyAndVisible]"), "Reconnect must retain and reattach Unity's existing window.");
+    Require(controller.Contains("if (scene == nil) return;"), "A missing scene must not start graphics early.");
+    string didFinish = controller.Split("didFinishLaunchingWithOptions:")[1].Split("- (void)initUnityApplicationNoGraphics")[0];
+    Require(!didFinish.Contains("initUnityWithScene:") && !didFinish.Contains("initUnityWithApplication:"), "App launch must defer graphics until scene foreground.");
+    string originalStart = original.Split("- (void)startUnity:(UIApplication*)application")[1].Split("- (void)")[0];
+    string patchedStart = controller.Split("- (void)startUnity:(UIApplication*)application")[1].Split("- (void)")[0];
+    Require(originalStart == patchedStart && controller.Contains("[self startUnity: application]"), "The original runtime startup/rendering entry must remain unchanged.");
+    string viewPath = Path.Combine(output, "Classes", "UI", "UnityView.mm");
+    string view = File.ReadAllText(viewPath);
+    Require(view.Contains("float requestedContentScaleFactor = UnityScreenScaleFactor(self.window.windowScene.screen ?: self.window.screen ?: [UIScreen mainScreen]);"), "Live view scale must use its attached scene screen, then window and preattach fallbacks.");
+    Require(view.Contains("CGFloat scale   = UnityScreenScaleFactor([UIScreen mainScreen]);"), "Unattached initial view setup must remain unchanged.");
+    Require(File.ReadAllText(Path.Combine(output, "Classes", "UI", "UnityAppController+ViewHandling.mm")).Contains("_unityView.contentScaleFactor   = UnityScreenScaleFactor(_window.windowScene.screen ?: _window.screen ?: [UIScreen mainScreen]);"), "Controller transitions must not reset scene-local display scale to mainScreen.");
+    IOSPlist.VerifyGeneratedSceneManifest(Path.Combine(output, "Info.plist"));
+    IOSPlist.Configure(Path.Combine(output, "Info.plist"));
+    IOSSceneLifecycle.Apply(output, templates);
+    IOSPlist.VerifyGeneratedSceneManifest(Path.Combine(output, "Info.plist"));
+    string native = File.ReadAllText(Path.Combine(output, "Classes", "UI", "UnityScene.mm"));
+    string connect = native.Split("willConnectToSession:")[1].Split("- (void)sceneWillEnterForeground:")[0];
+    Require(connect.IndexOf("initUnityApplicationNoGraphics", StringComparison.Ordinal) < connect.IndexOf("UnitySetAbsoluteURL", StringComparison.Ordinal), "Cold URL requires NoGraphics initialization before setting absoluteURL.");
+    Require(!connect.Contains("openURL:") && !connect.Contains("initUnityWithScene:"), "Initial scene connection must not notify plugins or start rendering in background.");
+    string foreground = native.Split("- (void)sceneWillEnterForeground:")[1].Split("- (void)sceneDidBecomeActive:")[0];
+    Require(foreground.IndexOf("initUnityWithScene:", StringComparison.Ordinal) < foreground.IndexOf("openURL:", StringComparison.Ordinal), "Cold URL plugin notification must follow full startup.");
+    foreach (string callback in new[] { "applicationDidBecomeActive:", "applicationWillResignActive:", "applicationDidEnterBackground:", "applicationWillEnterForeground:" })
+        Require(native.Contains(callback), "Missing original app lifecycle forwarding: " + callback);
+    Require(native.Contains("- (UIInterfaceOrientationMask)supportedInterfaceOrientationsForWindowScene:(UIWindowScene *)windowScene"), "iOS 27 must receive an explicit scene-level orientation policy instead of only the four-orientation plist fallback.");
+    string orientationPolicy = native.Split("- (UIInterfaceOrientationMask)supportedInterfaceOrientationsForWindowScene:")[1].Split("- (void)sceneWillResignActive:")[0];
+    Require(orientationPolicy.Contains("UIWindow *window = self.window ?: controller.window;") && orientationPolicy.Contains("if (window.rootViewController == nil) return UIInterfaceOrientationMaskLandscape;"), "Scene policy must use the connected retained Unity window and preserve landscape before root-controller initialization.");
+    Require(orientationPolicy.Contains("[controller application:UIApplication.sharedApplication supportedInterfaceOrientationsForWindow:window]") && !orientationPolicy.Contains("UIInterfaceOrientationMaskAll"), "After startup the scene must forward Unity's live allowed-orientation mask, not broaden ordinary phones to every orientation.");
+    // Reject an unknown live-scale shape before any export file is changed.
+    File.WriteAllText(viewPath, view.Replace("float requestedContentScaleFactor = UnityScreenScaleFactor(self.window.windowScene.screen ?: self.window.screen ?: [UIScreen mainScreen]);", "float requestedContentScaleFactor = FutureDisplayScale();"));
+    var beforeUnknownScale = Directory.GetFiles(output, "*", SearchOption.AllDirectories).ToDictionary(p => p, File.ReadAllText);
+    bool scaleRejected = false;
+    try { IOSSceneLifecycle.Apply(output, templates); } catch (InvalidDataException) { scaleRejected = true; }
+    Require(scaleRejected && beforeUnknownScale.All(entry => File.ReadAllText(entry.Key) == entry.Value), "Unknown live-scale template must be rejected without changing any source or scene metadata.");
+    File.WriteAllText(viewPath, view);
+    // Mixed and duplicated replacements are ambiguous, even on a marked export.
+    string liveScale = "    float requestedContentScaleFactor = UnityScreenScaleFactor(self.window.windowScene.screen ?: self.window.screen ?: [UIScreen mainScreen]);";
+    foreach (string extra in new[] { liveScale, "    float requestedContentScaleFactor = UnityScreenScaleFactor([UIScreen mainScreen]);" })
+    {
+        File.WriteAllText(viewPath, view + "\n" + extra + "\n");
+        string malformed = File.ReadAllText(viewPath);
+        bool ambiguousRejected = false;
+        try { IOSSceneLifecycle.Apply(output, templates); } catch (InvalidDataException) { ambiguousRejected = true; }
+        Require(ambiguousRejected && File.ReadAllText(viewPath) == malformed, "Mixed/duplicated live-scale patch must be rejected without mutation.");
+    }
+    File.WriteAllText(viewPath, view);
+    // An unknown template fails before source files or scene metadata change.
+    File.WriteAllText(Path.Combine(output, "Classes", "UnityAppController.mm"), "// unknown future startup\n");
+    string beforeHeader = File.ReadAllText(Path.Combine(output, "Classes", "UnityAppController.h"));
+    bool rejected = false;
+    try { IOSSceneLifecycle.Apply(output, templates); } catch (InvalidDataException) { rejected = true; }
+    Require(rejected && File.ReadAllText(Path.Combine(output, "Classes", "UnityAppController.mm")) == "// unknown future startup\n" && File.ReadAllText(Path.Combine(output, "Classes", "UnityAppController.h")) == beforeHeader, "Unknown source must be rejected without mutation.");
+    Console.WriteLine("PASS: actual Unity .62 template startup/connected window/reconnect, .62 runtime preservation, scene manifest, cold-link order, callbacks and repeated backport.");
+    Console.WriteLine("PASS: attached scene/window display scale, unchanged preattach initialization, idempotence and fail-closed unknown/mixed/duplicated scale templates.");
+    Console.WriteLine("PASS: iOS 27 scene-level orientation callback uses the connected Unity window, preserves landscape startup and forwards the runtime fold/ordinary-phone orientation policy.");
+#if UNITY_IOS
+    Console.WriteLine("PASS: UnityFramework native source membership and PBX project remain idempotent.");
+#endif
+}
+finally { Directory.Delete(output, true); }
+
+static void Require(bool condition, string message) { if (!condition) throw new Exception(message); }
