index 0000000..70afbe1
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/World/TouchCameraRig.cs
@@ -0,0 +1,28 @@
+using System;
+
+namespace OpenFusion.World
+{
+    /// <summary>A mobile follow view sized to the visible body rather than the legacy camera's fixed two-metre pivot.</summary>
+    public readonly struct TouchCameraRig
+    {
+        public const float DefaultPitch = 8f, MinPitch = -20f, MaxPitch = 38f;
+        public const float FallbackBodyHeight = 1.5f;
+        public readonly float BodyHeight, PivotHeight, Distance, MinDistance;
+
+        public TouchCameraRig(float bodyHeight)
+        {
+            // Imported bounds may be absent during the first frame or contain
+            // an invalid value. Accessories and effects are excluded by callers.
+            if (float.IsNaN(bodyHeight) || float.IsInfinity(bodyHeight) || bodyHeight <= 0f)
+                bodyHeight = FallbackBodyHeight;
+            BodyHeight = Math.Max(.9f, Math.Min(bodyHeight, 2.2f));
+            PivotHeight = BodyHeight * .68f;
+            Distance = BodyHeight * 3.3f;
+            MinDistance = BodyHeight * 2f;
+        }
+
+        public float ClampDistance(float requested)
+            => float.IsNaN(requested) || float.IsInfinity(requested) ? Distance
+                : Math.Max(MinDistance, Math.Min(requested, 15f));
+    }
+}
