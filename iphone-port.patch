+++ b/tests/IOSPlistTest/Program.cs
@@ -0,0 +1,172 @@
+using System.Diagnostics;
+using System.Xml;
+using OpenFusion.EditorTools;
+
+string directory = Path.Combine(Path.GetTempPath(), "openfusion-ios-plist-" + Guid.NewGuid().ToString("N"));
+Directory.CreateDirectory(directory);
+try
+{
+    string path = Path.Combine(directory, "Info.plist");
+    File.WriteAllText(path, """
+        <?xml version="1.0" encoding="UTF-8"?>
+        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+        <plist version="1.0"><dict>
+        <key>CFBundleIdentifier</key><string>net.example.signed-by-user</string>
+        <key>UIApplicationSceneManifest</key><dict>
+          <key>UIApplicationSupportsMultipleScenes</key><false/>
+          <key>UISceneConfigurations</key><dict>
+            <key>UIWindowSceneSessionRoleApplication</key><array><dict>
+              <key>UISceneConfigurationName</key><string>Generated main scene</string>
+              <key>UISceneClassName</key><string>GeneratedWindowScene</string>
+              <key>UISceneDelegateClassName</key><string>GeneratedSceneDelegate</string>
+              <key>UISceneStoryboardFile</key><string>GeneratedStoryboard</string>
+            </dict></array>
+            <key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key><array><dict>
+              <key>UISceneConfigurationName</key><string>Generated external scene</string>
+              <key>UISceneDelegateClassName</key><string>GeneratedExternalDelegate</string>
+            </dict></array>
+          </dict>
+        </dict>
+        <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>other-app</string></array></dict></array>
+        <key>NSAppTransportSecurity</key><dict>
+          <key>NSAllowsArbitraryLoads</key><true/>
+          <key>NSAllowsArbitraryLoadsInWebContent</key><true/>
+          <key>NSAllowsLocalNetworking</key><true/>
+          <key>NSExceptionDomains</key><dict><key>unrelated.invalid</key><dict><key>NSIncludesSubdomains</key><true/></dict></dict>
+        </dict>
+        <key>UIRequiresFullScreen</key><true/>
+        <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
+        </dict></plist>
+        """);
+    var original = new XmlDocument { XmlResolver = null }; original.Load(path);
+    string sceneManifest = original.SelectSingleNode("/plist/dict/key[text()='UIApplicationSceneManifest']/following-sibling::*[1]").OuterXml;
+    IOSPlist.Configure(path);
+    string first = File.ReadAllText(path);
+    IOSPlist.Configure(path);
+    Require(File.ReadAllText(path) == first, "Repeated exports must be idempotent.");
+    LintApplePlist(path);
+    var doc = new XmlDocument { XmlResolver = null }; doc.Load(path);
+    Require(doc.SelectSingleNode("/plist/dict/key[text()='UIApplicationSceneManifest']/following-sibling::*[1]").OuterXml == sceneManifest, "Repeated configuration must preserve the entire generated scene manifest, including scene classes, delegates, names, storyboard and external-display roles.");
+    IOSPlist.VerifyGeneratedSceneManifest(path);
+    Require(doc.SelectNodes("//key[text()='CFBundleURLSchemes']/following-sibling::array[1]/string[text()='ofl']").Count == 1, "ofl URL scheme must be registered exactly once.");
+    Require(doc.SelectNodes("//string[text()='other-app']").Count == 1, "Existing unrelated URL schemes must survive.");
+    Require(doc.SelectSingleNode("/plist/dict/key[text()='CFBundleIdentifier']/following-sibling::string[1]").InnerText == "net.example.signed-by-user", "Signing bundle identity must survive.");
+    Require(doc.SelectSingleNode("//key[text()='NSAllowsArbitraryLoads']/following-sibling::*[1]").Name == "false", "Global HTTP bypass must be disabled.");
+    Require(doc.SelectNodes("//key[text()='NSAllowsArbitraryLoadsInWebContent' or text()='NSAllowsLocalNetworking']").Count == 0, "Alternate broad exceptions must be removed.");
+    var domains = doc.SelectSingleNode("//key[text()='NSExceptionDomains']/following-sibling::dict[1]");
+    Require(domains.SelectNodes("key").Count == IOSPlist.HttpAssetHosts.Length, "Only configured public asset hosts may have exceptions.");
+    foreach (string host in IOSPlist.HttpAssetHosts)
+    {
+        var domain = domains.SelectSingleNode("key[text()='" + host + "']/following-sibling::dict[1]");
+        Require(domain != null && domain.SelectSingleNode("key[text()='NSExceptionAllowsInsecureHTTPLoads']/following-sibling::*[1]").Name == "true", "Expected exact asset exception.");
+        Require(domain.SelectSingleNode("key[text()='NSIncludesSubdomains']/following-sibling::*[1]").Name == "false", "Asset exception must not include subdomains.");
+    }
+    Require(doc.SelectSingleNode("/plist/dict/key[text()='UIRequiresFullScreen']/following-sibling::*[1]").Name == "false", "The legacy fullscreen compatibility canvas must be disabled for Duo scene resizing.");
+    var orientations = doc.SelectNodes("/plist/dict/key[text()='UISupportedInterfaceOrientations']/following-sibling::array[1]/string").Cast<XmlNode>().Select(node => node.InnerText).ToArray();
+    Require(orientations.Length == 4 && orientations.Distinct().Count() == 4, "Every orientation must be declared once for the resizable inner display.");
+    foreach (string orientation in new[] { "UIInterfaceOrientationLandscapeLeft", "UIInterfaceOrientationLandscapeRight", "UIInterfaceOrientationPortrait", "UIInterfaceOrientationPortraitUpsideDown" })
+        Require(orientations.Contains(orientation), "Missing Duo scene orientation: " + orientation);
+    File.WriteAllText(path, "<plist version='1.0'><dict/></plist>");
+    IOSPlist.Configure(path);
+    Require(File.ReadAllText(path).Contains("ofl"), "An initially empty plist must be configured.");
+    Require(!File.ReadAllText(path).Contains("UIApplicationSceneManifest"), "Plist customization must not synthesize scene adoption without Unity's native lifecycle implementation.");
+    bool missingScenesRejected = false;
+    try { IOSPlist.VerifyGeneratedSceneManifest(path); } catch (InvalidDataException) { missingScenesRejected = true; }
+    Require(missingScenesRejected, "Export verification must reject a legacy player with no generated scene manifest.");
+    LintApplePlist(path);
+    File.WriteAllText(path, "<plist version='1.0'><dict><key>UIApplicationSceneManifest</key><string>invalid scene manifest</string></dict></plist>");
+    IOSPlist.Configure(path);
+    missingScenesRejected = false;
+    try { IOSPlist.VerifyGeneratedSceneManifest(path); } catch (InvalidDataException) { missingScenesRejected = true; }
+    Require(missingScenesRejected, "A scene manifest with the wrong plist type must fail export verification.");
+    File.WriteAllText(path, "<plist version='1.0'><dict><key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict></dict></plist>");
+    IOSPlist.Configure(path);
+    IOSPlist.Configure(path);
+    missingScenesRejected = false;
+    try { IOSPlist.VerifyGeneratedSceneManifest(path); } catch (InvalidDataException) { missingScenesRejected = true; }
+    Require(missingScenesRejected, "A manifest dictionary alone must not substitute for the pinned Unity template's generated scene configuration and delegate.");
+    Require(!File.ReadAllText(path).Contains("UISceneConfigurations") && !File.ReadAllText(path).Contains("UISceneDelegateClassName"), "Missing scene configurations must not be fabricated.");
+    // Actual 2022.3.76f1 iOS Trampoline/Info.plist shape: no scene class or storyboard.
+    File.WriteAllText(path, """
+        <plist version='1.0'><dict><key>UIApplicationSceneManifest</key><dict>
+        <key>UIApplicationSupportsMultipleScenes</key><false/>
+        <key>UISceneConfigurations</key><dict><key>UIWindowSceneSessionRoleApplication</key><array><dict>
+        <key>UISceneConfigurationName</key><string>Default Configuration</string>
+        <key>UISceneDelegateClassName</key><string>UnityScene</string>
+        </dict></array></dict></dict></dict></plist>
+        """);
+    IOSPlist.Configure(path);
+    first = File.ReadAllText(path);
+    IOSPlist.Configure(path);
+    Require(File.ReadAllText(path) == first, "The actual Unity scene configuration must remain idempotent.");
+    IOSPlist.VerifyGeneratedSceneManifest(path);
+    var unityScene = new XmlDocument { XmlResolver = null }; unityScene.Load(path);
+    var delegateNode = unityScene.SelectSingleNode("//key[text()='UISceneDelegateClassName']/following-sibling::*[1]");
+    delegateNode.InnerText = "";
+    unityScene.Save(path);
+    missingScenesRejected = false;
+    try { IOSPlist.VerifyGeneratedSceneManifest(path); } catch (InvalidDataException) { missingScenesRejected = true; }
+    Require(missingScenesRejected, "A missing default scene delegate must fail verification even when the manifest dictionary exists.");
+    File.WriteAllText(path, "<plist version='1.0'><array/></plist>");
+    bool rejected = false;
+    try { IOSPlist.Configure(path); } catch (InvalidDataException) { rejected = true; }
+    Require(rejected, "Malformed plist structure must fail the export.");
+    string project = Path.Combine(directory, "Project");
+    Directory.CreateDirectory(Path.Combine(project, "Assets"));
+    string protectedSource = Path.Combine(project, "Assets", "Game.cs");
+    File.WriteAllText(protectedSource, "keep source");
+    foreach (string unsafePath in new[] { project, "Assets", "Builds/../Assets", "Builds", directory, Path.GetPathRoot(directory) })
+    {
+        rejected = false;
+        try { IOSExportPath.Validate(project, unsafePath); } catch (IOException) { rejected = true; }
+        Require(rejected, "Unsafe export target was accepted: " + unsafePath);
+    }
+    Require(File.ReadAllText(protectedSource) == "keep source", "Export validation must leave source intact.");
+    Require(IOSExportPath.Validate(project, "Builds/iOS") == Path.Combine(project, "Builds", "iOS"), "Default build directory should be usable.");
+    Directory.CreateDirectory(Path.Combine(project, "Builds"));
+    Directory.CreateSymbolicLink(Path.Combine(project, "Builds", "LinkedAssets"), Path.Combine(project, "Assets"));
+    rejected = false;
+    try { IOSExportPath.Validate(project, "Builds/LinkedAssets/Export"); } catch (IOException) { rejected = true; }
+    Require(rejected && !Directory.Exists(Path.Combine(project, "Assets", "Export")), "A Builds symlink must not redirect the export into source.");
+    string external = Path.Combine(directory, "FreshXcodeExport");
+    Require(IOSExportPath.Validate(project, external) == external, "A new external export directory should be usable.");
+    Directory.CreateDirectory(external);
+    Require(IOSExportPath.Validate(project, external) == external, "An empty external export directory should be usable.");
+    File.WriteAllText(Path.Combine(external, "keep.txt"), "keep existing");
+    rejected = false;
+    try { IOSExportPath.Validate(project, external); } catch (IOException) { rejected = true; }
+    Require(rejected && File.ReadAllText(Path.Combine(external, "keep.txt")) == "keep existing", "Existing external data must be protected.");
+    Console.WriteLine("PASS: iOS plist links, exact asset exceptions, resizable Duo scene/all four orientations, preservation, idempotency and malformed input.");
+    Console.WriteLine("PASS: generated scene manifest/delegates survive repeated configuration; missing native lifecycle is not fabricated.");
+    Console.WriteLine("PASS: export verification accepts the actual Unity 2022.3.76f1 scene schema and rejects missing/malformed metadata or delegates.");
+    Console.WriteLine("PASS: Xcode export path protects project source and existing external directories.");
+}
+finally { Directory.Delete(directory, true); }
+
+static void Require(bool condition, string message)
+{
+    if (!condition) throw new Exception(message);
+}
+
+static void LintApplePlist(string path)
+{
+    if (!OperatingSystem.IsMacOS() || !File.Exists("/usr/bin/plutil")) return;
+    var start = new ProcessStartInfo("/usr/bin/plutil")
+    {
+        UseShellExecute = false,
+        RedirectStandardOutput = true,
+        RedirectStandardError = true
+    };
+    start.ArgumentList.Add("-lint");
+    start.ArgumentList.Add(path);
+    using var process = Process.Start(start);
+    var output = process.StandardOutput.ReadToEndAsync();
+    var error = process.StandardError.ReadToEndAsync();
+    if (!process.WaitForExit(10000))
+    {
+        process.Kill();
+        throw new Exception("Apple plutil timed out while checking the exported plist.");
+    }
+    Require(process.ExitCode == 0, "Apple plutil rejected the exported plist: " + output.GetAwaiter().GetResult() + error.GetAwaiter().GetResult());
+    Console.WriteLine("PASS: Apple's plist parser accepts the configured plist.");
+}
