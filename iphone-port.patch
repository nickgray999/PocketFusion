diff --git a/Assets/Editor/IOSExportPath.cs b/Assets/Editor/IOSExportPath.cs
new file mode 100644
index 0000000..7349157
--- /dev/null
+++ b/Assets/Editor/IOSExportPath.cs
@@ -0,0 +1,37 @@
+using System;
+using System.IO;
+using System.Linq;
+
+namespace OpenFusion.EditorTools
+{
+    public static class IOSExportPath
+    {
+        // Unity can replace files in an export directory. Confine repeat exports
+        // to Builds/<name>, or require a fresh/empty directory outside the source.
+        public static string Validate(string projectRoot, string output)
+        {
+            if (string.IsNullOrWhiteSpace(output)) throw new ArgumentException("An Xcode output directory is required.", nameof(output));
+            string project = Path.GetFullPath(projectRoot).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+            string fullTarget = Path.GetFullPath(Path.IsPathRooted(output) ? output : Path.Combine(project, output));
+            if (fullTarget == Path.GetPathRoot(fullTarget)) throw new IOException("A filesystem root cannot be an Xcode export directory.");
+            string target = fullTarget.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+            string builds = Path.Combine(project, "Builds");
+            if (File.Exists(target)) throw new IOException("The Xcode export path names an existing file.");
+            if (IsChild(target, builds))
+            {
+                // A symlink under Builds could lead back into source/assets.
+                for (string current = target; current != project; current = Path.GetDirectoryName(current))
+                    if (Directory.Exists(current) && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                        throw new IOException("Xcode output must not traverse a symlink inside the project's Builds directory.");
+                return target;
+            }
+            if (target == project || IsChild(target, project))
+                throw new IOException("Export Xcode into Builds/<name>, or a new empty directory outside this project.");
+            if (Directory.Exists(target) && Directory.EnumerateFileSystemEntries(target).Any())
+                throw new IOException("An output directory outside this project must be empty. Choose a fresh directory to protect existing files.");
+            return target;
+        }
+
+        static bool IsChild(string path, string parent) => path.StartsWith(parent + Path.DirectorySeparatorChar, StringComparison.Ordinal);
+    }
+}
