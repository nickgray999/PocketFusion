diff --git a/Assets/Scripts/OpenFusion/Screens/LauncherKeyboardState.cs b/Assets/Scripts/OpenFusion/Screens/LauncherKeyboardState.cs
new file mode 100644
index 0000000..627671f
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/Screens/LauncherKeyboardState.cs
@@ -0,0 +1,68 @@
+using System;
+using System.Collections.Generic;
+
+namespace OpenFusion.Screens
+{
+    /// <summary>Owns one bounded edit; completed values survive switching fields, never switching forms.</summary>
+    internal sealed class LauncherKeyboardState
+    {
+        readonly Dictionary<string, string> completed = new Dictionary<string, string>();
+        string scope, field, original, text;
+        int limit;
+        public string Scope => scope;
+        public string Field => field;
+        public string Text => text ?? "";
+        public bool Secure { get; private set; }
+        public int Limit => limit;
+        public bool Editing => field != null;
+
+        public void ChangeScope(string next)
+        {
+            if (scope == next) return;
+            Clear(); scope = next;
+        }
+        public bool Begin(string nextScope, string name, string value, int maximum, bool secure)
+        {
+            ChangeScope(nextScope);
+            if (field == name) return false;
+            Finish(false);
+            field = name; limit = Math.Max(0, maximum); Secure = secure;
+            original = text = Bound(value);
+            return true;
+        }
+        public void Update(string value, bool finished, bool canceled)
+        {
+            if (!Editing) return;
+            text = Bound(value);
+            if (finished) Finish(canceled);
+        }
+        public string Value(string currentScope, string name, string fallback)
+        {
+            ChangeScope(currentScope);
+            if (field == name) return Text;
+            if (!completed.TryGetValue(name, out var value)) return fallback ?? "";
+            completed.Remove(name); return value;
+        }
+        public void Finish(bool canceled)
+        {
+            if (!Editing) return;
+            completed[field] = canceled ? original : Text;
+            field = original = text = null; limit = 0; Secure = false;
+        }
+        public void Forget(string name)
+        {
+            completed.Remove(name);
+            if (field == name) { field = original = text = null; limit = 0; Secure = false; }
+        }
+        public void Clear()
+        {
+            completed.Clear(); field = original = text = scope = null;
+            limit = 0; Secure = false;
+        }
+        string Bound(string value)
+        {
+            value = value ?? "";
+            return value.Length <= limit ? value : value.Substring(0, limit);
+        }
+    }
+}
