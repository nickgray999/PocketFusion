+            Check(correctHeight(26.38f, 26.4f, .5f, .08f) == 26.4f, "Nearby terrain penetration must still be repaired.");
+            Check(correctHeight(26.4f, 26f, .5f, .08f) == 26.4f, "Terrain correction must not lower the player.");
+            Check(correctHeight(26.4f, float.NegativeInfinity, .5f, .08f) == 26.4f, "Missing terrain must preserve the current floor.");
+            Check(correctHeight(26f, 26.5f, .5f, .08f) == 26.5f, "The exact configured step limit must allow local correction.");
+            Check(correctHeight(26f, 26.5002f, .5f, .08f) == 26f, "Terrain beyond the step limit must not lift the player.");
+            float skinLimit = .08f + .02f;
+            Check(correctHeight(0f, skinLimit, .01f, .08f) == skinLimit, "The skin clearance must remain the minimum correction range.");
+            Check(correctHeight(0f, skinLimit + .0002f, .01f, .08f) == 0f, "The skin correction range must remain bounded.");
+
+            GameObject floorHost = null, terrainHost = null, actor = null;
+            TerrainData terrainData = null;
+            var position = new Vector3(8192f, 26.39f, 8192f);
+            try
+            {
+                floorHost = new GameObject("own spawn local platform");
+                floorHost.transform.position = new Vector3(position.x, 25.9f, position.z);
+                var floor = floorHost.AddComponent<BoxCollider>(); floor.size = new Vector3(8f, 1f, 8f);
+                terrainData = new TerrainData { heightmapResolution = 33, size = new Vector3(8f, 1f, 8f) };
+                terrainHost = Terrain.CreateTerrainGameObject(terrainData);
+                terrainHost.name = "own spawn high outdoor terrain";
+                terrainHost.transform.position = new Vector3(position.x - 4f, 49f, position.z - 4f);
+                actor = new GameObject("own spawn player"); actor.transform.position = position;
+                Func<Vector3, Vector3> correctSpawn = input => (Vector3)ownSpawn.Invoke(null, new object[] { input, actor.transform });
+                Physics.SyncTransforms();
