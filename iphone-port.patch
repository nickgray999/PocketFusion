diff --git a/Assets/Plugins/iOS/PocketFold.mm b/Assets/Plugins/iOS/PocketFold.mm
new file mode 100644
index 0000000..71ebe92
--- /dev/null
+++ b/Assets/Plugins/iOS/PocketFold.mm
@@ -0,0 +1,166 @@
+#import <UIKit/UIKit.h>
+#import <QuartzCore/QuartzCore.h>
+#include <cmath>
+#include <cstring>
+
+// Unity's real rendering view supplies both the hinge interaction and the
+// reserved-region coordinate space. This is a public Unity trampoline API.
+extern "C" UIView *UnityGetGLView(void);
+
+// Four-byte fields keep the native/C# boundary independent of CGFloat and BOOL.
+// Rectangle values use normalized top-left coordinates in the Unity view.
+struct OFPocketFoldState
+{
+    int version, supported, hingeAvailable, hingeStatus, revision;
+    int divisionCount, divisionActive;
+    float angleRadians, viewWidth, viewHeight;
+    float divisionX, divisionY, divisionWidth, divisionHeight;
+    float safeX, safeY, safeWidth, safeHeight;
+};
+static_assert(sizeof(OFPocketFoldState) == 72, "PocketFold ABI changed");
+
+static OFPocketFoldState foldState = {};
+static __weak UIView *observedView;
+static UIHingeInteraction *hingeInteraction API_AVAILABLE(ios(27.1));
+static CFTimeInterval nextGeometryRefresh;
+
+static bool GeometryChanged(const OFPocketFoldState &before, const OFPocketFoldState &after)
+{
+    // Angle updates alone do not change the input surface. A thumb must remain
+    // owned while the user makes a small adjustment to the hinge angle.
+    return before.supported != after.supported || before.hingeAvailable != after.hingeAvailable ||
+        before.hingeStatus != after.hingeStatus || before.divisionCount != after.divisionCount ||
+        before.divisionActive != after.divisionActive || before.viewWidth != after.viewWidth ||
+        before.viewHeight != after.viewHeight || before.divisionX != after.divisionX ||
+        before.divisionY != after.divisionY || before.divisionWidth != after.divisionWidth ||
+        before.divisionHeight != after.divisionHeight || before.safeX != after.safeX ||
+        before.safeY != after.safeY || before.safeWidth != after.safeWidth || before.safeHeight != after.safeHeight;
+}
+
+static void PublishFoldState(OFPocketFoldState next)
+{
+    next.version = 1;
+    next.revision = foldState.revision + (GeometryChanged(foldState, next) ? 1 : 0);
+    foldState = next;
+}
+
+static bool NormalizeRect(CGRect frame, CGRect bounds, float *x, float *y, float *width, float *height)
+{
+    if (CGRectIsNull(frame) || CGRectIsInfinite(frame) ||
+        !std::isfinite(frame.origin.x) || !std::isfinite(frame.origin.y) ||
+        !std::isfinite(frame.size.width) || !std::isfinite(frame.size.height) ||
+        frame.size.width < 0 || frame.size.height < 0) return false;
+    CGFloat left = MAX(CGRectGetMinX(bounds), CGRectGetMinX(frame));
+    CGFloat top = MAX(CGRectGetMinY(bounds), CGRectGetMinY(frame));
+    CGFloat right = MIN(CGRectGetMaxX(bounds), CGRectGetMaxX(frame));
+    CGFloat bottom = MIN(CGRectGetMaxY(bounds), CGRectGetMaxY(frame));
+    // A division is allowed to be a zero-width or zero-height line. CGRect's
+    // ordinary empty/intersection helpers would discard that useful evidence.
+    if (right < left || bottom < top) return false;
+    *x = (float)((left - bounds.origin.x) / bounds.size.width);
+    *y = (float)((top - bounds.origin.y) / bounds.size.height);
+    *width = (float)((right - left) / bounds.size.width);
+    *height = (float)((bottom - top) / bounds.size.height);
+    return true;
+}
+
+static void RefreshGeometry()
+{
+    UIView *view = observedView;
+    OFPocketFoldState next = foldState;
+    next.viewWidth = next.viewHeight = 0;
+    next.divisionCount = next.divisionActive = 0;
+    next.divisionX = next.divisionY = next.divisionWidth = next.divisionHeight = 0;
+    next.safeX = next.safeY = next.safeWidth = next.safeHeight = 0;
+    CGRect bounds = view != nil ? view.bounds : CGRectZero;
+    if (view == nil || view.window == nil || !std::isfinite(bounds.size.width) ||
+        !std::isfinite(bounds.size.height) || bounds.size.width <= 0 || bounds.size.height <= 0)
+    {
+        next.hingeAvailable = 0; next.hingeStatus = 0; next.angleRadians = 0;
+        PublishFoldState(next); return;
+    }
+    next.viewWidth = (float)bounds.size.width; next.viewHeight = (float)bounds.size.height;
+    CGRect safe = UIEdgeInsetsInsetRect(bounds, view.safeAreaInsets);
+    NormalizeRect(safe, bounds, &next.safeX, &next.safeY, &next.safeWidth, &next.safeHeight);
+    if (@available(iOS 27.1, *))
+    {
+        NSArray<UIViewReservedRegion *> *regions = [view reservedRegionsOfKind:[UIViewReservedRegionKind divisionRegionKind]
+            options:UIViewReservedRegionQueryOptionsIncludeInactive];
+        for (UIViewReservedRegion *region in regions)
+        {
+            float x, y, width, height;
+            if (!NormalizeRect(region.frame, bounds, &x, &y, &width, &height)) continue;
+            next.divisionCount++;
+            if (next.divisionCount == 1)
+            {
+                next.divisionActive = region.isActive ? 1 : 0;
+                next.divisionX = x; next.divisionY = y;
+                next.divisionWidth = width; next.divisionHeight = height;
+            }
+        }
+        // This client supports one hinge. Do not guess which reserved region
+        // belongs to it when a future hierarchy reports multiple divisions.
+        if (next.divisionCount != 1)
+        {
+            next.divisionActive = 0;
+            next.divisionX = next.divisionY = next.divisionWidth = next.divisionHeight = 0;
+        }
+    }
+    PublishFoldState(next);
+}
+
+static void AttachToUnityView()
+{
+    UIView *view = UnityGetGLView();
+    if (view == observedView) return;
+    if (@available(iOS 27.1, *))
+    {
+        if (observedView != nil && hingeInteraction != nil) [observedView removeInteraction:hingeInteraction];
+        hingeInteraction = nil;
+    }
+    observedView = view;
+    OFPocketFoldState next = foldState;
+    next.hingeAvailable = 0; next.hingeStatus = 0; next.angleRadians = 0;
+    PublishFoldState(next);
+    nextGeometryRefresh = 0;
+    if (@available(iOS 27.1, *))
+    {
+        if (view != nil)
+        {
+            hingeInteraction = [[UIHingeInteraction alloc] initWithUpdateHandler:^(UIHingeInteraction *, UIHingeInteractionUpdate *update) {
+                OFPocketFoldState changed = foldState;
+                UIHinge *hinge = update.hinge;
+                changed.hingeAvailable = hinge != nil ? 1 : 0;
+                changed.hingeStatus = hinge != nil ? (int)hinge.status : 0;
+                changed.angleRadians = hinge != nil && std::isfinite(hinge.angle) ? (float)hinge.angle : 0;
+                PublishFoldState(changed);
+                // A posture callback must be reflected by the next managed
+                // query, even if the regular 100 ms geometry poll is not due.
+                nextGeometryRefresh = 0;
+            }];
+            [view addInteraction:hingeInteraction];
+        }
+    }
+}
+
+extern "C" int OFPocketQueryFold(OFPocketFoldState *outState, int size)
+{
+    if (outState == nullptr || size != (int)sizeof(OFPocketFoldState)) return 0;
+    // Unity calls from Update on the main thread. Returning unknown is safer
+    // than touching UIKit from a worker or blocking it with dispatch_sync.
+    if (![NSThread isMainThread]) { std::memset(outState, 0, sizeof(*outState)); outState->version = 1; return 0; }
+    @autoreleasepool {
+        OFPocketFoldState next = foldState;
+        if (@available(iOS 27.1, *)) next.supported = 1;
+        else next.supported = 0;
+        PublishFoldState(next);
+        AttachToUnityView();
+        CFTimeInterval now = CACurrentMediaTime();
+        if (now >= nextGeometryRefresh)
+        {
+            RefreshGeometry(); nextGeometryRefresh = now + 0.1;
+        }
+        *outState = foldState;
+        return 1;
+    }
+}
