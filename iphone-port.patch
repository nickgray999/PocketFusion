diff --git a/Assets/Plugins/iOS/PocketKeychain.mm b/Assets/Plugins/iOS/PocketKeychain.mm
new file mode 100644
index 0000000..c161a4e
--- /dev/null
+++ b/Assets/Plugins/iOS/PocketKeychain.mm
@@ -0,0 +1,99 @@
+#import <Foundation/Foundation.h>
+#import <Security/Security.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+// Each signing identity's default Keychain access group isolates these items.
+// Passwords stay on this device and are available only while it is unlocked.
+static NSString *const PocketCredentialService = @"com.openfusion.pocket.saved-passwords.v1";
+
+static NSMutableDictionary *CredentialQuery(NSString *identity)
+{
+    NSMutableDictionary *query = [NSMutableDictionary dictionaryWithDictionary:@{
+        (__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword,
+        (__bridge id)kSecAttrService: PocketCredentialService,
+        (__bridge id)kSecAttrSynchronizable: @NO
+    }];
+    if (identity != nil) query[(__bridge id)kSecAttrAccount] = identity;
+    return query;
+}
+
+extern "C" int OFPocketSaveCredential(const char *identity, const char *password)
+{
+    @autoreleasepool {
+        if (identity == NULL || password == NULL) return 0;
+        NSString *account = [NSString stringWithUTF8String:identity];
+        NSString *secret = [NSString stringWithUTF8String:password];
+        if (account.length == 0 || secret.length == 0) return 0;
+        NSData *data = [secret dataUsingEncoding:NSUTF8StringEncoding];
+        NSMutableDictionary *query = CredentialQuery(account);
+        NSDictionary *attributes = @{
+            (__bridge id)kSecValueData: data,
+            (__bridge id)kSecAttrAccessible: (__bridge id)kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+        };
+        OSStatus result = SecItemUpdate((__bridge CFDictionaryRef)query, (__bridge CFDictionaryRef)attributes);
+        if (result == errSecItemNotFound) {
+            [query addEntriesFromDictionary:attributes];
+            result = SecItemAdd((__bridge CFDictionaryRef)query, NULL);
+        }
+        return result == errSecSuccess ? 1 : 0;
+    }
+}
+
+extern "C" void *OFPocketLoadCredential(const char *identity, int *length)
+{
+    if (length == NULL) return NULL;
+    *length = 0;
+    @autoreleasepool {
+        if (identity == NULL) return NULL;
+        NSString *account = [NSString stringWithUTF8String:identity];
+        if (account.length == 0) return NULL;
+        NSMutableDictionary *query = CredentialQuery(account);
+        query[(__bridge id)kSecReturnData] = @YES;
+        query[(__bridge id)kSecMatchLimit] = (__bridge id)kSecMatchLimitOne;
+        CFTypeRef result = NULL;
+        OSStatus status = SecItemCopyMatching((__bridge CFDictionaryRef)query, &result);
+        if (status != errSecSuccess || result == NULL) return NULL;
+        void *copy = NULL;
+        if (CFGetTypeID(result) == CFDataGetTypeID()) {
+            CFDataRef data = (CFDataRef)result;
+            CFIndex size = CFDataGetLength(data);
+            if (size > 0 && size <= INT_MAX) {
+                copy = malloc((size_t)size);
+                if (copy != NULL) {
+                    memcpy(copy, CFDataGetBytePtr(data), (size_t)size);
+                    *length = (int)size;
+                }
+            }
+        }
+        CFRelease(result);
+        return copy;
+    }
+}
+
+extern "C" void OFPocketFreeCredential(void *data, int length)
+{
+    if (data == NULL) return;
+    // Volatile writes prevent the compiler from optimizing away the wipe.
+    volatile unsigned char *bytes = (volatile unsigned char *)data;
+    for (int i = 0; i < length; ++i) bytes[i] = 0;
+    free(data);
+}
+
+extern "C" void OFPocketForgetCredential(const char *identity)
+{
+    @autoreleasepool {
+        if (identity == NULL) return;
+        NSString *account = [NSString stringWithUTF8String:identity];
+        if (account.length == 0) return;
+        SecItemDelete((__bridge CFDictionaryRef)CredentialQuery(account));
+    }
+}
+
+extern "C" void OFPocketForgetAllCredentials()
+{
+    @autoreleasepool {
+        SecItemDelete((__bridge CFDictionaryRef)CredentialQuery(nil));
+    }
+}
