+        }
+        static bool Layout(object state, float width, float height, Rect safe, bool manual, out Rect world, out Rect controls)
+        {
+            var args = new object[] { state, width, height, safe, manual, null, null };
+            bool result = (bool)typeof(FoldScreenController).GetMethod("TryLayout", HiddenStatic).Invoke(null, args);
