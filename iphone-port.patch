diff --git a/Assets/Editor/IOSViewportChecks.cs b/Assets/Editor/IOSViewportChecks.cs
new file mode 100644
index 0000000..ce1ccd1
--- /dev/null
+++ b/Assets/Editor/IOSViewportChecks.cs
@@ -0,0 +1,198 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using OpenFusion.Screens;
+using OpenFusion.World;
+using UnityEditor;
+using UnityEngine;
+
+namespace OpenFusion.EditorTools
+{
+    // Geometry checks deliberately take viewport inputs rather than changing the
+    // editor window or pretending that a physical iPhone has been exercised.
+    public static class IOSViewportChecks
+    {
+        const BindingFlags HiddenInstance = BindingFlags.Instance | BindingFlags.NonPublic;
+        const BindingFlags HiddenStatic = BindingFlags.Static | BindingFlags.NonPublic;
+        const string ResultPath = "Logs/ios-viewport-regression-results.txt";
+        const float Epsilon = .02f;
+
+        struct Viewport
+        {
+            public string Name;
+            public float Width, Height, Notch, Home, Top;
+            public Viewport(string name, float width, float height, float notch, float home, float top = 0f)
+            { Name = name; Width = width; Height = height; Notch = notch; Home = home; Top = top; }
+        }
+
+        static void Check(bool condition, string message)
+        { if (!condition) throw new InvalidOperationException(message); }
+        static bool Near(float a, float b) => Mathf.Abs(a - b) <= Epsilon;
+        static bool Same(Rect a, Rect b) => Near(a.x, b.x) && Near(a.y, b.y) && Near(a.width, b.width) && Near(a.height, b.height);
+        static void Contained(Rect rect, Rect area, string name)
+        {
+            Check(rect.width > 0f && rect.height > 0f && rect.x >= area.x - Epsilon && rect.y >= area.y - Epsilon
+                && rect.xMax <= area.xMax + Epsilon && rect.yMax <= area.yMax + Epsilon,
+                name + " escaped its safe area: " + rect + " in " + area);
+        }
+        static T TouchGeometry<T>(string method, params object[] arguments)
+        { return (T)typeof(TouchControls).GetMethod(method, HiddenStatic).Invoke(null, arguments); }
+
+        public static void Run()
+        {
+            var results = new List<string> { "UTC " + DateTime.UtcNow.ToString("O") };
+            string layout = TouchLayout.Snapshot();
+            try
+            {
+                var viewports = new[] {
+                    new Viewport("compact 16:9", 1136f, 640f, 0f, 0f),
+                    new Viewport("SE 16:9", 1334f, 750f, 0f, 0f),
+                    new Viewport("mini", 2340f, 1080f, 150f, 63f),
+                    new Viewport("Pro", 2556f, 1179f, 177f, 63f),
+                    new Viewport("Pro Max", 2796f, 1290f, 177f, 63f),
+                    new Viewport("large Pro", 2622f, 1206f, 186f, 63f),
+                    new Viewport("large Pro Max", 2868f, 1320f, 186f, 63f),
+                    // Nonzero top + bottom catches a mistaken bottom-left/GUI conversion.
+                    new Viewport("asymmetric inset stress", 812f, 375f, 44f, 21f, 7f)
+                };
+                int layouts = 0;
+                foreach (var viewport in viewports)
+                {
+                    for (int orientation = 0; orientation < 2; orientation++)
+                    {
+                        float left = orientation == 0 ? viewport.Notch : 0f, right = orientation == 0 ? 0f : viewport.Notch;
+                        var unitySafe = new Rect(left, viewport.Home, viewport.Width - left - right, viewport.Height - viewport.Home - viewport.Top);
+                        var area = UiKit.SafeGuiBounds(viewport.Width, viewport.Height, unitySafe);
+                        string name = viewport.Name + (orientation == 0 ? " landscape left" : " landscape right");
+                        Check(Same(area, new Rect(left, viewport.Top, viewport.Width - left - right, viewport.Height - viewport.Home - viewport.Top)), name + " safe-area conversion inverted an inset.");
+                        Check(Near(area.center.x, left + area.width * .5f), name + " safe center changed.");
+                        float referenceScale = Mathf.Max(.1f, viewport.Height / UiKit.RefH);
+                        var reference = new Rect(area.x / referenceScale, area.y / referenceScale, area.width / referenceScale, area.height / referenceScale);
+                        Check(Same(new Rect(reference.x * referenceScale, reference.y * referenceScale, reference.width * referenceScale, reference.height * referenceScale), area), name + " reference-space conversion must preserve insets.");
+                        var nanoWheel = NanoWheelHud.GroupRectForArea(area, referenceScale);
+                        Contained(nanoWheel, area, name + " nano wheel");
+                        Check(Near(nanoWheel.xMax, area.xMax - 20f * referenceScale) && Near(nanoWheel.yMax, area.yMax - 10f * referenceScale), name + " nano wheel must retain its bottom-right margins.");
+                        var chatWindow = ChatHud.WindowRectForArea(area, referenceScale, 440f, 150f);
+                        Contained(chatWindow, area, name + " chat window");
+                        Check(Near(chatWindow.xMin, area.xMin) && Near(chatWindow.yMax, area.yMax), name + " chat must anchor to the safe bottom-left corner.");
+                        var chatOrigin = new Vector2(area.xMin, area.yMax - viewport.Height * referenceScale);
+                        var localChatCenter = (chatWindow.center - chatOrigin) / referenceScale;
+                        Check(Near(localChatCenter.x, 220f) && Near(localChatCenter.y, viewport.Height - 75f), name + " chat pointer coordinates must match its drawing matrix.");
+                        Check(Same(UiKit.ClampToArea(new Rect(-100f, -100f, area.width + 200f, area.height + 200f), area), area), name + " oversized panel must fit inside the safe rectangle.");
+                        var small = UiKit.ClampToArea(new Rect(viewport.Width, viewport.Height, 100f, 60f), area);
+                        Contained(small, area, name + " clamped panel");
+                        Check(Near(small.width, 100f) && Near(small.height, 60f), name + " fitting panels must retain their size.");
+
+                        float dp = TouchGeometry<float>("DensityScale", viewport.Width, viewport.Height, 460f);
+                        foreach (float scale in new[] { .65f, 1f, 1.3f })
+                        {
+                            TouchLayout.Reset(); TouchLayout.Scale = scale;
+                            for (int i = 0; i < TouchLayout.Actions.Length; i++)
+                                Contained(TouchGeometry<Rect>("ActionBounds", i, area, dp, scale), area, name + " action " + i);
+                            Contained(TouchGeometry<Rect>("ChatBounds", area, dp), area, name + " chat");
+                            var joystick = TouchGeometry<Rect>("JoystickBounds", area, dp);
+                            Contained(joystick, area, name + " joystick");
+                            Contained(TouchGeometry<Rect>("CameraStickBounds", area, dp), area, name + " camera stick");
+                            var outsideNotch = new Vector2(area.x - 1f, area.yMax - 1f);
+                            Check(!TouchGeometry<bool>("FloatingJoystickZone", outsideNotch, area), name + " notch must not acquire a joystick finger.");
+                            Check(!TouchGeometry<bool>("FloatingJoystickZone", new Vector2(area.x + 1f, area.yMax + 1f), area), name + " home-indicator strip must not acquire a joystick finger.");
+                            Check(TouchGeometry<bool>("FloatingJoystickZone", new Vector2(area.x + area.width * .1f, area.y + area.height * .7f), area), name + " safe left side must accept joystick movement.");
+                            foreach (var point in new[] { Vector2.zero, new Vector2(viewport.Width, viewport.Height), new Vector2(-1000f, -1000f), area.center })
+                            {
+                                float radius = joystick.width * .5f;
+                                var center = TouchGeometry<Vector2>("ClampJoystickCenter", point, radius, viewport.Height, area);
+                                Contained(new Rect(center.x - radius, viewport.Height - center.y - radius, radius * 2f, radius * 2f), area, name + " floating joystick drag");
+                            }
+                            layouts++;
+                        }
+                        TouchLayout.ControllerPreset();
+                        for (int i = 0; i < TouchLayout.ControlCount; i++)
+                        {
+                            TouchLayout.Spec(i).x = i % 2;
+                            TouchLayout.Spec(i).y = i % 3 == 0 ? 0f : 1f;
+                            TouchLayout.Spec(i).size = 1.8f;
+                            Rect rect = i == TouchLayout.Joystick ? TouchGeometry<Rect>("JoystickBounds", area, dp)
+                                : i == TouchLayout.CameraStick ? TouchGeometry<Rect>("CameraStickBounds", area, dp)
+                                : TouchGeometry<Rect>("ActionBounds", i, area, dp, 1.3f);
+                            Contained(rect, area, name + " custom edge control " + i);
+                        }
+                    }
+                }
+                results.Add("PASS: " + layouts + " default touch layouts across compact, SE, mini, Pro and Pro Max viewports, three scales and both landscape orientations.");
+                results.Add("PASS: asymmetric notch/top/home insets, reference coordinates, panel fitting, chat, custom edge controls and floating joystick bounds.");
+                results.Add("PASS: nano wheel bottom-right bounds and chat bottom-left bounds/pointer coordinates at the default HUD scale.");
+                Check(Same(UiKit.SafeGuiBounds(812, 375, Rect.zero), new Rect(0, 0, 812, 375)), "Missing safe-area data must use the full viewport.");
+                Check(Same(UiKit.SafeGuiBounds(812, 375, new Rect(float.NaN, 0, 100, 100)), new Rect(0, 0, 812, 375)), "Invalid safe-area data must use the full viewport.");
+                Check(Same(UiKit.SafeGuiBounds(812, 375, new Rect(-10, -20, 900, 420)), new Rect(0, 0, 812, 375)), "Overscan safe-area data must clip to the viewport.");
+                Check(Same(UiKit.SafeGuiBounds(812, 375, new Rect(900, 0, 100, 100)), new Rect(0, 0, 812, 375)), "A disjoint safe area must fall back to the viewport.");
+                Check(Near(TouchGeometry<float>("DensityScale", 1136f, 640f, 0f), 1f), "Unavailable DPI must keep a usable density fallback.");
+                Check(TouchGeometry<float>("DensityScale", 2796f, 1290f, 460f) > TouchGeometry<float>("DensityScale", 1136f, 640f, 460f), "Density must change when the surface changes size.");
+                results.Add("PASS: missing/invalid safe-area fallback, clipping and viewport-dependent density.");
+                CheckSurfaceChanges();
+                results.Add("PASS: viewport resize and safe-inset changes cancel held actions, invalidate density and reject old fingers until a fresh touch.");
+                results.Add("PASS: editor geometry regression only; physical iPhone playability is not asserted.");
+                Debug.Log("[iOS viewport regression] " + string.Join("\n", results));
+            }
+            catch (Exception error)
+            {
+                results.Add("FAIL: " + error);
+                throw;
+            }
+            finally
+            {
+                TouchLayout.Restore(layout);
+                Directory.CreateDirectory("Logs"); File.WriteAllLines(ResultPath, results);
+            }
+        }
+
+        static void CheckSurfaceChanges()
+        {
+            GameObject host = null;
+            try
+            {
+                TouchLayout.Reset(); host = new GameObject("iOS viewport regression"); var controls = host.AddComponent<TouchControls>();
+                typeof(TouchControls).GetMethod("Awake", HiddenInstance).Invoke(controls, null);
+                var frame = typeof(TouchControls).GetMethod("ProcessTouches", HiddenInstance);
+                var refresh = typeof(TouchControls).GetMethod("RefreshSurface", HiddenInstance);
+                var density = typeof(TouchControls).GetField("dpScale", HiddenInstance);
+                float width = Screen.width > 0 ? Screen.width : 1280f, height = Screen.height > 0 ? Screen.height : 720f;
+                var area = TouchControls.LayoutArea;
+                Vector2 attack = controls.LayoutRect(0).center; attack.y = height - attack.y;
+                Action<int, TouchPhase> finger = (id, phase) => frame.Invoke(controls, new object[] { new[] { new Touch { fingerId = id, position = attack, phase = phase } }, true, false });
+                finger(71, TouchPhase.Began);
+                Check(TouchControls.Held(ControlMap.K.Fire1), "Viewport transition fixture must start with a held attack.");
+                refresh.Invoke(controls, new object[] { width, height, area });
+                Check(TouchControls.Held(ControlMap.K.Fire1), "An unchanged viewport must preserve held fingers.");
+                density.SetValue(controls, 3f);
+                refresh.Invoke(controls, new object[] { width + 1f, height, area });
+                Check(!TouchControls.Held(ControlMap.K.Fire1) && (float)density.GetValue(controls) == 0f, "A resized viewport must release actions and invalidate cached density.");
+                finger(71, TouchPhase.Moved);
+                Check(!TouchControls.Held(ControlMap.K.Fire1), "An existing finger must not reacquire an action after resize.");
+                finger(72, TouchPhase.Began);
+                Check(TouchControls.Down(ControlMap.K.Fire1), "A fresh finger must work after resize.");
+                density.SetValue(controls, 3f);
+                refresh.Invoke(controls, new object[] { width, height, new Rect(area.x + 1f, area.y, area.width - 1f, area.height) });
+                Check(!TouchControls.Held(ControlMap.K.Fire1) && (float)density.GetValue(controls) == 0f, "Changing only the safe insets must release actions and invalidate cached density.");
+                finger(72, TouchPhase.Stationary);
+                Check(!TouchControls.Held(ControlMap.K.Fire1), "An existing finger must not reacquire an action after an inset change.");
+                finger(73, TouchPhase.Began);
+                Check(TouchControls.Down(ControlMap.K.Fire1), "A fresh finger must work after an inset change.");
+            }
+            finally
+            {
+                if (host != null)
+                {
+                    typeof(TouchControls).GetMethod("OnDestroy", HiddenInstance).Invoke(host.GetComponent<TouchControls>(), null);
+                    UnityEngine.Object.DestroyImmediate(host);
+                }
+            }
+        }
+
+        public static void Batch()
+        {
+            try { Run(); EditorApplication.Exit(0); }
+            catch (Exception error) { Debug.LogException(error); EditorApplication.Exit(1); }
+        }
+    }
+}
