diff --git a/Assets/Scripts/OpenFusion/GameClient.TouchCamera.cs b/Assets/Scripts/OpenFusion/GameClient.TouchCamera.cs
new file mode 100644
index 0000000..161b29a
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/GameClient.TouchCamera.cs
@@ -0,0 +1,111 @@
+using UnityEngine;
+using OpenFusion.World;
+
+namespace OpenFusion
+{
+    public sealed partial class GameClient
+    {
+        const float TouchLookGain = .4f;
+        TouchCameraRig touchRig;
+        SkinnedMeshRenderer touchBody;
+        bool touchPoseLogged, touchMoveReported;
+        float touchPoseReportAt;
+        float touchMoveReportAt;
+        int touchMoveReports;
+        Collider touchCameraObstacle;
+        static readonly RaycastHit[] touchCameraHits = new RaycastHit[32];
+        bool UseNaturalTouchCamera => Application.platform == RuntimePlatform.IPhonePlayer ||
+            (TouchControls.Instance != null && TouchControls.Instance.ForceInEditor);
+        bool NaturalTouchMode => TouchControls.Active && UseNaturalTouchCamera;
+        bool IndependentTouchMovement => !AimActive && !swimming && Vehicle <= 0 && dashT <= 0f;
+
+        void EnsureCameraOrbit(Transform player)
+        {
+            if (camInit) return;
+            camInit = true;
+            if (UseNaturalTouchCamera)
+            {
+                // Equipment, weapons, shadows and particles must not increase
+                // the orbit height. The main skinned body owns the full skeleton.
+                foreach (var renderer in player.GetComponentsInChildren<SkinnedMeshRenderer>())
+                    if (renderer.sharedMesh != null && (touchBody == null || renderer.bones.Length > touchBody.bones.Length)) touchBody = renderer;
+                touchRig = new TouchCameraRig(touchBody != null ? touchBody.bounds.size.y : 0f);
+            }
+            camDist = UseNaturalTouchCamera ? touchRig.Distance : CamDefaultDist;
+            camPitch = UseNaturalTouchCamera ? TouchCameraRig.DefaultPitch : CamDefaultPitch;
+            camYaw = UseNaturalTouchCamera ? player.eulerAngles.y : 0f;
+            touchPoseReportAt = Time.unscaledTime + 2f;
+        }
+
+        void ReportTouchCameraPose(Camera camera, Transform player)
+        {
+            if (!UseNaturalTouchCamera) return;
+            if (!TouchControls.JoystickHeld) { touchMoveReportAt = Time.unscaledTime + 1f; touchMoveReported = false; }
+            bool heldReport = TouchControls.JoystickHeld && !touchMoveReported && touchMoveReports < 8 && Time.unscaledTime >= touchMoveReportAt;
+            if ((touchPoseLogged || Time.unscaledTime < touchPoseReportAt) && !heldReport) return;
+            touchPoseLogged = true;
+            if (heldReport) { touchMoveReported = true; touchMoveReports++; }
+            string bounds = touchBody != null ? " bodyMin=" + touchBody.bounds.min + " bodyMax=" + touchBody.bounds.max +
+                " bodyViewport=" + camera.WorldToViewportPoint(touchBody.bounds.center) + " bodyEnabled=" + touchBody.enabled : " body=fallback";
+            var pivot = player.position + Vector3.up * touchRig.PivotHeight;
+            Report("[touch-camera] feet=" + player.position + " camera=" + camera.transform.position +
+                " bodyHeight=" + touchRig.BodyHeight.ToString("F2") + " pivotHeight=" + touchRig.PivotHeight.ToString("F2") +
+                " pitch=" + camPitch.ToString("F1") + " yaw=" + camYaw.ToString("F1") + " distance=" + camDist.ToString("F2") +
+                " actualDistance=" + Vector3.Distance(camera.transform.position, pivot).ToString("F2") +
+                " obstruction=" + (touchCameraObstacle != null ? touchCameraObstacle.name : "none") +
+                " move=" + TouchControls.Move + " aim=" + AimActive +
+                " near=" + camera.nearClipPlane.ToString("F2") +
+                " sensitivity=" + ControlMap.CameraSensitivity.ToString("F1") + " invertY=" + ControlMap.FlipCameraY + bounds);
+        }
+
+        internal static Vector3 TouchMoveDirection(Vector2 input, float yaw)
+            => input.sqrMagnitude > .01f ? Quaternion.Euler(0f, yaw, 0f) * Vector3.ClampMagnitude(new Vector3(input.x, 0f, input.y), 1f) : Vector3.zero;
+
+        internal static bool TryTouchCameraObstruction(Vector3 origin, Vector3 direction, float distance, Transform player, int mask, out RaycastHit closest)
+        {
+            closest = default;
+            if (distance <= 0f) return false;
+            // A small volume protects the view at wall edges. The player's own
+            // animated body/equipment must never collapse its follow camera.
+            int count = Physics.SphereCastNonAlloc(origin, .18f, direction, touchCameraHits, distance, mask, QueryTriggerInteraction.Ignore);
+            var hits = touchCameraHits;
+            // NonAlloc results are unordered. If saturated, retain correctness
+            // in dense geometry instead of potentially losing the nearest wall.
+            if (count == hits.Length) { hits = Physics.SphereCastAll(origin, .18f, direction, distance, mask, QueryTriggerInteraction.Ignore); count = hits.Length; }
+            float nearest = float.PositiveInfinity;
+            for (int i = 0; i < count; i++)
+            {
+                var hit = hits[i];
+                if (hit.collider == null || hit.collider is CharacterController ||
+                    player != null && (hit.transform == player || hit.transform.IsChildOf(player)) || hit.distance >= nearest) continue;
+                closest = hit; nearest = hit.distance;
+            }
+            return nearest < float.PositiveInfinity;
+        }
+
+        internal static Vector3 TouchCameraPosition(Vector3 pivot, Quaternion rotation, float distance, Transform player, int mask, bool collision, out Collider obstacle)
+        {
+            var back = rotation * Vector3.back;
+            obstacle = null;
+            if (collision && TryTouchCameraObstruction(pivot, back, distance, player, mask, out var hit))
+            { distance = Mathf.Max(.1f, hit.distance - .05f); obstacle = hit.collider; }
+            // Follow the live pivot immediately. Interpolating world positions
+            // lets backward movement catch the camera; interpolating orbit
+            // chords can pass through the body during a large turn.
+            return CorrectTouchCameraFloor(pivot + back * distance, player);
+        }
+
+        internal static Vector3 CorrectTouchCameraFloor(Vector3 desired, Transform player)
+        {
+            // Check only the local floor, not a roof or a terrain far above an
+            // indoor camera. The pivot-to-camera wall collision remains intact.
+            if (Ground.TrySupport(desired, player, .25f, .5f, 60f, out float floor))
+                desired.y = Mathf.Max(desired.y, floor + .25f);
+            return desired;
+        }
+
+        internal static float CorrectLocalTerrainHeight(float feet, float terrain, float step, float skin)
+            => terrain > feet && terrain - feet <= Mathf.Max(step, skin + .02f) ? terrain : feet;
+
+    }
+}
