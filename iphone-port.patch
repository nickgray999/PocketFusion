+#!/usr/bin/env python3
+"""Run production session-owner teardown bodies with observable lifetime stubs."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+
+
+def body(path, signature):
+    source = (root / path).read_text()
+    start = source.index("{", source.index(signature))
+    depth = 1
+    end = start + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+bootstrap = (root / "Assets/Scripts/OpenFusion/WorldBootstrap.cs").read_text()
+combat = (root / "Assets/Scripts/OpenFusion/World/CombatSystem.cs").read_text()
+# The stored delegates must actually be the providers assigned at registration.
+for registration in (
+    "TransportWindow.NpcPortrait = ownedNpcPortrait =",
+    "AnimEventSink.FaceTexture = ownedFaceTexture =",
+):
+    assert registration in bootstrap, "Review provider ownership at registration: " + registration
+assert "AnimEventSink.AttackSound = ownedAttackSound = WeaponSound;" in combat
+
+harness = r'''
+class Resource { public int Destroyed; public bool Released; public void Release()=>Released=true; }
+class Texture : Resource { }
+class AudioClip : Resource { }
+class GameObject : Resource { }
+class Camera : Resource { public GameObject gameObject=new(); }
+class Transform { }
+struct Rect { }
+class Models { }
+class Catalog { }
+class AnimationCurve { }
+static class Application { public static bool isPlaying=true; }
+class Behaviour {
+ public int CoroutinesStopped;
+ protected void StopAllCoroutines()=>CoroutinesStopped++;
+ protected static void Destroy(Resource resource)=>resource.Destroyed++;
+ protected static void DestroyImmediate(Resource resource)=>resource.Destroyed++;
+}
+class Events { public event Action Teleported,Unhandled,PcEnter; public void Signal(){Teleported?.Invoke();Unhandled?.Invoke();PcEnter?.Invoke();} }
+static class AnimEventSink {
+ public static Func<string,Texture> FaceTexture;
+ public static Func<Transform,string> AttackSound;
+}
+static class TransportWindow { public static Func<int,Texture> NpcPortrait; }
+static class NpcUI { public static object MobTarget; }
+class Bootstrap : Behaviour {
+ public int warpGeneration;
+ public Events Entities=new();
+ public Models Models=new();
+ public object Avatars=new(),Bundles=new(),streamer=new(),cache=new(),pendingTables=new(),Player=new();
+ public event Action<string,float> Status;
+ public Func<string,Texture> ownedFaceTexture;
+ public Func<int,Texture> ownedNpcPortrait;
+ public int Teleports;
+ public Bootstrap(){Entities.Teleported+=OnTeleport;Status+=(s,p)=>{};}
+ void OnTeleport()=>Teleports++;
+ public bool StatusCleared=>Status==null;
+ public void Bind(){
+  AnimEventSink.FaceTexture=ownedFaceTexture=name=>Models!=null?new Texture():null;
+  TransportWindow.NpcPortrait=ownedNpcPortrait=id=>Player!=null?new Texture():null;
+ }
+ public void Close() __BOOTSTRAP__
+}
+class Combat : Behaviour {
+ public Events disp=new();
+ public Func<Transform,string> ownedAttackSound;
+ public int Packets;
+ public Combat(){disp.Unhandled+=OnPacket;}
+ void OnPacket()=>Packets++;
+ string WeaponSound(Transform t)=>"weapon";
+ public void Bind(){AnimEventSink.AttackSound=ownedAttackSound=WeaponSound;}
+ public void Close() __COMBAT__
+}
+class Sfx : Behaviour {
+ public static Sfx Instance;
+ public Models models=new();
+ public Transform Listener=new();
+ public Dictionary<string,AudioClip> cache=new();
+ public Dictionary<string,List<Action<AudioClip>>> waiting=new();
+ public Dictionary<string,float> missingUntil=new();
+ public AnimationCurve rolloff=new();
+ public string dir="sfx";
+ public int active=3;
+ public void Close() __SFX__
+}
+class Nano : Behaviour {
+ public static Nano inst;
+ public static Texture StationBackdrop;
+ public static Rect StationBackdropFit,StationBackdropView;
+ public class Entry { public Resource Rt=new();public GameObject Go=new(); }
+ public Dictionary<int,Entry> map=new();
+ public Dictionary<int,float> sink=new();
+ public Models models=new();public Catalog catalog=new();
+ public Resource backMat=new();public GameObject backQuad=new();public Camera cam=new();
+ public void Close() __NANO__
+}
+class Bullet : Behaviour {
+ public static Bullet Instance;
+ public Models models=new();public object rows=new();
+ public HashSet<int> missing=new(),unknownRows=new();
+ public void Close() __BULLET__
+}
+class InventoryWindow { public static InventoryWindow Instance; public object Mode; }
+class NumPad {
+ public bool Open=true,Gum=true,Use=true,Give=true;
+ public Action<int> OnOk,onGive; public Action OnTrash,onDelete;
+ public Texture GumIcon=new(),tBox=new(),tBack=new();
+ public Texture[] giveNano={new()}; public bool[] giveOk={true};
+ public string Title="title",Label="label",GumName="item",GumDesc="description",LevelLine="level";
+ public void Clear() __PAD__
+ public bool ActionsCleared=>OnOk==null&&OnTrash==null&&onGive==null&&onDelete==null;
+ public bool ResourcesCleared=>GumIcon==null&&giveNano==null&&giveOk==null&&tBox==null&&tBack==null;
+}
+class ModalWindow : Behaviour {
+ public static ModalWindow Current; public static bool Overlayed;
+ public Func<string,Texture> TexLoader;
+ public Events disp=new(); public object ents=new(),tables,hud=new(),journal=new(),msgT;
+ public System.Collections.Concurrent.ConcurrentQueue<Action> q=new();
+ public NumPad pad=new(); public Action msgYes,msgAny; public Action<Rect> infoButtons;
+ public Texture back=new(),frame=new(),tarosIco=new();
+ public bool open=true,waiting=true,infoOpen=true; public string msg="message";
+ protected virtual object InvMode=>this;
+ public int Packets,DeferredCalls;
+ public ModalWindow(){disp.Unhandled+=OnPacket;}
+ protected virtual void OnPacket()=>Packets++;
+ protected virtual void OnDestroy() __MODAL__
+ public void Close()=>OnDestroy();
+ [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]
+ public WeakReference Prime(){
+  var bytes=new byte[8*1024*1024];tables=msgT=bytes;
+  TexLoader=s=>{GC.KeepAlive(bytes);return null;};
+  Action pending=()=>{DeferredCalls++;GC.KeepAlive(bytes);};
+  q.Enqueue(pending);msgYes=msgAny=pending;infoButtons=r=>pending();
+  pad.OnOk=pad.onGive=v=>pending();pad.OnTrash=pad.onDelete=pending;
+  return new WeakReference(bytes);
+ }
+ public bool ReferencesCleared=>disp==null&&ents==null&&tables==null&&hud==null&&journal==null&&msgT==null&&TexLoader==null;
+ public bool DeferredCleared=>q.IsEmpty&&msgYes==null&&msgAny==null&&infoButtons==null&&pad.ActionsCleared;
+ public bool PresentationCleared=>!open&&!waiting&&!infoOpen&&msg==null&&back==null&&frame==null&&tarosIco==null&&!pad.Open&&!pad.Gum&&!pad.Use&&!pad.Give&&pad.ResourcesCleared;
+}
+class BankWindow : ModalWindow {
+ public static BankWindow Instance;
+ public BankWindow(){Instance=this;}
+ protected override void OnDestroy() __BANK__
+}
+class VendorWindow : ModalWindow {
+ public static VendorWindow Instance; public static bool ReturnToStore;
+ public List<object> list=new(){new()};
+ public VendorWindow(){Instance=this;}
+ protected override void OnDestroy() __VENDOR__
+}
+class TradeWindow : ModalWindow {
+ public static TradeWindow Instance;
+ public Dictionary<int,object> names=new(){{1,new()}},uids=new(){{1,new()}},apps=new(){{1,new()}};
+ public List<string> chat=new(){"message"};
+ public object faceOwn=new(),faceOther=new(),snap=new(),field=new();
+ public bool active=true,InviteShown=true; public int PlayerEnters;
+ public TradeWindow(){Instance=this;disp.PcEnter+=OnPcEnter;}
+ void OnPcEnter()=>PlayerEnters++;
+ protected override void OnDestroy() __TRADE__
+ public bool TradeReferencesCleared=>names.Count==0&&uids.Count==0&&apps.Count==0&&chat.Count==0&&faceOwn==null&&faceOther==null&&snap==null&&field==null&&!active&&!InviteShown;
+}
+class Program {
+ static int assertions;
+ static void Check(bool condition,string message){assertions++;if(!condition)throw new Exception(message);}
+ static void Main(){
+  var first=new Bootstrap();first.Bind();var oldEvents=first.Entities;
+  oldEvents.Signal();Check(first.Teleports==1,"Fixture must have a live subscription.");
+  first.Close();oldEvents.Signal();
+  Check(first.Teleports==1&&first.warpGeneration==1,"Destroyed bootstrap must detach teleport and invalidate warp work.");
+  Check(AnimEventSink.FaceTexture==null&&TransportWindow.NpcPortrait==null,"Owned static providers must release their scene closures.");
+  Check(first.ownedFaceTexture==null&&first.ownedNpcPortrait==null,"Owner must drop its stored provider delegates too.");
+  Check(first.Models==null&&first.Avatars==null&&first.Bundles==null&&first.streamer==null&&first.cache==null&&first.pendingTables==null,
+   "Bootstrap must release models, avatars, bundle/download stores and tables.");
+  Check(first.Entities==null&&first.Player==null&&first.StatusCleared,"Bootstrap must release remaining scene state and callbacks.");
+  first.Close();Check(first.warpGeneration==2,"Bootstrap teardown may be repeated without accessing cleared references.");
+  first=new Bootstrap();first.Bind();var newer=new Bootstrap();newer.Bind();
+  var currentFace=AnimEventSink.FaceTexture;var currentPortrait=TransportWindow.NpcPortrait;
+  first.Close();Check(AnimEventSink.FaceTexture==currentFace&&TransportWindow.NpcPortrait==currentPortrait,
+   "Destroying an older bootstrap must not clear a newer scene's providers.");
+  newer.Close();Check(AnimEventSink.FaceTexture==null&&TransportWindow.NpcPortrait==null,"Newest bootstrap must still release its own providers.");
+
+  var combat=new Combat();combat.Bind();var packetEvents=combat.disp;NpcUI.MobTarget=new();
+  combat.Close();packetEvents.Signal();
+  Check(combat.Packets==0&&AnimEventSink.AttackSound==null&&combat.ownedAttackSound==null&&NpcUI.MobTarget==null,
+   "Combat must unhook packets and its own global audio delegate.");
+  combat=new Combat();combat.Bind();var newerCombat=new Combat();newerCombat.Bind();var currentSound=AnimEventSink.AttackSound;
+  combat.Close();Check(AnimEventSink.AttackSound==currentSound,"Older combat teardown must preserve a newer sound provider.");
+  newerCombat.Close();Check(AnimEventSink.AttackSound==null,"Newest combat teardown must clear its sound provider.");
+
+  foreach(bool playing in new[]{true,false}){
+   Application.isPlaying=playing;
+   var sfx=new Sfx();Sfx.Instance=sfx;var clip=new AudioClip();sfx.cache["one"]=clip;
+   sfx.waiting["one"]=new(){c=>{}};sfx.missingUntil["two"]=1f;sfx.Close();
+   Check(Sfx.Instance==null&&sfx.models==null&&sfx.Listener==null&&sfx.rolloff==null&&sfx.dir==null&&sfx.active==0,
+    "Sound teardown must release its singleton, model graph and listener.");
+   Check(clip.Destroyed==1&&sfx.cache.Count==0&&sfx.waiting.Count==0&&sfx.missingUntil.Count==0&&sfx.CoroutinesStopped==1,
+    "Sound teardown must stop pending coroutines, drop callbacks and destroy session audio.");
+   sfx.Close();Check(clip.Destroyed==1,"Repeated sound teardown must not destroy an audio clip twice.");
+  }
+  var oldSfx=new Sfx();var newSfx=new Sfx();Sfx.Instance=newSfx;oldSfx.Close();
+  Check(Sfx.Instance==newSfx,"Old sound teardown must preserve a new singleton.");newSfx.Close();
+
+  var nano=new Nano();Nano.inst=nano;Nano.StationBackdrop=new();
+  var entry=new Nano.Entry();var mat=nano.backMat;var cameraGo=nano.cam.gameObject;
+  nano.map[1]=entry;nano.sink[1]=.5f;nano.Close();
+  Check(Nano.inst==null&&Nano.StationBackdrop==null&&nano.models==null&&nano.catalog==null&&nano.map.Count==0&&nano.sink.Count==0,
+   "Nano teardown must release its singleton, model graph and entry caches.");
+  Check(entry.Rt.Released&&entry.Rt.Destroyed==1&&entry.Go.Destroyed==1&&mat.Destroyed==1&&cameraGo.Destroyed==1,
+   "Nano teardown must release render targets, preview objects and owned camera material.");
+  Check(nano.backMat==null&&nano.backQuad==null&&nano.cam==null,"Nano teardown must drop native-resource wrappers.");
+  nano.Close();Check(entry.Rt.Destroyed==1,"Repeated nano teardown must not destroy old entries twice.");
+  var oldNano=new Nano();var newNano=new Nano();Nano.inst=newNano;var backdrop=Nano.StationBackdrop=new();oldNano.Close();
+  Check(Nano.inst==newNano&&Nano.StationBackdrop==backdrop,"Old nano teardown must preserve a new singleton and its backdrop.");newNano.Close();
+
+  var bullet=new Bullet();Bullet.Instance=bullet;bullet.missing.Add(1);bullet.unknownRows.Add(2);bullet.Close();
+  Check(Bullet.Instance==null&&bullet.models==null&&bullet.rows==null&&bullet.missing.Count==0&&bullet.unknownRows.Count==0&&bullet.CoroutinesStopped==1,
+   "Bullet teardown must release its singleton, model graph and lookups.");
+  var oldBullet=new Bullet();var newBullet=new Bullet();Bullet.Instance=newBullet;oldBullet.Close();
+  Check(Bullet.Instance==newBullet,"Old bullet teardown must preserve a new singleton.");newBullet.Close();
+
+  foreach(var window in new ModalWindow[]{new BankWindow(),new VendorWindow(),new TradeWindow()}){
+   var payload=window.Prime();var modalEvents=window.disp;
+   var borrowed=new[]{window.back,window.frame,window.tarosIco,window.pad.GumIcon,window.pad.tBox,window.pad.tBack,window.pad.giveNano[0]};
+   InventoryWindow.Instance=new(){Mode=window};ModalWindow.Current=window;ModalWindow.Overlayed=true;
+   VendorWindow.ReturnToStore=true;
+   modalEvents.Signal();Check(window.Packets==1,"The modal fixture must start with a live packet subscription.");
+   var enters=window is TradeWindow trade?trade.PlayerEnters:0;
+   window.Close();modalEvents.Signal();
+   Check(window.Packets==1,"Modal teardown must unsubscribe before dropping its dispatcher.");
+   Check(window.ReferencesCleared,"A stale modal shell must release tables, world components, dispatcher and texture provider.");
+   Check(window.DeferredCleared&&window.DeferredCalls==0,"Modal teardown must discard queued and nested item callbacks without invoking them.");
+   Check(window.PresentationCleared,"Modal teardown must release borrowed presentation references and close local overlays.");
+   Check(borrowed.All(texture=>texture.Destroyed==0),"Modal teardown must not destroy textures borrowed by other scene users.");
+   Check(ModalWindow.Current==null&&!ModalWindow.Overlayed&&InventoryWindow.Instance.Mode==null,
+    "Modal teardown must release only its owned current window and inventory mode.");
+   if(window is BankWindow)Check(BankWindow.Instance==null,"Destroyed bank must clear its singleton.");
+   if(window is VendorWindow vendor)Check(VendorWindow.Instance==null&&!VendorWindow.ReturnToStore&&vendor.list.Count==0,
+    "Destroyed vendor must clear its singleton, store-return flag and item list.");
+   if(window is TradeWindow traded)Check(TradeWindow.Instance==null&&traded.PlayerEnters==enters&&traded.TradeReferencesCleared,
+    "Trade teardown must unsubscribe player events before base cleanup and drop its session/portrait state.");
+   GC.Collect();GC.WaitForPendingFinalizers();GC.Collect();
+   Check(!payload.IsAlive,"Old table and callback payloads must collect while the destroyed modal shell remains reachable.");
+   window.Close();Check(window.ReferencesCleared&&window.DeferredCleared,"Modal teardown must be idempotent.");
+   GC.KeepAlive(window);
+  }
+  foreach(int kind in new[]{0,1,2}){
+   ModalWindow Make()=>kind==0?new BankWindow():kind==1?new VendorWindow():new TradeWindow();
+   var oldModal=Make();oldModal.Prime();var newModal=Make();newModal.Prime();
+   ModalWindow.Current=newModal;ModalWindow.Overlayed=true;InventoryWindow.Instance=new(){Mode=newModal};
+   VendorWindow.ReturnToStore=true;oldModal.Close();
+   Check(ModalWindow.Current==newModal&&ModalWindow.Overlayed&&ReferenceEquals(InventoryWindow.Instance.Mode,newModal),
+    "Older modal teardown must preserve a newer current window, overlay and inventory mode.");
+   Check(kind==0?ReferenceEquals(BankWindow.Instance,newModal):kind==1?ReferenceEquals(VendorWindow.Instance,newModal)&&VendorWindow.ReturnToStore:ReferenceEquals(TradeWindow.Instance,newModal),
+    "Older service teardown must preserve the newer singleton and its owned state.");
+   newModal.Close();
+  }
+  Console.WriteLine($"PASS {assertions} assertions using production session-owner teardown bodies (lifetime stubs; no Unity/device memory measurement).");
+ }
+}
+'''
+
+for token, path in (
+    ("BOOTSTRAP", "WorldBootstrap.cs"),
+    ("COMBAT", "World/CombatSystem.cs"),
+    ("SFX", "World/Sfx.cs"),
+    ("NANO", "World/NanoModelRt.cs"),
+    ("BULLET", "World/BulletFx.cs"),
+    ("MODAL", "World/ModalWindow.cs"),
+    ("BANK", "World/BankWindow.cs"),
+    ("VENDOR", "World/VendorWindow.cs"),
+    ("TRADE", "World/TradeWindow.cs"),
+):
+    harness = harness.replace("__" + token + "__", body("Assets/Scripts/OpenFusion/" + path, "void OnDestroy()"))
+harness = harness.replace("__PAD__", body("Assets/Scripts/OpenFusion/World/ModalWindow.cs", "public void Clear()"))
+
+dotnet = os.environ.get("DOTNET_EXE")
+if not dotnet:
+    dotnet = next((str(p) for p in (root / ".tools/dotnet/dotnet", root.parent / ".tools/dotnet/dotnet") if p.is_file()), None)
+dotnet = dotnet or shutil.which("dotnet")
+if not dotnet:
+    raise SystemExit("A local .NET 8 SDK is required; set DOTNET_EXE.")
+with tempfile.TemporaryDirectory(prefix="openfusion-session-cleanup-") as directory:
+    work = Path(directory)
+    (work / "Program.cs").write_text(harness)
+    (work / "Check.csproj").write_text('<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><RestoreSources>/nonexistent</RestoreSources><ImplicitUsings>enable</ImplicitUsings><NuGetAudit>false</NuGetAudit></PropertyGroup></Project>')
+    env = dict(os.environ, DOTNET_CLI_HOME=str(work / "cli"), DOTNET_SKIP_FIRST_TIME_EXPERIENCE="1", DOTNET_CLI_TELEMETRY_OPTOUT="1", DOTNET_GENERATE_ASPNET_CERTIFICATE="false", DOTNET_NOLOGO="1")
+    subprocess.run([dotnet, "run", "--project", str(work / "Check.csproj")], cwd=root, env=env, check=True)
