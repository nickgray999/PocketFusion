+                var fold = host.AddComponent<FoldScreenController>(); typeof(FoldScreenController).GetMethod("Awake", HiddenInstance).Invoke(fold, null);
+                var apply = typeof(FoldScreenController).GetMethod("ApplyLayout", HiddenInstance);
+                var worldReady = typeof(FoldScreenController).GetField("worldReady", HiddenInstance);
+                worldReady.SetValue(fold, false);
+                var process = typeof(TouchControls).GetMethod("ProcessTouches", HiddenInstance);
+                PlayerHud.StatusScreen = NanocomHud.MinimapScreen = NanocomHud.MissionScreen = Rect.zero;
+                TouchLayout.Reset(); TouchLayout.CameraStickEnabled = true;
+                float width = Screen.width, height = Screen.height;
+                Check(width > 0 && height > 0, "Camera fixture needs a real Editor viewport.");
+                var world = new Rect(0, 0, width, height * .45f);
+                var control = new Rect(0, height * .55f, width, height * .45f);
+                Vector2 ToScreen(Vector2 gui) => new Vector2(gui.x, height - gui.y);
+                Touch Finger(int id, Vector2 gui, TouchPhase phase) => new Touch { fingerId = id, position = ToScreen(gui), phase = phase };
+                void Frame(params Touch[] touches) => process.Invoke(touch, new object[] { touches, true, false });
+                void finger(int id, Vector2 gui, TouchPhase phase) => Frame(Finger(id, gui, phase));
+
+                Vector2 attack = touch.LayoutRect(0).center;
+                finger(101, attack, TouchPhase.Began);
+                Check(TouchControls.Held(ControlMap.K.Fire1), "Transition fixture must begin with an owned attack finger.");
+                SeedDock(dock);
+                apply.Invoke(fold, new object[] { true, world, control });
+                Check(FoldScreenController.Active && Same(TouchControls.LayoutArea, control) && Same(UiKit.HudArea, control)
+                    && Same(UiKit.WorldHudArea, world), "Folded controls and world HUD must follow their respective lower and upper panes.");
+                Check(Same(camera.pixelRect, new Rect(world.x, height - world.yMax, world.width, world.height)), "World camera must render into the upper pane using bottom-left camera coordinates.");
+                var aim = (Vector2)typeof(CombatSystem).GetMethod("AimScreenPoint", HiddenStatic).Invoke(null, new object[] { camera });
+                Check(Same(aim, camera.pixelRect.center), "Combat aiming must use the upper camera's viewport centre.");
+                Check(Same(FoldScreenController.PanelArea, control) && Near(FoldScreenController.PanelWidth, control.width) && Near(FoldScreenController.PanelHeight, control.height),
+                    "Before world readiness, launcher/character/loading panels must use the entire lower safe canvas without a gameplay selector rail.");
+                CheckControlCanvas(control, results);
+                worldReady.SetValue(fold, true);
+                Contained(FoldScreenController.PanelArea, control, "interactive panel canvas");
+                Check(FoldScreenController.PanelArea.xMin > control.xMin && Near(FoldScreenController.PanelArea.yMin, control.yMin)
+                    && Near(FoldScreenController.PanelArea.xMax, control.xMax) && Near(FoldScreenController.PanelArea.yMax, control.yMax),
+                    "Ready-world panels must reserve only the selector rail while retaining the lower pane's other boundaries.");
+                Rect readyPanel = FoldScreenController.PanelArea;
+                worldReady.SetValue(fold, false);
+                Check(Same(FoldScreenController.PanelArea, control), "Returning to preworld UI must release the gameplay rail without retaining its offset.");
+                worldReady.SetValue(fold, true);
+                Check(Same(FoldScreenController.PanelArea, readyPanel), "Returning to the world must restore the same rail exactly, without compounding offsets.");
+                Check(!TouchControls.Held(ControlMap.K.Fire1) && !TouchControls.JoystickHeld && !TouchControls.CameraHeld, "Entering a fold must release every held role.");
+                CheckDockClear(dock, "enter");
+                finger(101, attack, TouchPhase.Moved);
+                Check(!TouchControls.Held(ControlMap.K.Fire1), "A pre-transition finger cannot reacquire an action without Began.");
+
+                Vector2 worldTap = world.center;
+                finger(102, worldTap, TouchPhase.Began);
+                finger(102, worldTap + Vector2.right * 2, TouchPhase.Moved);
+                Check(!TouchControls.JoystickHeld && !TouchControls.CameraHeld && TouchControls.Move == Vector2.zero && TouchControls.Look == Vector2.zero, "The upper view must never acquire movement or camera drag.");
+                foreach (var key in TouchLayout.Actions) Check(!TouchControls.Held(key), "A world-selection touch cannot hold an action.");
+                finger(102, worldTap, TouchPhase.Ended);
+                Check(TouchControls.TryTap(out var directTap) && Same(directTap, ToScreen(worldTap)), "A short upper-view tap must retain its real world-picking point.");
+
+                PlayerHud.StatusScreen = new Rect(world.xMin, world.yMin, world.width * .25f, world.height * .15f);
+                NanocomHud.MinimapScreen = new Rect(world.xMax - world.width * .20f, world.yMin, world.width * .20f, world.height * .25f);
+                foreach (Rect widget in new[] { PlayerHud.StatusScreen, NanocomHud.MinimapScreen })
+                {
+                    finger(109, widget.center, TouchPhase.Began); finger(109, widget.center, TouchPhase.Ended);
+                    Check(!TouchControls.TryTap(out _), "Tapping health or the minimap must not also select a world target underneath.");
+                }
+
+                Vector2 bottomTap = new Vector2(control.xMin + control.width * .52f, control.yMin + control.height * .35f);
+                finger(103, bottomTap, TouchPhase.Began); finger(103, bottomTap, TouchPhase.Ended);
+                Check(TouchControls.TryTap(out var mappedTap) && Same(mappedTap, camera.pixelRect.center), "A lower LOOK tap must select/interact at the upper camera's centre.");
+
+                foreach (bool fixedJoystick in new[] { false, true })
+                {
+                    TouchLayout.FixedJoystick = fixedJoystick;
+                    var move = touch.LayoutRect(TouchLayout.Joystick);
+                    var upperEdge = new Vector2(move.center.x, move.yMin + move.height * .08f);
+                    finger(107, upperEdge, TouchPhase.Began);
+                    Check(TouchControls.JoystickHeld, "The upper edge of the raised MOVE pad must acquire the thumb.");
+                    finger(107, upperEdge, TouchPhase.Ended);
+                    finger(105, move.center, TouchPhase.Began);
+                    Check(TouchControls.JoystickHeld && !TouchControls.CameraHeld, "The visible inset movement pad must acquire movement in both floating and fixed modes.");
+                    finger(105, move.center + Vector2.right * move.width * .3f, TouchPhase.Moved);
+                    Check(TouchControls.Move.x > .2f && TouchControls.Look == Vector2.zero, "Moving from the visible movement pad must produce WASD movement without camera input.");
+                    finger(105, move.center, TouchPhase.Ended);
+                    Check(!TouchControls.JoystickHeld, "Releasing the movement pad must release its gesture.");
+                }
+                TouchLayout.FixedJoystick = false;
+                var lookPad = touch.LayoutRect(TouchLayout.CameraStick);
+                finger(106, lookPad.center, TouchPhase.Began);
+                Check(TouchControls.CameraHeld && !TouchControls.JoystickHeld, "The visible inset LOOK pad must acquire camera input independently of movement.");
+                finger(106, lookPad.center, TouchPhase.Ended);
+                Check(!TouchControls.CameraHeld, "Releasing the LOOK pad must release camera input.");
+
+                var movePad = touch.LayoutRect(TouchLayout.Joystick);
+                var walk = movePad.center + Vector2.down * movePad.height * .3f;
+                var turn = lookPad.center + Vector2.right * lookPad.width * .375f;
+                Frame(Finger(110, movePad.center, TouchPhase.Began), Finger(111, lookPad.center, TouchPhase.Began));
+                Frame(Finger(110, walk, TouchPhase.Moved), Finger(111, turn, TouchPhase.Moved));
+                int moveGesture = TouchControls.JoystickGestureId;
+                var expectedTurn = TouchGeometry<Vector2>("CameraStickLook", Vector2.right * .75f, Time.unscaledDeltaTime, false);
+                foreach (var action in new[] { ControlMap.K.Jump, ControlMap.K.Fire1 })
+                {
+                    var button = touch.LayoutRect(Array.IndexOf(TouchLayout.Actions, action)).center;
+                    foreach (var phase in new[] { TouchPhase.Began, TouchPhase.Stationary, TouchPhase.Ended })
+                    {
+                        Frame(Finger(111, turn, TouchPhase.Stationary), Finger(112, button, phase), Finger(110, walk, TouchPhase.Stationary));
+                        Check(TouchControls.JoystickHeld && TouchControls.JoystickGestureId == moveGesture && TouchControls.Move.y > .2f
+                            && TouchControls.CameraHeld && Same(TouchControls.Look, expectedTurn) && TouchControls.Pinch == 0f,
+                            "Both folded sticks must keep walking and turning through " + action + " " + phase + ".");
+                        Check(TouchControls.Held(action) == (phase != TouchPhase.Ended) && TouchControls.Down(action) == (phase == TouchPhase.Began)
+                            && TouchControls.Up(action) == (phase == TouchPhase.Ended), action + " must follow only the third finger.");
+                    }
+                }
+                Frame(Finger(110, walk, TouchPhase.Ended), Finger(111, turn, TouchPhase.Ended));
+                Check(!TouchControls.JoystickHeld && !TouchControls.CameraHeld && TouchControls.Move == Vector2.zero && TouchControls.Look == Vector2.zero,
+                    "Lifting both folded sticks after combat inputs must stop walking and turning.");
+                results.Add("PASS: folded MOVE and LOOK stay held while a separate finger taps and releases Jump and Attack.");
+
+                attack = touch.LayoutRect(0).center;
+                finger(104, attack, TouchPhase.Began);
+                Check(TouchControls.Held(ControlMap.K.Fire1), "A fresh lower-pane touch must still activate attack.");
+                SeedDock(dock);
+                apply.Invoke(fold, new object[] { true, world, control });
+                Check(TouchControls.Held(ControlMap.K.Fire1), "An unchanged fold snapshot must preserve a live gesture.");
+                var movedControl = new Rect(control.x + 1, control.y, control.width - 1, control.height);
+                apply.Invoke(fold, new object[] { true, world, movedControl });
+                Check(!TouchControls.Held(ControlMap.K.Fire1), "Resizing a folded control pane must cancel old action fingers.");
+                CheckDockClear(dock, "resize");
+                SeedDock(dock);
+                apply.Invoke(fold, new object[] { false, new Rect(0, 0, width, height), Rect.zero });
+                Check(!FoldScreenController.Active && Same(camera.rect, original), "Leaving handheld mode must restore the exact prior camera viewport.");
+                CheckDockClear(dock, "exit");
+                Check(Same(TouchControls.LayoutArea, UiKit.SafeGuiBounds(width, height, Screen.safeArea)) && Same(UiKit.HudArea, UiKit.WorldHudArea),
+                    "Single-screen mode must recover its original HUD and control safe areas.");
+                for (int i = 0; i < 10; i++)
+                {
+                    apply.Invoke(fold, new object[] { true, world, control });
+                    apply.Invoke(fold, new object[] { false, new Rect(0, 0, width, height), Rect.zero });
+                    Check(Same(camera.rect, original), "Repeated folds must not compound or lose the previous camera viewport.");
+                }
+                results.Add("PASS: real camera viewport ownership/restoration; lower HUD/panel bounds; enter/resize/exit gesture cancellation; stale-finger rejection; upper selection tap and lower LOOK-tap ray mapping.");
+            }
+            finally
+            {
+                if (host != null) UnityEngine.Object.DestroyImmediate(host);
+                if (cameraHost != null) UnityEngine.Object.DestroyImmediate(cameraHost);
+                foreach (var gameObject in tags) if (gameObject != null) gameObject.tag = "MainCamera";
+                SetInstance(typeof(FoldScreenController), oldFold); SetInstance(typeof(TouchControls), oldTouch); SetInstance(typeof(MobileHudDock), oldDock);
+                PlayerHud.StatusScreen = status; NanocomHud.MinimapScreen = minimap; NanocomHud.MissionScreen = mission;
+            }
+        }
+        static void SetInstance(Type type, object value) => type.GetProperty("Instance").GetSetMethod(true).Invoke(null, new[] { value });
+        static void SeedDock(MobileHudDock dock)
+        {
+            var button = typeof(MobileHudDock).GetNestedType("Button", BindingFlags.NonPublic);
+            object bag = Enum.Parse(button, "Bag");
+            ((IDictionary)typeof(MobileHudDock).GetField("fingers", HiddenInstance).GetValue(dock))[91] = bag;
+            typeof(MobileHudDock).GetField("mousePressed", HiddenInstance).SetValue(dock, bag);
+        }
+        static void CheckDockClear(MobileHudDock dock, string transition)
+        {
+            Check(((IDictionary)typeof(MobileHudDock).GetField("fingers", HiddenInstance).GetValue(dock)).Count == 0, transition + " must clear native selector ownership.");
+            Check(System.Convert.ToInt32(typeof(MobileHudDock).GetField("mousePressed", HiddenInstance).GetValue(dock)) == 0, transition + " must clear simulated selector ownership.");
+        }
+    }
+}
