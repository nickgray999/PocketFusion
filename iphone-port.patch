diff --git a/Assets/Editor/IOSInputChecks.cs b/Assets/Editor/IOSInputChecks.cs
new file mode 100644
index 0000000..a0df316
--- /dev/null
+++ b/Assets/Editor/IOSInputChecks.cs
@@ -0,0 +1,505 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using OpenFusion.Screens;
+using OpenFusion.World;
+using UnityEditor;
+using UnityEngine;
+
+namespace OpenFusion.EditorTools
+{
+    // Exercise the production finger state machine, rather than a second input
+    // implementation. Geometry cases use explicit viewports; input cases use the
+    // editor surface and do not assert that a physical device has been tested.
+    public static class IOSInputChecks
+    {
+        const BindingFlags HiddenInstance = BindingFlags.Instance | BindingFlags.NonPublic;
+        const BindingFlags HiddenStatic = BindingFlags.Static | BindingFlags.NonPublic;
+        const string ResultPath = "Logs/ios-input-regression-results.txt";
+        const float Epsilon = .02f;
+        static int assertions;
+
+        static void Check(bool condition, string message)
+        { assertions++; if (!condition) throw new InvalidOperationException(message); }
+        static bool Zero(Vector2 value) => value.sqrMagnitude < .0001f;
+        static T Geometry<T>(string method, params object[] arguments)
+            => (T)typeof(TouchControls).GetMethod(method, HiddenStatic).Invoke(null, arguments);
+        static void Contained(Rect rect, Rect area, string name)
+        {
+            Check(rect.width > 0f && rect.height > 0f && rect.xMin >= area.xMin - Epsilon && rect.yMin >= area.yMin - Epsilon
+                && rect.xMax <= area.xMax + Epsilon && rect.yMax <= area.yMax + Epsilon, name + " escaped safe area: " + rect);
+        }
+        static bool Overlaps(Rect a, Rect b) => a.xMin < b.xMax - Epsilon && a.xMax > b.xMin + Epsilon
+            && a.yMin < b.yMax - Epsilon && a.yMax > b.yMin + Epsilon;
+
+        public static void Run()
+        {
+            assertions = 0;
+            var results = new List<string> { "UTC " + DateTime.UtcNow.ToString("O") };
+            string savedLayout = TouchLayout.Snapshot();
+            try
+            {
+                CheckActionGeometry(results);
+                CheckFingerOwnership(results);
+                CheckCameraStickControls(results);
+                CheckCameraFloor(results);
+                CheckLocalTerrainAndSpawn(results);
+                results.Add("PASS: " + assertions + " assertions against production geometry, ProcessTouches and camera-floor physics.");
+                results.Add("Editor regression only; physical camera feel and gameplay require a phone play test.");
+                Debug.Log("[iOS input regression] " + string.Join("\n", results));
+            }
+            catch (Exception error) { results.Add("FAIL: " + error); throw; }
+            finally
+            {
+                TouchLayout.Restore(savedLayout);
+                Directory.CreateDirectory("Logs"); File.WriteAllLines(ResultPath, results);
+            }
+        }
+
+        static void CheckActionGeometry(List<string> results)
+        {
+            // width, height, notch-side inset, home inset, top stress inset.
+            var viewports = new[] {
+                new Vector4(1136, 640, 0, 0), new Vector4(1334, 750, 0, 0),
+                new Vector4(2340, 1080, 150, 63), new Vector4(2556, 1179, 177, 63),
+                new Vector4(2796, 1290, 177, 63), new Vector4(2622, 1206, 186, 63),
+                new Vector4(2868, 1320, 186, 63), new Vector4(812, 375, 44, 21)
+            };
+            int layouts = 0;
+            foreach (var viewport in viewports)
+            for (int side = 0; side < 2; side++)
+            foreach (float scale in new[] { .65f, 1f, 1.3f })
+            {
+                TouchLayout.Reset(); TouchLayout.Scale = scale; TouchLayout.CameraStickEnabled = true;
+                float top = viewport.x == 812f ? 7f : 0f;
+                var area = UiKit.SafeGuiBounds(viewport.x, viewport.y, new Rect(side == 0 ? viewport.z : 0f,
+                    viewport.w, viewport.x - viewport.z, viewport.y - viewport.w - top));
+                float dp = Geometry<float>("DensityScale", viewport.x, viewport.y, 460f);
+                string label = viewport.x + "x" + viewport.y + " inset-side=" + side + " scale=" + scale;
+                var actions = new Rect[TouchLayout.Actions.Length];
+                for (int i = 0; i < actions.Length; i++)
+                {
+                    actions[i] = Geometry<Rect>("IPhoneActionBounds", i, area, dp, scale);
+                    Contained(actions[i], area, label + " action " + i);
+                    Check(actions[i].xMin >= area.center.x - Epsilon, label + " action " + i + " entered the movement half.");
+                    for (int j = 0; j < i; j++) Check(!Overlaps(actions[i], actions[j]), label + " actions " + i + "/" + j + " overlap.");
+                }
+                var cameraStick = Geometry<Rect>("IPhoneCameraStickBounds", area, dp);
+                Contained(cameraStick, area, label + " camera stick");
+                float stickDiameter = Mathf.Min(90f * dp * scale, area.height * .25f, area.width * .2f);
+                Check(Mathf.Abs(cameraStick.width - stickDiameter) < Epsilon && Mathf.Abs(cameraStick.height - stickDiameter) < Epsilon,
+                    label + " camera stick must keep its configured circular size within the safe-area caps.");
+                Check(cameraStick.xMin >= area.center.x - Epsilon, label + " camera stick must remain in the camera half.");
+                foreach (var action in actions)
+                {
+                    Check(!Overlaps(cameraStick, action), label + " camera stick overlaps an optional action cell.");
+                    Check(cameraStick.xMax <= action.xMin - 12f * dp + Epsilon,
+                        label + " camera stick must stay at least 12dp left of every action cell.");
+                }
+                foreach (float uiScale in new[] { 1f, viewport.y / NanoWheelHud.UiRefH })
+                {
