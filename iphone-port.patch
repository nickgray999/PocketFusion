diff --git a/Assets/Scripts/OpenFusion/World/MobileHudDock.cs b/Assets/Scripts/OpenFusion/World/MobileHudDock.cs
new file mode 100644
index 0000000..32bab22
--- /dev/null
+++ b/Assets/Scripts/OpenFusion/World/MobileHudDock.cs
@@ -0,0 +1,187 @@
+using System.Collections.Generic;
+using UnityEngine;
+using OpenFusion.Screens;
+
+namespace OpenFusion.World
+{
+    /// <summary>Compact iPhone HUD access, independent of the first touch's simulated mouse.</summary>
+    public sealed class MobileHudDock : MonoBehaviour
+    {
+        public static MobileHudDock Instance { get; private set; }
+        enum Button { None, Chat, Bag, Missions, Map, Menu }
+        readonly Dictionary<int, Button> fingers = new Dictionary<int, Button>();
+        readonly HashSet<int> seenFingers = new HashSet<int>();
+        readonly List<int> missingFingers = new List<int>();
+        Button mousePressed;
+        int lastTouchFrame = -10;
+
+        public static MobileHudDock Ensure(GameObject host)
+        {
+            var dock = host.GetComponent<MobileHudDock>();
+            return dock != null ? dock : host.AddComponent<MobileHudDock>();
+        }
+        void Awake() { Instance = this; }
+        void OnDisable() { fingers.Clear(); mousePressed = Button.None; }
+        public void CancelForSurfaceChange() { fingers.Clear(); seenFingers.Clear(); missingFingers.Clear(); mousePressed = Button.None; }
+        void OnDestroy() { if (Instance == this) Instance = null; }
+
+        public static bool DockVisible
+        {
+            get
+            {
+                if (Application.platform != RuntimePlatform.IPhonePlayer || Instance == null || !Instance.isActiveAndEnabled || ChatHud.Instance == null) return false;
+                var client = GameClient.FindSelf;
+                if (!TouchControls.CanShow(client != null && client.WorldConnected,
+                    client != null && client.Bootstrap != null && client.Bootstrap.Player != null,
+                    client != null && client.GetComponent<LauncherScreen>()?.Visible == true,
+                    LoadingScreen.I != null && LoadingScreen.I.Visible && !LoadingScreen.I.Mini,
+                    client != null && client.GetComponent<CharSelectScreen>()?.Visible == true)) return false;
+                if (NpcUI.Active || WelcomePopup.Active || TouchProfileEditor.Active || InventoryWindow.NanoAcquisitionActive
+                    || TutorialTraining.OverlayBlocking || SysMessageBox.Active || ModalWindow.Overlayed || SocialMenu.Active
+                    || InventoryWindow.Busy || InventoryWindow.Typing || JournalWindow.PopupActive) return false;
+                // Keep panel toggles reachable while their own windows block world input.
+                if (GameMenu.Current == GameMenu.Win.MyStuff || GameMenu.Current == GameMenu.Win.Journal || GameMenu.Current == GameMenu.Win.Map) return true;
+                return GameMenu.Current == GameMenu.Win.None
+                    && (GameMenu.Open || GameMenu.Slide > 0f || !GameMenu.HudHidden && !GameMenu.Blocking);
+            }
+        }
+        static Rect Area => TouchControls.LayoutArea;
+        static float Density => FoldScreenController.Active ? TouchControls.DensityScale(Area.width, Area.height, Screen.dpi) : TouchControls.DensityScale(Screen.width, Screen.height, Screen.dpi);
+        static float DockScale(Rect area, float density) => Mathf.Max(.01f, Mathf.Min(density, area.width / 180f, area.height / 500f));
+        /// <summary>Compact safe-left rail below status and above the default movement area.</summary>
+        public static void BoundsForArea(Rect area, float density, out Rect chat, out Rect bag, out Rect menu)
+        {
+            BoundsForArea(area, density, out chat, out bag, out _, out _, out menu);
+        }
+        public static void BoundsForArea(Rect area, float density, out Rect chat, out Rect bag, out Rect missions, out Rect map, out Rect menu)
+        {
+            float d = DockScale(area, density), width = 76f * d, height = 40f * d, gap = 5f * d;
+            float x = area.xMin + 6f * d, y = area.yMin + 88f * d;
+            chat = UiKit.ClampToArea(new Rect(x, y, width, height), area);
+            bag = UiKit.ClampToArea(new Rect(x, chat.yMax + gap, width, height), area);
+            missions = UiKit.ClampToArea(new Rect(x, bag.yMax + gap, width, height), area);
+            map = UiKit.ClampToArea(new Rect(x, missions.yMax + gap, width, height), area);
+            menu = UiKit.ClampToArea(new Rect(x, map.yMax + gap, width, height), area);
+        }
+        public static Rect ChatRect { get { BoundsForArea(Area, Density, out var chat, out _, out _); return chat; } }
+        public static Rect BagRect { get { BoundsForArea(Area, Density, out _, out var bag, out _); return bag; } }
+        public static Rect MenuRect { get { BoundsForArea(Area, Density, out _, out _, out var menu); return menu; } }
+        public static Rect MissionsRect { get { BoundsForArea(Area, Density, out _, out _, out var missions, out _, out _); return missions; } }
+        public static Rect MapRect { get { BoundsForArea(Area, Density, out _, out _, out _, out var map, out _); return map; } }
+        public static Rect ChatPanelArea
+        {
+            get { return ChatPanelAreaForArea(Area, Density); }
+        }
+        public static Rect ChatPanelAreaForArea(Rect area, float density)
+        {
+            float d = DockScale(area, density);
+            BoundsForArea(area, density, out var chat, out _, out _);
+            float left = chat.xMax + 8f * d, bottom = area.yMax - 180f * d;
+            return new Rect(left, chat.yMin, Mathf.Max(0f, area.xMax - left - 6f * d), Mathf.Max(0f, bottom - chat.yMin));
+        }
+        public static bool BlocksTouch(Vector2 guiPoint)
+        {
+            return DockVisible && (ChatRect.Contains(guiPoint) || BagRect.Contains(guiPoint) || MissionsRect.Contains(guiPoint) || MapRect.Contains(guiPoint) || MenuRect.Contains(guiPoint)
+                || ChatHud.Instance != null && ChatHud.Instance.BlocksPointer(guiPoint));
+        }
+        static Button Hit(Vector2 point) => ChatRect.Contains(point) ? Button.Chat : BagRect.Contains(point) ? Button.Bag
+            : MissionsRect.Contains(point) ? Button.Missions : MapRect.Contains(point) ? Button.Map : MenuRect.Contains(point) ? Button.Menu : Button.None;
+        static void CloseDockPanel()
+        {
+            if (GameMenu.Current == GameMenu.Win.MyStuff || GameMenu.Current == GameMenu.Win.Journal || GameMenu.Current == GameMenu.Win.Map) GameMenu.CloseWindow();
+        }
+        static void TogglePanel(GameMenu.Win target)
+        {
+            bool close = GameMenu.Current == target;
+            CloseDockPanel();
+            if (GameMenu.Open) GameMenu.SetOpen(false);
+            if (!close) GameMenu.OpenWindow(target);
+        }
+        static void Activate(Button button)
+        {
+            var chat = ChatHud.Instance;
+            if (button == Button.Chat)
+            {
+                if (!TutorialTraining.ChatAllowed || chat == null) return;
+                CloseDockPanel();
+                if (GameMenu.Open) GameMenu.SetOpen(false);
+                chat.SetHistoryExpanded(!chat.HistoryExpanded);
+            }
+            else if (button == Button.Bag || button == Button.Missions || button == Button.Map)
+            {
+                if (chat != null) chat.SetHistoryExpanded(false);
+                TogglePanel(button == Button.Bag ? GameMenu.Win.MyStuff : button == Button.Missions ? GameMenu.Win.Journal : GameMenu.Win.Map);
+            }
+            else if (button == Button.Menu)
+            {
+                if (chat != null) chat.SetHistoryExpanded(false);
+                CloseDockPanel();
+                GameMenu.SetOpen(!GameMenu.Open);
+            }
+        }
+        void Update()
+        {
+            int count = Input.touchCount;
+            if (count > 0) lastTouchFrame = Time.frameCount;
+            if (!DockVisible) { fingers.Clear(); mousePressed = Button.None; return; }
+            seenFingers.Clear(); missingFingers.Clear();
+            for (int i = 0; i < count; i++)
+            {
+                var touch = Input.GetTouch(i);
+                seenFingers.Add(touch.fingerId); var point = new Vector2(touch.position.x, Screen.height - touch.position.y);
+                if (touch.phase == TouchPhase.Began) { var hit = Hit(point); if (hit != Button.None) fingers[touch.fingerId] = hit; }
+                else if (touch.phase == TouchPhase.Ended || touch.phase == TouchPhase.Canceled)
+                {
+                    if (fingers.TryGetValue(touch.fingerId, out var pressed) && touch.phase == TouchPhase.Ended && Hit(point) == pressed) Activate(pressed);
+                    fingers.Remove(touch.fingerId);
+                }
+            }
+            foreach (var id in fingers.Keys) if (!seenFingers.Contains(id)) missingFingers.Add(id);
+            foreach (var id in missingFingers) fingers.Remove(id);
+        }
+        void OnGUI()
+        {
+            // GUI.depth belongs to this behaviour, so retain it at OnGUI exit.
+            GUI.depth = -2000;
+            if (!DockVisible) return;
+            var matrix = GUI.matrix; var color = GUI.color;
+            // Inventory, journal and map draw at -1500. Keep their close/switch
+            // toolbar above them for both drawing and IMGUI event ownership.
+            GUI.matrix = Matrix4x4.identity; GUI.color = Color.white;
+            try
+            {
+                var e = Event.current;
+                if (Time.frameCount > lastTouchFrame + 1)
+                {
+                    if (e.type == EventType.MouseDown && e.button == 0 && Hit(e.mousePosition) != Button.None) { mousePressed = Hit(e.mousePosition); e.Use(); }
+                    else if (e.type == EventType.MouseUp && e.button == 0 && mousePressed != Button.None)
+                    { var pressed = mousePressed; mousePressed = Button.None; if (Hit(e.mousePosition) == pressed) Activate(pressed); e.Use(); }
+                }
+                else if ((e.type == EventType.MouseDown || e.type == EventType.MouseUp || e.type == EventType.MouseDrag)
+                    && (Hit(e.mousePosition) != Button.None || fingers.Count > 0))
+                {
+                    // Native touches already activate the dock in Update. Consume their
+                    // simulated mouse event so a Bag/Map item underneath cannot also click.
+                    e.Use();
+                }
+                if (e.type != EventType.Repaint) return;
+                float scale = DockScale(Area, Density);
+                GUI.matrix = Matrix4x4.Scale(new Vector3(scale, scale, 1f));
+                Draw(ChatRect, "CHAT", ChatHud.Instance.HistoryExpanded, scale);
+                Draw(BagRect, "BAG", GameMenu.Current == GameMenu.Win.MyStuff, scale);
+                Draw(MissionsRect, "MISSIONS", GameMenu.Current == GameMenu.Win.Journal, scale);
+                Draw(MapRect, "MAP", GameMenu.Current == GameMenu.Win.Map, scale);
+                Draw(MenuRect, "MENU", GameMenu.Open, scale);
+            }
+            finally { GUI.matrix = matrix; GUI.color = color; }
+        }
+        static void Draw(Rect pixels, string label, bool selected, float scale)
+        {
+            var rect = new Rect(pixels.x / scale, pixels.y / scale, pixels.width / scale, pixels.height / scale);
+            UiKit.Fill(rect, selected ? new Color(.19f, .29f, .36f, .94f) : new Color(.10f, .16f, .21f, .88f));
+            UiKit.Outline(rect, selected ? new Color(.53f, .72f, .79f, .95f) : new Color(.42f, .53f, .60f, .65f), 1f);
+            var style = Skin.Get(Skin.Menu, "button");
+            UiKit.Label(style != null ? style.Font : null, rect, label, TextAnchor.MiddleCenter, new Color(.88f, .93f, .96f));
+        }
+    }
+}
