@@ -0,0 +1,34 @@
+namespace OpenFusion
+{
+    public sealed partial class GameClient
+    {
+#if UNITY_IOS && !UNITY_EDITOR
+        bool mobileSessionSuspended;
+
+        // iOS can suspend network processing while the app is in the background.
+        // A focus change, including the native keyboard, does not end a session.
+        void OnApplicationPause(bool paused)
+        {
+            if (paused)
+            {
+                if (mobileSessionSuspended || !WorldConnected || World.TutorialTraining.Active) return;
+
+                mobileSessionSuspended = true;
+                SendMovement = false;
+                shardAlive = false;
+                // Close each connection independently so one disposal failure cannot
+                // leave the other connection running during suspension.
+                try { Shard_?.Session?.Dispose(); } catch (System.Exception) { }
+                try { Login?.Dispose(); } catch (System.Exception) { }
+                return;
+            }
+
+            if (!mobileSessionSuspended) return;
+            mobileSessionSuspended = false;
+            // Reuse the normal logout path to discard stale world state and the
+            // in-memory login session. The player reconnects through the launcher.
+            ReturnToLauncher();
+        }
+#endif
+    }
+}
