+using System;
+using System.Collections.Generic;
+using System.Runtime.InteropServices;
+using UnityEngine;
+using UnityEngine.Rendering;
+using OpenFusion.Screens;
+
+namespace OpenFusion.World
+{
+    /// <summary>One world camera, with a separate control canvas below a verified horizontal fold.</summary>
+    [DefaultExecutionOrder(-400)]
+    public sealed class FoldScreenController : MonoBehaviour
+    {
+        [StructLayout(LayoutKind.Sequential)]
+        internal struct NativeState
+        {
+            public int version, supported, hingeAvailable, hingeStatus, revision, divisionCount, divisionActive;
+            public float angleRadians, viewWidth, viewHeight, divisionX, divisionY, divisionWidth, divisionHeight;
+            public float safeX, safeY, safeWidth, safeHeight;
+        }
+#if UNITY_IOS && !UNITY_EDITOR
+        [DllImport("__Internal")] static extern int OFPocketQueryFold(out NativeState state, int size);
+#endif
+        public static FoldScreenController Instance { get; private set; }
+        public static bool Active => Instance != null && Instance.active;
+        public static Rect ControlArea => Active ? Instance.controls : UiKit.SafeGuiBounds(Screen.width, Screen.height, Screen.safeArea);
+        public static Rect ViewArea => Active ? Instance.world : new Rect(0, 0, Screen.width, Screen.height);
+        public static Rect PanelArea
+        {
+            get
+            {
+                var r = ControlArea;
+                if (!Active) return new Rect(0, 0, Screen.width, Screen.height);
+                if (!Instance.worldReady) return r;
+                float rail = Mathf.Min(r.width * .18f, 94f * TouchControls.DensityScale(r.width, r.height, Screen.dpi));
+                return new Rect(r.x + rail, r.y, r.width - rail, r.height);
+            }
+        }
+        public static float PanelWidth => Active ? PanelArea.width : Screen.width;
+        public static float PanelHeight => Active ? PanelArea.height : Screen.height;
+        public static float UiHeight => Active ? ControlArea.height : Screen.height;
+        public static void Ensure(GameObject host)
+        {
+            if (host.GetComponent<FoldScreenController>() == null) host.AddComponent<FoldScreenController>();
+            if (host.GetComponent<FoldScreenBackdrop>() == null) host.AddComponent<FoldScreenBackdrop>();
+        }
+
+        bool active, worldReady, failed, rotationSaved, oldPortrait, oldUpsideDown, settings, resetGuiCapture;
+        Rect controls, world, savedCameraRect;
+        Camera cameraOwner;
+        NativeState state;
+        int loggedRevision = -1;
+        int nativeLoggedRevision = -1;
+        Rect lastGuiViewport;
+        int lastControlState = -1;
+        // 0: automatic posture, 1: full screen, 2: handheld on a verified inner display.
+        int preference;
+        const string PreferenceKey = "pocket.iphone.foldLayout";
+
+        void Awake()
+        {
+            Instance = this;
+            preference = Mathf.Clamp(PlayerPrefs.GetInt(PreferenceKey, 0), 0, 2);
+        }
+
+        void OnEnable() { RenderPipelineManager.endContextRendering += RestoreGuiViewport; }
+
+        // URP's final blit leaves the GPU viewport at the upper world camera's
+        // pixelRect. Native IMGUI follows the render pipeline, so restore its
+        // full-display viewport without rendering the world a second time.
+        void RestoreGuiViewport(ScriptableRenderContext context, List<Camera> cameras)
+        {
+            if (!active || cameraOwner == null || cameraOwner.targetTexture != null || !cameras.Contains(cameraOwner)) return;
+            var full = new Rect(0, 0, Screen.width, Screen.height);
+            var priorTarget = RenderTexture.active;
+            string priorSize = lastGuiViewport != full ? (priorTarget != null ? priorTarget.width + "x" + priorTarget.height : "display") : null;
+            var commands = CommandBufferPool.Get("PocketFusion full-display GUI viewport");
+            try
+            {
+                commands.DisableScissorRect();
+                commands.SetViewport(full);
+                context.ExecuteCommandBuffer(commands);
+                context.Submit();
+                // GUIClip reapplies its viewport from the legacy active target.
+                // Leave that target on the display too, rather than the cropped
+                // URP intermediate used to render the world.
+                RenderTexture.active = null;
+            }
+            finally { CommandBufferPool.Release(commands); }
+            if (lastGuiViewport != full)
+            {
+                lastGuiViewport = full;
+                Debug.Log("[fold-ui] restored full-display GUI viewport=" + full + " priorTarget=" + priorSize);
+            }
+        }
+
+        void Update()
+        {
+#if UNITY_IOS && !UNITY_EDITOR
+            if (!failed)
+                try { if (OFPocketQueryFold(out state, Marshal.SizeOf(typeof(NativeState))) == 0) state = default; }
+                catch (Exception e) { failed = true; state = default; Debug.LogWarning("[fold] Native posture unavailable: " + e.GetType().Name); }
+#endif
+            if (Application.platform != RuntimePlatform.IPhonePlayer) return;
+            if (nativeLoggedRevision != state.revision)
+            {
+                nativeLoggedRevision = state.revision;
+                Debug.Log("[fold-native] supported=" + state.supported + " hinge=" + state.hingeAvailable + " status=" + state.hingeStatus +
+                    " division=" + state.divisionCount + "/" + state.divisionActive + " frame=" + new Rect(state.divisionX, state.divisionY, state.divisionWidth, state.divisionHeight) +
+                    " nativeView=" + state.viewWidth + "x" + state.viewHeight + " Unity=" + Screen.width + "x" + Screen.height);
+            }
+            bool innerDisplay = state.hingeAvailable != 0 && (state.hingeStatus == 2 || state.hingeStatus == 3);
+            if (innerDisplay && !rotationSaved)
+            {
+                rotationSaved = true; oldPortrait = Screen.autorotateToPortrait; oldUpsideDown = Screen.autorotateToPortraitUpsideDown;
+                Screen.autorotateToPortrait = Screen.autorotateToPortraitUpsideDown = true;
+            }
+            else if (!innerDisplay && rotationSaved)
+            {
+                Screen.autorotateToPortrait = oldPortrait; Screen.autorotateToPortraitUpsideDown = oldUpsideDown;
+                rotationSaved = false;
+            }
+            var client = GameClient.FindSelf;
+            worldReady = client != null && TouchControls.CanShow(client.WorldConnected,
+                client.Bootstrap != null && client.Bootstrap.Player != null,
+                client.GetComponent<LauncherScreen>()?.Visible == true,
+                LoadingScreen.I != null && LoadingScreen.I.Visible && !LoadingScreen.I.Mini,
+                client.GetComponent<CharSelectScreen>()?.Visible == true);
+            Rect nextWorld = default, nextControls = default;
+            bool desired = preference != 1 && TryLayout(state, Screen.width, Screen.height,
+                UiKit.SafeGuiBounds(Screen.width, Screen.height, Screen.safeArea), preference == 2, out nextWorld, out nextControls);
+            if (!desired) { nextWorld = new Rect(0, 0, Screen.width, Screen.height); nextControls = default; }
+            ApplyLayout(desired, nextWorld, nextControls);
+            if (active)
+            {
+                int uiState = (worldReady ? 1 : 0) | (TouchControls.Active ? 2 : 0) | (MobileHudDock.DockVisible ? 4 : 0)
+                    | (ChatHud.Typing ? 8 : 0) | (NpcUI.Active ? 16 : 0) | (WelcomePopup.Active ? 32 : 0)
+                    | (GameMenu.Blocking ? 64 : 0) | (MenuChatPanel.Active ? 128 : 0) | (TouchProfileEditor.Active ? 256 : 0);
+                if (uiState != lastControlState)
+                {
+                    lastControlState = uiState;
+                    Debug.Log("[fold-controls] ready=" + worldReady + " touch=" + TouchControls.Active + " dock=" + MobileHudDock.DockVisible
+                        + " chat=" + ChatHud.Typing + " npc=" + NpcUI.Active + " welcome=" + WelcomePopup.Active
+                        + " menu=" + GameMenu.Blocking + " chatPanel=" + MenuChatPanel.Active + " editor=" + TouchProfileEditor.Active);
+                }
+            }
+        }
+
+        internal static bool TryLayout(NativeState s, float width, float height, Rect safe, bool manual, out Rect view, out Rect control)
+        {
+            view = control = default;
+            if (s.version != 1 || s.supported == 0 || s.hingeAvailable == 0 || s.divisionCount != 1 ||
+                (!manual && (s.hingeStatus != 2 || s.divisionActive == 0)) || (manual && s.hingeStatus != 2 && s.hingeStatus != 3)) return false;
+            if (!Finite(width) || !Finite(height) || width <= 0 || height <= 0 || !Finite(s.divisionX) || !Finite(s.divisionY) ||
+                !Finite(s.divisionWidth) || !Finite(s.divisionHeight) || s.divisionX < 0 || s.divisionY < 0 ||
+                s.divisionWidth < .75f || s.divisionHeight < 0 || s.divisionHeight > .15f ||
+                s.divisionX + s.divisionWidth > 1.001f || s.divisionY + s.divisionHeight > 1.001f) return false;
+            if (!Finite(s.viewWidth) || !Finite(s.viewHeight) || s.viewWidth <= 0 || s.viewHeight <= 0 || Mathf.Abs((s.viewWidth / s.viewHeight) / (width / height) - 1f) > .08f) return false;
+            if (!Finite(safe.x) || !Finite(safe.y) || !Finite(safe.width) || !Finite(safe.height) || safe.width <= 0 || safe.height <= 0) return false;
+            if (Finite(s.safeX) && Finite(s.safeY) && Finite(s.safeWidth) && Finite(s.safeHeight) && s.safeWidth > 0 && s.safeHeight > 0)
+                safe = Intersect(safe, new Rect(s.safeX * width, s.safeY * height, s.safeWidth * width, s.safeHeight * height));
+            float gap = Mathf.Max(8f, Mathf.Min(width, height) * .008f);
+            float topEnd = height * s.divisionY - gap;
+            float bottomStart = height * (s.divisionY + s.divisionHeight) + gap;
+            view = Intersect(safe, new Rect(0, 0, width, Mathf.Max(0, topEnd)));
+            control = Intersect(safe, new Rect(0, bottomStart, width, Mathf.Max(0, height - bottomStart)));
+            // Reject portrait book poses, tiny multitasking windows and keyboard-sized remnants.
+            float pointsPerPixel = s.viewWidth / width;
+            if (view.width * pointsPerPixel < 480 || view.height * pointsPerPixel < 220 || control.width * pointsPerPixel < 480 ||
+                control.height * pointsPerPixel < 250 || view.width < view.height * 1.1f)
+            { view = control = default; return false; }
+            return true;
+        }
+        static bool Finite(float n) => !float.IsNaN(n) && !float.IsInfinity(n);
+        internal static Rect Intersect(Rect a, Rect b)
+        {
+            float x = Mathf.Max(a.xMin, b.xMin), y = Mathf.Max(a.yMin, b.yMin);
+            return new Rect(x, y, Mathf.Max(0, Mathf.Min(a.xMax, b.xMax) - x), Mathf.Max(0, Mathf.Min(a.yMax, b.yMax) - y));
+        }
+        internal void ApplyLayout(bool enabled, Rect nextWorld, Rect nextControls)
+        {
+            if (active != enabled || world != nextWorld || controls != nextControls)
+            {
+                TouchControls.Instance?.CancelForSurfaceChange();
+                MobileHudDock.Instance?.CancelForSurfaceChange();
+                resetGuiCapture = true;
+                active = enabled; world = nextWorld; controls = nextControls;
