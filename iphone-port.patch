+using UnityEngine;
+
+namespace OpenFusion.World
+{
+    /// <summary>Keep the handheld panel background behind every interactive GUI behaviour.</summary>
+    public sealed class FoldScreenBackdrop : MonoBehaviour
+    {
+        void OnGUI()
+        {
+            // GUI.depth belongs to this behaviour and must remain a background
+            // layer on Layout, input and Repaint, including when inactive.
+            GUI.depth = 10000;
+            var fold = FoldScreenController.Instance;
+            if (fold != null && fold.isActiveAndEnabled) fold.DrawBackdrop();
+        }
+    }
+}
